#!/usr/bin/env python3
"""Benchmark the quill-store CLI on disposable libraries.

The live data root is never touched: every run gets a fresh temporary
directory via QUILL_DATA_DIR, with QUILL_E2E=1 as a second guard.

Usage:
    scripts/bench [--notes N] [--keep] [--runs N] [--daemon]

Each library is populated with Markdown files of roughly 4 KiB, then the
index rebuild, list, search, tags, one write and one read are timed. The
reported number is the median of --runs runs (default 3).

--daemon times the same commands through one persistent `quill-store __serve`
socket connection per library, so process-start cost is excluded. The default
is the direct CLI, one process per command.
"""

from __future__ import annotations

import argparse
import contextlib
import json
import os
import shutil
import socket
import statistics
import subprocess
import sys
import tempfile
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
STORE = ROOT / "scripts" / "quill-store"
REAL_ROOT = (Path.home() / ".local" / "share" / "quill").resolve()
DEFAULT_LARGE = 2000
SMALL_COUNT = 16
NOTE_TARGET = 4096


def note_text(index: int) -> str:
    head = f"# Benchmark note {index}\n\nunique{index} token\n\n"
    sentence = "The quick brown fox jumps over the lazy dog near the river. "
    paragraph = sentence * 5 + "\n\n"
    body = paragraph * 13
    text = head + body
    if len(text) < NOTE_TARGET:
        text += ("the " * ((NOTE_TARGET - len(text)) // 4 + 1))
    return text


def populate(root: Path, count: int) -> int:
    notes = root / "notes"
    notes.mkdir(parents=True, exist_ok=True)
    total = 0
    for index in range(count):
        data = note_text(index).encode("utf-8")
        (notes / f"bench-{index:05d}.md").write_bytes(data)
        total += len(data)
    return total


def environment(root: Path) -> dict[str, str]:
    if root.resolve() == REAL_ROOT:
        raise SystemExit("refusing to benchmark the live Quill data root")
    env = dict(os.environ)
    env.pop("QUILL_E2E_ALLOW_REAL", None)
    env.pop("QUILL_VERSION_RETENTION", None)
    env.pop("QUILL_VERSION_THROTTLE", None)
    env["QUILL_DATA_DIR"] = str(root)
    env["QUILL_E2E"] = "1"
    return env


def run_json(env: dict[str, str], *args: str, stdin: bytes | None = None) -> dict:
    process = subprocess.run(
        [sys.executable, str(STORE), *args],
        input=stdin if stdin is not None else b"",
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        env=env,
        cwd=str(ROOT),
    )
    if process.returncode != 0:
        raise RuntimeError(
            f"{' '.join(args)} failed: {process.stderr.decode('utf-8', 'replace').strip()}"
        )
    output = process.stdout.decode("utf-8")
    value, end = json.JSONDecoder().raw_decode(output)
    if output[end:].strip():
        raise RuntimeError(f"{' '.join(args)} wrote more than one JSON value")
    return value


def timed(env: dict[str, str], args: tuple[str, ...], runs: int,
          stdin: bytes | None = None) -> tuple[float, dict]:
    samples: list[float] = []
    last: dict = {}
    for _ in range(runs):
        started = time.perf_counter()
        last = run_json(env, *args, stdin=stdin)
        samples.append((time.perf_counter() - started) * 1000.0)
    return statistics.median(samples), last


def start_daemon(root: Path) -> tuple[subprocess.Popen, "socket.socket", object, Path]:
    """Start one `__serve` for this library; the socket lives in its temp root."""
    socket_path = root / "bench.sock"
    process = subprocess.Popen(
        [sys.executable, str(STORE), "__serve", "--socket", str(socket_path), "--idle", "0"],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.PIPE,
        env=environment(root),
        cwd=str(ROOT),
    )
    deadline = time.monotonic() + 10.0
    last_error = None
    while time.monotonic() < deadline:
        client = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        try:
            client.settimeout(1.0)
            client.connect(str(socket_path))
        except OSError as error:
            last_error = error
            client.close()
            if process.poll() is not None:
                break
            time.sleep(0.05)
            continue
        client.settimeout(None)
        return process, client, DaemonLink(client), socket_path
    process.kill()
    process.wait()
    raise RuntimeError(f"daemon did not start on {socket_path}: {last_error}")


class DaemonLink:
    """Line-framed reader for one persistent daemon connection.

    `socket.makefile(..., buffering=0)` decodes `readline()` one byte at a
    time, which makes a ~1 MiB `list` reply insanely slow. Keeping the recv
    buffer here reads in 64 KiB chunks and keeps any bytes that arrived after
    the newline for the next reply.
    """

    def __init__(self, client: "socket.socket") -> None:
        self.client = client
        self.buffer = b""

    def send(self, payload: dict) -> None:
        self.client.sendall(
            (json.dumps(payload, ensure_ascii=False) + "\n").encode("utf-8")
        )

    def reply(self) -> dict:
        while True:
            while b"\n" not in self.buffer:
                chunk = self.client.recv(1 << 16)
                if not chunk:
                    raise RuntimeError("daemon closed the connection")
                self.buffer += chunk
            line, _sep, self.buffer = self.buffer.partition(b"\n")
            if not line.strip():
                continue
            value = json.loads(line.decode("utf-8"))
            if isinstance(value, dict) and "ok" in value:
                return value

    def close(self) -> None:
        with contextlib.suppress(OSError):
            self.client.close()


def daemon_reply(stream, payload: dict) -> dict:
    stream.send(payload)
    return stream.reply()


def timed_daemon(stream, args: tuple[str, ...], runs: int,
                 stdin: bytes | None = None) -> tuple[float, dict]:
    samples: list[float] = []
    last: dict = {}
    payload: dict = {"args": list(args)}
    if stdin is not None:
        payload["stdin"] = stdin.decode("utf-8")
    for _ in range(runs):
        started = time.perf_counter()
        reply = daemon_reply(stream, payload)
        samples.append((time.perf_counter() - started) * 1000.0)
        if not reply.get("ok"):
            raise RuntimeError(
                f"{' '.join(args)} failed over the daemon: {reply.get('error')}"
            )
        last = reply["result"]
    return statistics.median(samples), last


def stop_daemon(process, client, stream, socket_path: Path) -> None:
    with contextlib.suppress(Exception):
        daemon_reply(stream, {"op": "shutdown"})
    with contextlib.suppress(Exception):
        stream.close()
    with contextlib.suppress(OSError):
        client.close()
    try:
        process.wait(timeout=10)
    except subprocess.TimeoutExpired:
        process.kill()
        process.wait()
    if process.stderr is not None:
        process.stderr.close()
    with contextlib.suppress(OSError):
        socket_path.unlink()


def validate(count: int, payload: bytes, listing_result: dict, rebuild_result: dict,
             search_result: dict, tags_result: dict, write_result: dict,
             read_result: dict) -> None:
    if listing_result.get("totalCount") != count:
        raise RuntimeError(
            f"list reported {listing_result.get('totalCount')} notes, expected {count}"
        )
    if rebuild_result.get("notes") != count:
        raise RuntimeError(
            f"index reported {rebuild_result.get('notes')} notes, expected {count}"
        )
    if read_result.get("size") != len(payload):
        raise RuntimeError("read returned an unexpected size")
    if search_result.get("results") is None or tags_result.get("tags") is None:
        raise RuntimeError("search/tags output was malformed")
    if write_result.get("size") != len(payload):
        raise RuntimeError("write returned an unexpected size")


def benchmark(root: Path, count: int, runs: int, use_daemon: bool = False) -> dict:
    total_bytes = populate(root, count)
    notes_dir = root / "notes"
    first_id = sorted(path.name for path in notes_dir.glob("*.md"))[1 if count > 1 else 0]
    payload = note_text(0).encode("utf-8")

    if use_daemon:
        process, client, stream, socket_path = start_daemon(root)
        try:
            # The daemon syncs the index while it starts, and a client can
            # connect before that finishes. Ping is answered only once the
            # accept loop is running, so this warm-up keeps the startup sync
            # out of the first measured command.
            warmup = daemon_reply(stream, {"op": "ping"})
            if not warmup.get("ok"):
                raise RuntimeError(f"daemon ping failed: {warmup.get('error')}")

            def measure(args, stdin=None):
                return timed_daemon(stream, args, runs, stdin=stdin)

            rebuild, rebuild_result = measure(("index", "--rebuild"))
            listing, listing_result = measure(("list",))
            search, search_result = measure(("search", "the", "--limit", "20"))
            tags, tags_result = measure(("tags",))
            write, write_result = measure(("write", first_id, "--stdin"), stdin=payload)
            read, read_result = measure(("read", first_id))
        finally:
            stop_daemon(process, client, stream, socket_path)
    else:
        env = environment(root)

        def measure(args, stdin=None):
            return timed(env, args, runs, stdin=stdin)

        rebuild, rebuild_result = measure(("index", "--rebuild"))
        listing, listing_result = measure(("list",))
        search, search_result = measure(("search", "the", "--limit", "20"))
        tags, tags_result = measure(("tags",))
        write, write_result = measure(("write", first_id, "--stdin"), stdin=payload)
        read, read_result = measure(("read", first_id))

    index_bytes = (root / "index.db").stat().st_size if (root / "index.db").exists() else 0
    validate(count, payload, listing_result, rebuild_result, search_result,
             tags_result, write_result, read_result)

    return {
        "count": count,
        "bytes": total_bytes,
        "rebuild": rebuild,
        "list": listing,
        "search": search,
        "tags": tags,
        "write": write,
        "read": read,
        "indexBytes": index_bytes,
    }


def format_row(label: str, result: dict) -> str:
    return (
        f"{label:<12} {result['count']:>6} {result['bytes'] / (1024 * 1024):>8.1f} "
        f"{result['rebuild']:>8.0f} {result['list']:>6.0f} {result['search']:>7.0f} "
        f"{result['tags']:>6.0f} {result['write']:>7.0f} {result['read']:>6.0f} "
        f"{result['indexBytes'] / 1_000_000:>8.1f}"
    )


def main() -> int:
    parser = argparse.ArgumentParser(description="Benchmark quill-store on disposable data roots")
    parser.add_argument("--notes", type=int, default=DEFAULT_LARGE,
                        help=f"note count for the large library (default {DEFAULT_LARGE})")
    parser.add_argument("--keep", action="store_true",
                        help="keep the temporary libraries and print their paths")
    parser.add_argument("--runs", type=int, default=3,
                        help="timed runs per metric; the median is reported (default 3)")
    parser.add_argument("--daemon", action="store_true",
                        help="time one persistent __serve socket instead of one process per command")
    args = parser.parse_args()
    if args.notes < 1:
        parser.error("--notes must be at least 1")
    if args.runs < 1:
        parser.error("--runs must be at least 1")

    libraries: list[tuple[str, Path, int]] = []
    try:
        small_root = Path(tempfile.mkdtemp(prefix="quill-bench-small-"))
        large_root = Path(tempfile.mkdtemp(prefix="quill-bench-large-"))
        libraries = [("small", small_root, SMALL_COUNT), ("large", large_root, args.notes)]

        results = []
        for label, root, count in libraries:
            results.append((label, benchmark(root, count, args.runs, args.daemon)))

        print("Quill store benchmark (median of "
              f"{args.runs} runs, milliseconds unless noted)"
              + (" (daemon)" if args.daemon else ""))
        print(
            f"{'library':<12} {'notes':>6} {'MiB':>8} {'rebuild':>8} {'list':>6} "
            f"{'search':>7} {'tags':>6} {'write':>7} {'read':>6} {'idx MB':>8}"
        )
        print("-" * 86)
        for label, result in results:
            print(format_row(label, result))
        print()
        print("Reference baseline (sanity only; this machine may differ):")
        print("  2k notes: rebuild ~3.1 s, list ~200 ms, search ~174 ms, tags ~167 ms, "
              "write ~112 ms, read ~94 ms, index ~18.2 MB")
        if args.keep:
            print()
            for label, root, _count in libraries:
                print(f"kept {label}: {root}")
        return 0
    finally:
        if not args.keep:
            for _label, root, _count in libraries:
                shutil.rmtree(root, ignore_errors=True)


if __name__ == "__main__":
    raise SystemExit(main())
