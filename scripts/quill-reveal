#!/usr/bin/env python3
"""Reveal one note file in the desktop file manager.

The note list's **Open file location** action calls this instead of guessing a
file-manager binary. Three strategies are tried in order: the freedesktop
``org.freedesktop.FileManager1`` D-Bus interface (selects the file inside a
running file manager), a ``--select``-style spawn (nautilus/dolphin/thunar),
then opening the containing folder with ``xdg-open``.

On success exactly one JSON object is printed on stdout:

    {"ok": true, "mode": "dbus", "folder": "...", "path": "...",
     "command": ["gdbus", "call", "..."]}

``missing`` is added when the note file itself is gone and its folder is what
gets shown. Failures print one ``quill-reveal: <message>`` line on stderr and
exit 1; usage errors exit 2. Nothing is ever written to the data directory.

Usage: quill-reveal <path> [--mode auto|dbus|select|open]
                    [--file-manager BINARY] [--dry-run]
"""

from __future__ import annotations

import argparse
import json
import os
import shutil
import subprocess
import sys
from pathlib import Path

DEST = "org.freedesktop.FileManager1"
OBJECT_PATH = "/org/freedesktop/FileManager1"
OWNER_CHECK_METHOD = "org.freedesktop.DBus.NameHasOwner"
CANDIDATES = ("nautilus", "dolphin", "thunar")
MODES = ("auto", "dbus", "select", "open")
TIMEOUT = 5


class RevealError(Exception):
    """A strategy could not be run; `auto` falls through to the next one."""


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="quill-reveal",
        description="Show a note's file in the desktop file manager.",
    )
    parser.add_argument("path", help="file to reveal (a directory is opened)")
    parser.add_argument(
        "--mode",
        choices=MODES,
        default="auto",
        help="auto tries dbus, select then open (default: auto)",
    )
    parser.add_argument(
        "--file-manager",
        default=None,
        metavar="BINARY",
        help="file manager to use for select/open (must be executable)",
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="resolve the strategy and print the command without running it",
    )
    return parser


def absolute(raw: str) -> Path:
    """Expand ``~`` and make absolute without resolving symlinks."""
    return Path(os.path.abspath(os.path.expanduser(raw)))


def resolve_target(raw: str) -> tuple[Path, Path, bool]:
    """Return (path, folder, missing).

    An existing file is the target. A missing file whose parent directory
    exists is reported as missing and its folder becomes the target; if the
    parent is gone too there is nothing sensible to show.
    """
    path = absolute(raw)
    if path.exists():
        folder = path if path.is_dir() else path.parent
        return path, folder, False
    if path.parent.is_dir():
        return path, path.parent, True
    raise RevealError(f"no such file or directory: {path}")


def which_file_manager(preferred: str | None) -> str | None:
    """Validate ``--file-manager`` before any strategy runs.

    A bad binary is a caller error in every mode, not something to silently
    fall back from.
    """
    if not preferred:
        return None
    found = shutil.which(preferred)
    if not found:
        raise RevealError(f"file manager is not executable: {preferred}")
    return found


def owner_check_command() -> list[str]:
    return [
        "gdbus",
        "call",
        "--session",
        "--dest",
        "org.freedesktop.DBus",
        "--object-path",
        "/org/freedesktop/DBus",
        "--method",
        OWNER_CHECK_METHOD,
        DEST,
    ]


def dbus_command(path: Path, folder: Path, missing: bool) -> list[str]:
    """ShowItems for a live file, ShowFolders for a directory or a gap."""
    if missing or path.is_dir():
        method, uri = "ShowFolders", folder.as_uri()
    else:
        method, uri = "ShowItems", path.as_uri()
    return [
        "gdbus",
        "call",
        "--session",
        "--dest",
        DEST,
        "--object-path",
        OBJECT_PATH,
        "--method",
        f"{DEST}.{method}",
        "['" + uri + "']",
        "",
    ]


def file_manager1_has_owner() -> bool:
    """Probe the session bus without ever launching a file manager."""
    try:
        process = subprocess.run(
            owner_check_command(),
            timeout=TIMEOUT,
            capture_output=True,
            text=True,
        )
    except (OSError, subprocess.TimeoutExpired):
        return False
    return process.returncode == 0 and "(true,)" in process.stdout.replace(" ", "")


def run_dbus(command: list[str]) -> None:
    """Deliver the ShowItems/ShowFolders call.

    Exit 0 means the file manager accepted it. A timeout is also success: the
    message may have been delivered already, and retrying would open a second
    window. Only a real non-zero exit falls through to another strategy.
    """
    try:
        process = subprocess.run(
            command, timeout=TIMEOUT, capture_output=True, text=True
        )
    except subprocess.TimeoutExpired:
        return
    except OSError as error:
        raise RevealError(f"could not run gdbus: {error}") from error
    if process.returncode != 0:
        detail = (process.stderr or process.stdout).strip().splitlines()
        reason = detail[0] if detail else f"gdbus exited {process.returncode}"
        raise RevealError(f"FileManager1 call failed: {reason}")


def spawn(command: list[str]) -> None:
    """Start a detached GUI process without waiting for it."""
    try:
        subprocess.Popen(
            command,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    except OSError as error:
        raise RevealError(f"could not launch {command[0]}: {error}") from error


def select_command(
    path: Path, folder: Path, missing: bool, file_manager: str | None
) -> list[str]:
    if missing or path.is_dir():
        raise RevealError("select needs an existing file")
    if file_manager:
        binary = file_manager
    else:
        binary = ""
        for name in CANDIDATES:
            binary = shutil.which(name) or ""
            if binary:
                break
        if not binary:
            raise RevealError(
                "no file manager found (tried " + ", ".join(CANDIDATES) + ")"
            )
    return [binary, "--select", str(path)]


def open_command(folder: Path, file_manager: str | None) -> list[str]:
    if file_manager:
        return [file_manager, str(folder)]
    xdg_open = shutil.which("xdg-open")
    if xdg_open:
        return [xdg_open, str(folder)]
    gio = shutil.which("gio")
    if gio:
        return [gio, "open", str(folder)]
    raise RevealError("neither xdg-open nor gio is installed")


def strategy_dbus(
    path: Path, folder: Path, missing: bool, dry_run: bool
) -> tuple[str, list[str]]:
    if not shutil.which("gdbus"):
        raise RevealError("gdbus is not installed")
    # A dry run must not start any process, so it cannot ask the bus who owns
    # the name; it predicts the first strategy whose tool is present.
    if not dry_run and not file_manager1_has_owner():
        raise RevealError(f"{DEST} has no owner")
    command = dbus_command(path, folder, missing)
    if not dry_run:
        run_dbus(command)
    return "dbus", command


def strategy_select(
    path: Path,
    folder: Path,
    missing: bool,
    file_manager: str | None,
    dry_run: bool,
) -> tuple[str, list[str]]:
    command = select_command(path, folder, missing, file_manager)
    if not dry_run:
        spawn(command)
    return "select", command


def strategy_open(
    path: Path, folder: Path, missing: bool, file_manager: str | None, dry_run: bool
) -> tuple[str, list[str]]:
    del path, missing
    command = open_command(folder, file_manager)
    if not dry_run:
        spawn(command)
    return "open", command


def reveal(
    path: Path,
    folder: Path,
    missing: bool,
    mode: str,
    file_manager: str | None,
    dry_run: bool,
) -> tuple[str, list[str]]:
    if mode == "dbus":
        return strategy_dbus(path, folder, missing, dry_run)
    if mode == "select":
        return strategy_select(path, folder, missing, file_manager, dry_run)
    if mode == "open":
        return strategy_open(path, folder, missing, file_manager, dry_run)

    attempts = ["dbus"]
    if not missing and not path.is_dir():
        attempts.append("select")
    attempts.append("open")
    last_error: RevealError | None = None
    for name in attempts:
        try:
            if name == "dbus":
                return strategy_dbus(path, folder, missing, dry_run)
            if name == "select":
                return strategy_select(path, folder, missing, file_manager, dry_run)
            return strategy_open(path, folder, missing, file_manager, dry_run)
        except RevealError as error:
            # Never report failure while an earlier strategy may have worked;
            # the last real error is the one worth showing.
            last_error = RevealError(f"{name}: {error}")
    if last_error is not None:
        raise last_error
    raise RevealError("no way to open the file manager")


def success(
    mode: str,
    folder: Path,
    path: Path,
    command: list[str],
    missing: bool,
) -> dict:
    payload = {
        "ok": True,
        "mode": mode,
        "folder": str(folder),
        "path": str(path),
        "command": command,
    }
    if missing:
        payload["missing"] = True
    return payload


def main() -> int:
    args = build_parser().parse_args()
    try:
        file_manager = which_file_manager(args.file_manager)
        path, folder, missing = resolve_target(args.path)
        mode, command = reveal(
            path, folder, missing, args.mode, file_manager, args.dry_run
        )
    except RevealError as error:
        message = str(error).splitlines()[0] if str(error) else "reveal failed"
        sys.stderr.write(f"quill-reveal: {message}\n")
        return 1
    sys.stdout.write(
        json.dumps(success(mode, folder, path, command, missing), ensure_ascii=False)
        + "\n"
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())
