#!/usr/bin/env bash
# Run the JavaScript, store, QML loading and QML behaviour suites. Always runs
# all four; exits non-zero when any fails.
set -u

cd "$(dirname "$0")/.."

status=0

echo "== JavaScript unit tests =="
if ! node --test tests/js; then
  status=1
fi

echo
echo "== quill-store contract tests =="
if ! python3 -m unittest discover -s tests/store -v; then
  status=1
fi

echo
echo "== QML load smoke test =="
if ! ./scripts/qmlcheck; then
  status=1
fi

echo
echo "== QML behaviour tests =="
if ! ./scripts/qmltest; then
  status=1
fi

exit "$status"
