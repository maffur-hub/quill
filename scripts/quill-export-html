img { max-width: 100%; height: auto; }
.math svg { display: inline-block; vertical-align: middle; max-width: 100%; }
.math-display { margin: 1.3em 0; text-align: center; overflow-x: auto; }
.math-error { color: #cf222e; font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 0.9em; }
.missing-image {
  display: inline-block;
  padding: 0.15em 0.5em;
  border: 1px dashed #cf222e;
  border-radius: 4px;
  color: #cf222e;
  font-size: 0.9em;
}
mark { background: #fff3a3; color: inherit; padding: 0 0.1em; }
del { color: #57606a; }
`
}

function renderDocument(markdown, title, options, context) {
  const lines = String(markdown).replace(/\r\n?/g, "\n").replace(/^\uFEFF/, "").split("\n")
  const body = renderBlocks(lines, context)
  return "<!doctype html>\n"
    + '<html lang="en">\n'
    + "<head>\n"
    + '<meta charset="utf-8">\n'
    + '<meta name="viewport" content="width=device-width, initial-scale=1">\n'
    + "<title>" + escapeHtml(title) + "</title>\n"
    + "<style>\n" + stylesheet() + "</style>\n"
    + "</head>\n"
    + '<body>\n<main class="note">\n' + body + "\n</main>\n</body>\n</html>\n"
}

function writeAtomic(file, contents) {
  const directory = path.dirname(file)
  const temporary = path.join(directory, "." + path.basename(file)
    + ".tmp-" + process.pid + "-" + crypto.randomBytes(4).toString("hex"))
  try {
    fs.writeFileSync(temporary, contents, "utf8")
    fs.renameSync(temporary, file)
  } catch (error) {
    try { fs.unlinkSync(temporary) } catch (cleanupError) { /* already gone */ }
    throw error
  }
}

function main() {
  let options
  try {
    options = parseArguments(process.argv.slice(2))
  } catch (error) {
    process.stderr.write("quill-export-html: " + error.message + "\n")
    process.exitCode = 2
    return
  }

  const input = String(options.input || "")
  const output = String(options.output || "")
  const title = String(options.title === undefined ? "" : options.title)
  const noteDir = String(options["note-dir"] || "")
  const color = normaliseColor(options.color)
  const fontPx = normaliseFontPx(options["font-px"])

  try {
    if (input === "") fail("--input is required")
    if (output === "") fail("--output is required")
    let inputStat
    try {
      inputStat = fs.statSync(input)
      fs.accessSync(input, fs.constants.R_OK)
    } catch (error) {
      fail("cannot read input: " + input)
    }
    if (!inputStat.isFile()) fail("input is not a file: " + input)

    const outputDirectory = path.dirname(path.resolve(output))
    let directoryStat
    try {
      directoryStat = fs.statSync(outputDirectory)
    } catch (error) {
      fail("output directory does not exist: " + outputDirectory)
    }
    if (!directoryStat.isDirectory()) fail("output directory is not a directory: " + outputDirectory)
    try {
      const outputStat = fs.statSync(output)
      if (outputStat.isDirectory()) fail("output path is a directory: " + output)
    } catch (error) {
      if (error.isUsageError) throw error
      // A missing output file is the normal case.
    }

    const resolvedNoteDir = noteDir === "" ? path.dirname(path.resolve(input)) : path.resolve(noteDir)
    const markdown = fs.readFileSync(input, "utf8")
    const context = {
      color: color,
      fontPx: fontPx,
      noteDir: resolvedNoteDir,
      math: 0,
      images: 0,
      warnings: 0
    }
    const html = renderDocument(markdown, title, options, context)
    writeAtomic(path.resolve(output), html)

    const result = {
      ok: true,
      bytes: Buffer.byteLength(html, "utf8"),
      math: context.math,
      images: context.images,
      warnings: context.warnings
    }
    process.stdout.write(JSON.stringify(result) + "\n")
  } catch (error) {
    const message = error && error.message ? error.message : String(error)
    process.stderr.write("quill-export-html: " + message + "\n")
    process.exitCode = 1
  }
}

main()
