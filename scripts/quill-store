#!/usr/bin/env python3
"""Quill note store.

Plain Markdown on disk is the source of truth. A SQLite index (FTS5) is a
derived cache and may be deleted at any time. Every command prints exactly
one JSON object on stdout; failures print one JSON object on stderr and exit
non-zero.

Usage: quill-store <command> [args]
"""

from __future__ import annotations

import argparse
import contextlib
import ctypes
import datetime
import fcntl
import hashlib
import json
import mimetypes
import os
import queue
import re
import select
import shutil
import socket
import sqlite3
import stat
import struct
import sys
import tempfile
import threading
import time
import unicodedata
import urllib.parse
import uuid
from pathlib import Path

# 3: notes.body dropped (the FTS table keeps its own body copy); 2: links.target_norm
SCHEMA_VERSION = 3
SERVE_STDIN: bytes | None = None
INDEX_TRUSTED = False
EXEC_LOCK = threading.RLock()
MAX_REQUEST_BYTES = 32 * 1024 * 1024
MAX_NOTE_BYTES = 1024 * 1024
MAX_ATTACHMENT_BYTES = 20 * 1024 * 1024
MAX_REFERENCE_BYTES = 8 * 1024 * 1024
MAX_INDEX_BYTES = 512 * 1024
MAX_LIST_NOTES = 2000
MAX_LIST_FOLDERS = 2000
MAX_STATE_BYTES = 1024 * 1024
MAX_SEARCH_LIMIT = 500
MAX_TITLES_LIMIT = 20000
MAX_SAVED_SEARCHES = 50
MAX_UI_SETTINGS_BYTES = 64 * 1024
MAX_UI_SETTINGS_KEY_CHARS = 64
FUZZY_TRIGGER = 5      # run the fallback when exact hits are fewer than this
FUZZY_MIN_TOKEN = 3    # shorter tokens stay plain prefix matches
FUZZY_TERMS = 4        # expansions kept per token
VERSION_RETENTION_DEFAULT = 50
VERSION_RETENTION_MAX = 1000
VERSION_THROTTLE_DEFAULT = 60.0

VERSION_FILENAME_RE = re.compile(r"^(\d{8}T\d{6}Z)-([0-9a-f]{16})(?:-(\d+))?\.md$")

# Latin-1/Extended-A accents folded to ASCII, mirroring TagSuggest.js ACCENTS
# so `#naïve` and `#naive` are one tag in storage and in the index. Other
# scripts are left for the sanitiser below (they normalise to `-` and drop).
ACCENT_FOLD = {
    "à": "a", "á": "a", "â": "a", "ã": "a", "ä": "a", "å": "a", "æ": "ae",
    "ç": "c", "è": "e", "é": "e", "ê": "e", "ë": "e", "ì": "i", "í": "i",
    "î": "i", "ï": "i", "ð": "d", "ñ": "n", "ò": "o", "ó": "o", "ô": "o",
    "õ": "o", "ö": "o", "ø": "o", "œ": "oe", "š": "s", "ù": "u", "ú": "u",
    "û": "u", "ü": "u", "ý": "y", "ÿ": "y", "ž": "z", "þ": "th",
    "ß": "ss", "ẞ": "ss",
}
ACCENT_TABLE: dict[int, str] = {}
for _accent, _ascii in ACCENT_FOLD.items():
    ACCENT_TABLE[ord(_accent)] = _ascii
    _upper = _accent.upper()
    if len(_upper) == 1:
        ACCENT_TABLE[ord(_upper)] = _ascii.upper()

# A tag is `#` followed by Unicode word characters (accents included), plus
# the separators Quill has always allowed. The lookbehind keeps `#` inside a
# word (`a#b`), a fence/heading (`##x`) or an escape (`\#x`) out, and the
# character class consumes a whole accented word so `#na` can never match the
# prefix of `#naïve`.
TAG_CHARS = r"\w\u0300-\u036f/-"
TAG_RE = re.compile(r"(?<![#\w\\\u0300-\u036f])#([" + TAG_CHARS + r"]+)")
WIKI_RE = re.compile(r"\[\[([^\[\]\n]+?)\]\]")
INLINE_CODE_RE = re.compile(r"`[^`\n]*`")
FENCE_RE = re.compile(r"^\s{0,3}(```|~~~)")
URL_RE = re.compile(r"(?:https?://|mailto:)[^\s<>()]+")
MD_DEST_RE = re.compile(r"\]\(\s*([^\s()]+)")
HEADING_RE = re.compile(r"^\s{0,3}#{1,6}\s+")
LIST_RE = re.compile(r"^\s{0,3}(?:[-*+]|\d+[.)])\s+(?:\[[ xX]\]\s*)?")

# Built-in new-note templates. Ids are part of the CLI contract (the Library
# menu and ``create --template`` both use them), so keep them stable. They are
# only *seeds*: on first use the store writes one file per id to
# ``<root>/templates/<id>.md`` and the files become the source of truth. Once
# ``templates/`` exists the store never re-seeds it, even if every file is
# deleted. Bodies end with a newline and use literal Markdown: callers may
# edit the result immediately without a second render step.
SEED_TEMPLATES = {
    "meeting": {
        "name": "Meeting notes",
        "description": "Attendees, agenda and action items",
        "icon": "◷",
        "content": (
            "# Meeting notes — {{date}}\n\n"
            "**Attendees:**\n- \n\n"
            "**Agenda**\n- [ ] \n\n"
            "**Notes**\n\n"
            "## Decisions\n- \n\n"
            "## Action items\n- [ ] \n"
        ),
    },
    "daily": {
        "name": "Daily log",
        "description": "Focus, log and tomorrow",
        "icon": "☀",
        "content": (
            "# {{date}}\n\n"
            "## Focus\n- [ ] \n\n"
            "## Log\n- \n\n"
            "## Tomorrow\n- [ ] \n"
        ),
    },
    "project": {
        "name": "Project spec",
        "description": "Goal, scope and milestones",
        "icon": "◆",
        "content": (
            "# Project spec\n\n"
            "## Goal\n\n"
            "## Scope\n- \n\n"
            "## Milestones\n- [ ] \n\n"
            "## Risks\n- \n\n"
            "## Links\n- \n"
        ),
    },
    "tasks": {
        "name": "Task list",
        "description": "A quick checklist",
        "icon": "☑",
        "content": (
            "# Tasks — {{date}}\n\n"
            "- [ ] \n- [ ] \n- [ ] \n"
        ),
    },
}

TEMPLATE_KEYS = ("name", "description", "icon")
TEMPLATE_ID_MAX = 64
BARE_YAML_VALUE_RE = re.compile(r"^[^\s:#\[\]{}\"'`&*!|>%@,?-](?:[^:#\[\]{}\"'`\n]*)$")


def data_root() -> Path:
    raw = os.environ.get("QUILL_DATA_DIR") or "~/.local/share/quill"
    return Path(os.path.expanduser(raw)).resolve()


ROOT = data_root()
NOTES = ROOT / "notes"
TRASH = ROOT / "trash"
TEMPLATES_DIR = ROOT / "templates"
ATTACHMENTS = ROOT / "attachments"
STATE = ROOT / "state.json"
INDEX = ROOT / "index.db"
LOCK = ROOT / ".lock"
SAVE_BUFFER = ROOT / ".save-buffer"
BACKUPS = ROOT / "backups"
VERSIONS = BACKUPS / "versions"


class StoreError(Exception):
    pass


def read_stdin(limit: int) -> bytes:
    """Read at most `limit + 1` bytes from stdin or a served request payload."""
    if SERVE_STDIN is not None:
        return SERVE_STDIN[: limit + 1]
    return sys.stdin.buffer.read(limit + 1)


# --------------------------------------------------------------------------
# storage primitives


def ensure_store() -> None:
    NOTES.mkdir(parents=True, exist_ok=True)
    TRASH.mkdir(parents=True, exist_ok=True)
    if not STATE.exists():
        write_json(STATE, {"version": 1, "pinned": []})
    seed_templates()


@contextlib.contextmanager
def locked():
    """Serialise every command that can touch files or the index.

    Atomic renames keep readers safe, but the index and state.json are
    read-modify-write, so a process lock removes the race entirely. Quill's
    UI also funnels writes through one queue; this is the second line of
    defence for concurrent CLI callers.
    """
    ensure_store()
    fd = os.open(str(LOCK), os.O_CREAT | os.O_RDWR, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        yield
    finally:
        try:
            fcntl.flock(fd, fcntl.LOCK_UN)
        finally:
            os.close(fd)


def read_json(path: Path, fallback):
    try:
        with path.open("rb") as handle:
            payload = handle.read(MAX_STATE_BYTES + 1)
        if len(payload) > MAX_STATE_BYTES:
            return fallback
        return json.loads(payload.decode("utf-8"))
    except (OSError, UnicodeDecodeError, json.JSONDecodeError):
        return fallback


def write_json(path: Path, value) -> None:
    atomic_write(path, (json.dumps(value, ensure_ascii=False, indent=2) + "\n").encode("utf-8"))


def atomic_write(path: Path, data: bytes) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix=".quill-tmp-", dir=str(path.parent))
    try:
        with os.fdopen(fd, "wb") as handle:
            handle.write(data)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, path)
    finally:
        with contextlib.suppress(OSError):
            if os.path.exists(temporary):
                os.unlink(temporary)


def safe_relative(raw: str) -> str:
    value = str(raw or "").replace("\\", "/").strip()
    if not value:
        raise StoreError("note id is empty")
    if "\x00" in value:
        raise StoreError("invalid note id")
    candidate = Path(value)
    if candidate.is_absolute() or value.startswith("/"):
        raise StoreError("invalid note id")
    if any(part in {"", ".", ".."} for part in candidate.parts):
        raise StoreError("invalid note id")
    return candidate.as_posix()


def note_path(identifier: str, trashed: bool = False) -> Path:
    relative = safe_relative(identifier)
    base = TRASH if trashed else NOTES
    path = (base / relative).resolve()
    if path != base.resolve() and base.resolve() not in path.parents:
        raise StoreError("note path escapes the data directory")
    return path


def clean_folder(raw: str) -> str:
    value = str(raw or "").strip().replace("\\", "/").strip("/")
    if not value or value == ".":
        return ""
    parts = []
    for part in value.split("/"):
        if part in {"", ".", ".."}:
            raise StoreError("invalid folder path")
        cleaned = re.sub(r"[\x00-\x1f/:]+", "-", part).strip().strip(".")
        if cleaned:
            parts.append(cleaned[:120])
    return "/".join(parts)


def rel_folder(path: Path, base: Path) -> str:
    folder = path.parent.relative_to(base).as_posix()
    return "" if folder == "." else folder


def prune_empty_dirs(start: Path) -> None:
    """Remove `start` and its now-empty ancestors, never the notes root."""
    root = NOTES.resolve()
    current = start
    while True:
        try:
            resolved = current.resolve()
        except OSError:
            return
        if resolved == root or root not in resolved.parents:
            return
        try:
            if any(current.iterdir()):
                return
            current.rmdir()
        except OSError:
            return
        current = current.parent


# --------------------------------------------------------------------------
# local version history
#
# Every snapshot is the *old* bytes of a note, named
# <UTC timestamp>-<sha256 prefix>.md inside a per-note directory under
# backups/versions/. Directories are derived from the note id with a hash
# suffix, so folder ids stay distinct and `..` cannot escape. Snapshot bytes
# are the source of truth; `versions` is a read-only listing.


def version_retention() -> int:
    raw = os.environ.get("QUILL_VERSION_RETENTION")
    try:
        value = int(raw) if raw not in (None, "") else VERSION_RETENTION_DEFAULT
    except (TypeError, ValueError):
        value = VERSION_RETENTION_DEFAULT
    return max(1, min(VERSION_RETENTION_MAX, value))


def version_throttle() -> float:
    raw = os.environ.get("QUILL_VERSION_THROTTLE")
    try:
        value = float(raw) if raw not in (None, "") else VERSION_THROTTLE_DEFAULT
    except (TypeError, ValueError):
        value = VERSION_THROTTLE_DEFAULT
    return max(0.0, value)


def version_dir(identifier: str) -> Path:
    relative = safe_relative(identifier)
    digest = hashlib.sha256(relative.encode("utf-8")).hexdigest()[:16]
    slug = re.sub(r"[^A-Za-z0-9._-]+", "-", relative).strip(".-")
    slug = slug[:80] or "note"
    directory = VERSIONS / f"{slug}-{digest}"
    if BACKUPS.is_symlink() or VERSIONS.is_symlink() or directory.is_symlink():
        raise StoreError("version directory is a symlink; refusing to follow it")
    root = ROOT.resolve()
    resolved = directory.resolve()
    if resolved != root and root not in resolved.parents:
        raise StoreError("version directory escapes the data directory")
    return directory


def version_files(directory: Path) -> list[Path]:
    if directory.is_symlink():
        raise StoreError("version directory is a symlink; refusing to follow it")
    if not directory.is_dir():
        return []
    files: list[Path] = []
    try:
        with os.scandir(directory) as entries:
            for entry in entries:
                if entry.is_symlink() or not entry.is_file(follow_symlinks=False):
                    continue
                if VERSION_FILENAME_RE.match(entry.name):
                    files.append(Path(entry.path))
    except OSError:
        return []
    try:
        files.sort(key=lambda path: (path.stat().st_mtime_ns, path.name), reverse=True)
    except OSError:
        files.sort(key=lambda path: path.name, reverse=True)
    return files


def file_sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def snapshot_note(identifier: str, data: bytes, reason: str, destructive: bool = False) -> Path | None:
    """Save `data` as a version of `identifier`.

    Ordinary autosave snapshots are throttled; destructive operations and
    restores are not. Identical snapshots are deduplicated. Any failure is
    raised so the caller can abort before touching the note.
    """
    directory = version_dir(identifier)
    digest = hashlib.sha256(data).hexdigest()
    prefix = digest[:16]
    retention = version_retention()
    existing = version_files(directory)

    for index, path in enumerate(existing):
        match = VERSION_FILENAME_RE.match(path.name)
        if not match or match.group(2) != prefix:
            continue
        try:
            if path.read_bytes() == data:
                # Only count a duplicate that retention will keep. Otherwise a
                # fresh snapshot is needed before the old one is pruned.
                if index < retention:
                    return path
                break
        except OSError:
            continue

    if not destructive and existing:
        try:
            newest_age = time.time() - existing[0].stat().st_mtime
        except OSError:
            newest_age = VERSION_THROTTLE_DEFAULT
        if newest_age < version_throttle():
            return None

    try:
        directory.mkdir(parents=True, exist_ok=True)
        stamp = time.strftime("%Y%m%dT%H%M%SZ", time.gmtime())
        name = f"{stamp}-{prefix}.md"
        target = directory / name
        counter = 1
        # Guard the (very unlikely) same-second, same-prefix collision while
        # keeping the readable timestamp-hash filename.
        while target.exists():
            try:
                if target.read_bytes() == data:
                    return target
            except OSError:
                pass
            counter += 1
            target = directory / f"{stamp}-{prefix}-{counter}.md"
        atomic_write(target, data)
    except OSError as error:
        raise StoreError(
            f"could not save {reason} snapshot for {identifier}: {error}"
        ) from error
    return target


def prune_versions(identifier: str) -> None:
    """Keep the newest `retention` snapshots; never let pruning fail a save."""
    try:
        directory = version_dir(identifier)
        files = version_files(directory)
        retention = version_retention()
        if len(files) <= retention:
            return
        for path in files[retention:]:
            try:
                path.unlink()
            except OSError:
                continue
    except (StoreError, OSError):
        return


def move_version_dir(old_id: str, new_id: str) -> None:
    """Carry a note's version history to its new id after a path change.

    Version directories are keyed by the note's path, so a move, restore or
    folder rename would otherwise leave the snapshots under an id nothing can
    reach. History is best-effort here: failing to carry it must never abort
    the file operation that already succeeded.
    """
    if old_id == new_id:
        return
    try:
        source = version_dir(old_id)
        target = version_dir(new_id)
        if source == target or not source.is_dir():
            return
        target.parent.mkdir(parents=True, exist_ok=True)
        if not target.exists():
            source.rename(target)
            return
        # Both ids already have history (for example restored under a name it
        # used before): merge them, keeping the newer copy of each snapshot.
        for path in version_files(source):
            destination = target / path.name
            if destination.exists():
                continue
            shutil.move(str(path), str(destination))
        shutil.rmtree(source, ignore_errors=True)
    except (StoreError, OSError):
        return


def snapshot_path(identifier: str, raw: str) -> Path:
    """Resolve a basename or absolute snapshot path inside one note's dir."""
    directory = version_dir(identifier).resolve()
    value = str(raw or "").strip()
    if not value:
        raise StoreError("snapshot path is empty")
    if "\x00" in value:
        raise StoreError("invalid snapshot path")
    if any(part == ".." for part in value.replace("\\", "/").split("/")):
        raise StoreError("snapshot path must not contain '..'")
    candidate = Path(os.path.expanduser(value))
    if not candidate.is_absolute():
        candidate = directory / candidate
    if candidate.is_symlink():
        raise StoreError("snapshot path is a symlink; refusing to follow it")
    try:
        resolved = candidate.resolve(strict=True)
    except OSError as error:
        raise StoreError(f"snapshot not found: {value}") from error
    if resolved.parent != directory:
        raise StoreError("snapshot is outside this note's version directory")
    if resolved.is_symlink() or not resolved.is_file():
        raise StoreError("snapshot is not a regular file")
    if not VERSION_FILENAME_RE.match(resolved.name):
        raise StoreError("snapshot name is not a Quill version")
    return resolved


def detect_newline(text: str) -> str:
    crlf = text.count("\r\n")
    lf = text.count("\n") - crlf
    return "\r\n" if crlf > lf else "\n"


def normalize_newlines(text: str, newline: str) -> str:
    normalized = text.replace("\r\n", "\n").replace("\r", "\n")
    return normalized if newline == "\n" else normalized.replace("\n", newline)


# --------------------------------------------------------------------------
# attachments
#
# Attachments live in <data>/attachments, deliberately outside notes/ so they
# are never enumerated as notes or folders. Names are content-addressed
# (<sha256>.<ext>), so saving the same bytes twice reuses one file. Images are
# sniffed from magic bytes; any other regular file is accepted as a generic
# attachment and keeps a sanitised version of its original extension.

ATTACHMENT_EXTENSION_RE = re.compile(r"^[a-z0-9]{1,10}$")


def attachments_dir() -> Path:
    if ATTACHMENTS.is_symlink():
        raise StoreError("attachments directory is a symlink; refusing to follow it")
    ATTACHMENTS.mkdir(parents=True, exist_ok=True)
    resolved = ATTACHMENTS.resolve()
    root = ROOT.resolve()
    if resolved != root and root not in resolved.parents:
        raise StoreError("attachments directory escapes the data directory")
    with contextlib.suppress(OSError):
        os.chmod(ATTACHMENTS, 0o755)
    return ATTACHMENTS


def sniff_image(data: bytes) -> tuple[str, str] | None:
    """Return (extension, mime) from magic bytes, or None for other content."""
    if data.startswith(b"\x89PNG\r\n\x1a\n"):
        return "png", "image/png"
    if data.startswith(b"\xff\xd8\xff"):
        return "jpg", "image/jpeg"
    if data[:6] in (b"GIF87a", b"GIF89a"):
        return "gif", "image/gif"
    if len(data) >= 12 and data[:4] == b"RIFF" and data[8:12] == b"WEBP":
        return "webp", "image/webp"
    if data[:2] == b"BM":
        return "bmp", "image/bmp"
    return None


def attachment_extension(source_name: str) -> str:
    """Keep a safe lowercase suffix from the source name, else ``bin``."""
    suffix = Path(source_name).suffix.lower().lstrip(".")
    return suffix if ATTACHMENT_EXTENSION_RE.match(suffix) else "bin"


def attachment_alt(raw: str, default: str = "image") -> str:
    value = unicodedata.normalize("NFC", str(raw or ""))
    value = re.sub(r"[\x00-\x1f\x7f]+", " ", value)
    value = value.replace("[", "").replace("]", "").replace("(", "").replace(")", "")
    value = re.sub(r"\s+", " ", value).strip()
    if not value:
        value = default
    return value[:120]


def markdown_destination(path: Path) -> str:
    destination = path.as_posix()
    # Parentheses and whitespace would end the Markdown destination early.
    if re.search(r"[\s()]", destination):
        destination = "<" + destination + ">"
    return destination


def attachment_markdown(alt: str, path: Path) -> str:
    return f"![{alt}]({markdown_destination(path)})"


def attachment_link(alt: str, path: Path) -> str:
    return f"[{alt}]({markdown_destination(path)})"


def attachment_files() -> list[Path]:
    """Regular files directly inside attachments/, never symlinks."""
    if not ATTACHMENTS.exists() or ATTACHMENTS.is_symlink():
        return []
    files: list[Path] = []
    try:
        with os.scandir(ATTACHMENTS) as entries:
            for entry in entries:
                if entry.name.startswith("."):
                    continue
                if entry.is_symlink() or not entry.is_file(follow_symlinks=False):
                    continue
                files.append(Path(entry.path))
    except OSError:
        return []
    return sorted(files)


def referenced_attachment_names() -> set[str]:
    """Names mentioned by any note, including trashed notes.

    Content is matched as text rather than parsed, because a note may use the
    angle-bracket destination form or HTML. False positives only keep files,
    which is the safe direction for `attachment gc`.
    """
    blobs: list[str] = []
    for base in (NOTES, TRASH):
        if not base.exists():
            continue
        for path in base.rglob("*.md"):
            try:
                if path.is_symlink() or not path.is_file():
                    continue
                payload = read_note_bytes(path, MAX_REFERENCE_BYTES)
            except OSError:
                continue
            blobs.append(payload.decode("utf-8", errors="replace"))
    text = "\n".join(blobs)
    names: set[str] = set()
    for path in attachment_files():
        name = path.name
        variants = {
            str(path),
            urllib.parse.quote(str(path)),
            str(path).replace(" ", "%20"),
            "<" + str(path) + ">",
            "attachments/" + name,
        }
        if any(variant in text for variant in variants):
            names.add(name)
    return names




def read_note_bytes(path: Path, cap: int | None = None) -> bytes:
    limit = MAX_NOTE_BYTES if cap is None else cap
    with path.open("rb") as handle:
        return handle.read(limit + 1)


def draft_path(note: Path) -> Path:
    """Crash draft adjacent to a note: <note path>.draft.

    The suffix keeps drafts out of `rglob("*.md")`, so the index and the note
    list never see them.
    """
    return note.with_name(note.name + ".draft")


def read_draft(note: Path) -> tuple[str, int] | None:
    """Read a crash draft, or None when absent/unreadable/too large."""
    draft = draft_path(note)
    try:
        if not draft.is_file():
            return None
        stat = draft.stat()
        if stat.st_size > MAX_NOTE_BYTES:
            return None
        payload = read_note_bytes(draft)
    except OSError:
        return None
    if len(payload) > MAX_NOTE_BYTES:
        return None
    return payload.decode("utf-8", errors="replace"), int(stat.st_mtime * 1000)


def move_draft(source: Path, target: Path) -> None:
    """Move `<note>.md.draft` alongside its note.

    Best-effort: a missing draft is normal, and a destination draft is never
    overwritten (that would destroy unsaved text). Failures never fail the
    note operation itself.
    """
    draft = draft_path(source)
    try:
        if not draft.is_file():
            return
        destination = draft_path(target)
        if destination.exists():
            return
        shutil.move(str(draft), str(destination))
    except OSError:
        pass


def discard_draft(note: Path) -> None:
    """Remove a note's crash draft, if any. Best-effort."""
    try:
        draft = draft_path(note)
        if draft.is_file() or draft.is_symlink():
            draft.unlink()
    except OSError:
        pass


# --------------------------------------------------------------------------
# markdown parsing


def split_frontmatter(text: str) -> tuple[str | None, str]:
    """Return (frontmatter body without fences, rest of document)."""
    if not text.startswith("---"):
        return None, text
    lines = text.splitlines(keepends=True)
    if not lines or lines[0].strip() != "---":
        return None, text
    for index in range(1, min(len(lines), 400)):
        if lines[index].strip() == "---":
            return "".join(lines[1:index]), "".join(lines[index + 1 :])
    return None, text


# --------------------------------------------------------------------------
# note templates
#
# On disk one file per template: ``<root>/templates/<id>.md``. The YAML
# frontmatter may carry ``name``, ``description`` and ``icon`` (single-line
# values); everything else is preserved verbatim when a template is saved. The
# body is ordinary Markdown. ``create --template`` renders the stored body.


def template_default_name(template_id: str) -> str:
    """Derive a display name from an id: ``weekly-review`` -> Weekly review."""
    words = str(template_id or "").replace("-", " ").strip()
    return words[:1].upper() + words[1:] if words else ""


def template_slug(raw) -> str:
    """Validate and normalise a template id.

    Lowercase, spaces/underscores to hyphens, only ``[a-z0-9-]`` kept,
    repeated hyphens collapsed, edges stripped, at most 64 characters. A
    path-like or dot-leading id is rejected rather than cleaned, because
    ``..`` must never become part of a filename.
    """
    value = str(raw or "").strip()
    if not value:
        raise StoreError("template id is empty")
    if ("/" in value or "\\" in value or ".." in value
            or value.startswith(".")):
        raise StoreError(
            f"invalid template id: {raw!r} (no '/', '\\', '..' or leading '.')")
    slug = value.casefold().replace("_", "-")
    slug = re.sub(r"\s+", "-", slug)
    slug = re.sub(r"[^a-z0-9-]+", "", slug)
    slug = re.sub(r"-{2,}", "-", slug).strip("-")
    slug = slug[:TEMPLATE_ID_MAX].strip("-")
    if not slug:
        raise StoreError(
            f"invalid template id: {raw!r} (no usable [a-z0-9-] characters)")
    return slug


def template_available_ids() -> list[str]:
    if not TEMPLATES_DIR.is_dir():
        return []
    return sorted(
        path.stem for path in TEMPLATES_DIR.glob("*.md") if path.is_file()
    )


def find_template_path(identifier, strict: bool = False) -> Path | None:
    """Resolve an id to an existing ``<id>.md`` without escaping the root.

    Lookup is case-insensitive (the file stem is the canonical id) and also
    accepts the slugified form, so ``Weekly Review`` finds ``weekly-review.md``.
    A path-like id is rejected when ``strict``; otherwise it simply misses.
    """
    raw = str(identifier or "").strip()
    if not raw:
        if strict:
            raise StoreError("template id is empty")
        return None
    try:
        slug = template_slug(raw)
    except StoreError:
        if strict:
            raise
        return None
    if not TEMPLATES_DIR.is_dir():
        return None
    wanted = {raw.casefold(), slug.casefold()}
    matches = sorted(
        path for path in TEMPLATES_DIR.glob("*.md")
        if path.is_file() and path.stem.casefold() in wanted
    )
    return matches[0] if matches else None


def parse_template_value(raw) -> str:
    """Read one single-line YAML value, quoted or bare, and strip quotes."""
    text = str(raw or "").strip()
    if len(text) >= 2 and text[0] == text[-1] and text[0] in {"'", '"'}:
        inner = text[1:-1]
        if text[0] == '"':
            try:
                return str(json.loads(text))
            except (json.JSONDecodeError, TypeError):
                return inner
        return inner.replace("''", "'")
    return text


def template_value(value) -> str:
    """Serialise a single-line YAML scalar, quoting when it needs it."""
    text = re.sub(r"\s+", " ", str(value or "")).strip()
    if not text:
        return '""'
    if BARE_YAML_VALUE_RE.match(text):
        return text
    return json.dumps(text, ensure_ascii=False)


def parse_template_document(text: str) -> tuple[dict, list[str], str]:
    """Return (owned fields, unknown frontmatter lines, body)."""
    fields = {key: "" for key in TEMPLATE_KEYS}
    unknown: list[str] = []
    frontmatter, body = split_frontmatter(text)
    if frontmatter is not None:
        for line in frontmatter.splitlines():
            match = re.match(r"^\s*([^\s:#\-][^:]*?)\s*:\s*(.*)$", line)
            key = match.group(1).strip().casefold() if match else ""
            if key in fields:
                fields[key] = parse_template_value(match.group(2))
            else:
                unknown.append(line)
    return fields, unknown, body


def compose_template_document(fields: dict, unknown: list[str], body: str) -> str:
    """Frontmatter in name/description/icon order, then preserved keys."""
    lines = ["---\n"]
    for key in TEMPLATE_KEYS:
        lines.append(f"{key}: {template_value(fields.get(key, ''))}\n")
    for line in unknown:
        lines.append(line if line.endswith("\n") else line + "\n")
    lines.append("---\n")
    return "".join(lines) + body


def seed_templates() -> None:
    """Write the four built-ins the first time ``templates/`` is created.

    Seeding is keyed on the directory, not on the individual files: once the
    directory exists an empty folder is a deliberate user choice and is never
    re-populated. Seeding is idempotent across racing processes because every
    file uses the atomic-write primitive and an existing file is left alone.
    """
    if TEMPLATES_DIR.exists():
        return
    try:
        TEMPLATES_DIR.mkdir(parents=True)
    except OSError:
        return
    for template_id, template in SEED_TEMPLATES.items():
        path = TEMPLATES_DIR / f"{template_id}.md"
        try:
            if path.exists():
                continue
            fields = {key: template.get(key, "") for key in TEMPLATE_KEYS}
            document = compose_template_document(fields, [], template["content"])
            atomic_write(path, document.encode("utf-8"))
        except OSError:
            continue


def load_template(template_id, list_available: bool = False):
    """Read one stored template: (path, fields, unknown lines, body)."""
    path = find_template_path(template_id, strict=True)
    if path is None:
        message = f"template not found: {template_id}"
        if list_available:
            choices = ", ".join(template_available_ids()) or "none installed"
            message += f" (available: {choices})"
        raise StoreError(message)
    try:
        raw = path.read_bytes()
    except OSError as error:
        raise StoreError(f"could not read template {path.stem}: {error}") from error
    try:
        text = raw.decode("utf-8")
    except UnicodeDecodeError as error:
        raise StoreError(f"template is not valid UTF-8: {path.stem}") from error
    fields, unknown, body = parse_template_document(text)
    return path, fields, unknown, body


def render_template_body(body: str, now=None) -> str:
    """Substitute the three supported placeholders, leaving others literal."""
    stamp = now if now is not None else time.localtime()
    if hasattr(stamp, "timetuple"):
        stamp = stamp.timetuple()
    values = {
        "date": time.strftime("%Y-%m-%d", stamp),
        "time": time.strftime("%H:%M", stamp),
        "datetime": time.strftime("%Y-%m-%d %H:%M", stamp),
    }
    for key, value in values.items():
        body = body.replace("{{" + key + "}}", value)
    return body


def render_template(template_id, now=None) -> str:
    """Render a stored template body with local date/time placeholders.

    ``now`` accepts a ``datetime`` or ``time.struct_time`` for tests; the
    default is the current local time. Unknown ids are a caller error.
    """
    _path, _fields, _unknown, body = load_template(
        template_id, list_available=True)
    return render_template_body(body, now)


def unquote_frontmatter_scalar(value: str) -> str:
    """Undo the quoting `rewrite_title` applies to a frontmatter title.

    Titles are written with JSON/SQL-style double quotes, so reading one back
    must decode those escapes rather than strip the outer characters: a title
    containing `"` otherwise keeps its backslashes and stops matching
    `[[wiki links]]`. Single-quoted YAML values escape `'` by doubling it.
    """
    text = str(value or "").strip()
    if len(text) >= 2 and text[0] == '"' and text[-1] == '"':
        try:
            parsed = json.loads(text)
        except ValueError:
            return text[1:-1]
        return parsed if isinstance(parsed, str) else text[1:-1]
    if len(text) >= 2 and text[0] == "'" and text[-1] == "'":
        return text[1:-1].replace("''", "'")
    return text


def frontmatter_title(frontmatter: str | None) -> str:
    if not frontmatter:
        return ""
    for line in frontmatter.splitlines():
        match = re.match(r"^\s*title\s*:\s*(.*)$", line, re.IGNORECASE)
        if not match:
            continue
        return unquote_frontmatter_scalar(match.group(1))[:120]
    return ""


def frontmatter_tags(frontmatter: str | None) -> list[str]:
    if not frontmatter:
        return []
    lines = frontmatter.splitlines()
    collected: list[str] = []
    for index, line in enumerate(lines):
        match = re.match(r"^\s*tags\s*:\s*(.*)$", line, re.IGNORECASE)
        if not match:
            continue
        rest = match.group(1).strip()
        values: list[str] = []
        if rest:
            rest = rest.strip("[]")
            values = [part.strip() for part in rest.split(",")]
        else:
            for follow in lines[index + 1 :]:
                item = re.match(r"^\s*-\s*(.+)$", follow)
                if item:
                    values.append(item.group(1).strip())
                elif follow.strip() == "":
                    continue
                else:
                    break
        for value in values:
            value = value.strip().strip("'\"").strip()
            if value:
                collected.append(value.lstrip("#"))
        break
    return normalize_tags(collected)


def fold_accents(value: str) -> str:
    """Fold common Latin accents to ASCII, matching TagSuggest.js.

    The explicit table covers letters that Unicode decomposition leaves alone
    (æ, ø, œ, ß, þ, ð); NFKD handles the rest of Latin Extended-A. Case is
    preserved so stored tags keep the author's capitalisation.
    """
    text = str(value or "").translate(ACCENT_TABLE)
    if text.isascii():
        return text
    decomposed = unicodedata.normalize("NFKD", text)
    return "".join(ch for ch in decomposed if not unicodedata.combining(ch))


def normalize_tags(values) -> list[str]:
    output: list[str] = []
    seen: set[str] = set()
    for raw in values:
        value = str(raw or "").strip().lstrip("#").strip()
        if not value:
            continue
        value = fold_accents(value)
        value = re.sub(r"[^A-Za-z0-9_/-]+", "-", value).strip("-/")
        if not value:
            continue
        key = value.casefold()
        if key in seen:
            continue
        seen.add(key)
        output.append(value[:80])
    return output


def tag_key(value: str) -> str:
    """Comparison key for a raw tag or `#tag` token (accents folded)."""
    normalized = normalize_tags([value])
    return normalized[0].casefold() if normalized else ""


def link_key(value: str) -> str:
    """Comparison key for a wiki-link target, note title, or file stem.

    Shared by indexing, link resolution, and preview rendering so a link and
    the title it names always normalise identically (casefold, then NFC, then
    casefold again so the key is stable).
    """
    return unicodedata.normalize("NFC", str(value).casefold()).casefold()


def clean_title(value) -> str:
    """Normalise a user-supplied title for storage and reporting."""
    return str(value or "").strip().replace("\n", " ")[:120] or "Untitled"


TAG_ONLY_LINE_RE = re.compile(
    r"^\s*(?:#[" + TAG_CHARS + r"]+(?:\s+|$))+$")


def append_inline_tags(content: str, tags: list[str]) -> str:
    """Append `#tag` words at the end of the body, preserving newline style.

    A trailing tag-only line (for example `#one #two`) is extended in place;
    otherwise exactly one blank line separates the body from a new tag line.
    Frontmatter is never edited because it lives above the last body line.
    """
    if not tags:
        return content
    newline = detect_newline(content)
    text = normalize_newlines(content, "\n")
    tagline = " ".join("#" + tag for tag in tags)
    trimmed = text.rstrip("\n")
    lines = trimmed.split("\n") if trimmed else []
    if lines and TAG_ONLY_LINE_RE.match(lines[-1]):
        lines[-1] = lines[-1].rstrip() + " " + tagline
        result = "\n".join(lines) + "\n"
    else:
        core = text.rstrip()
        result = (core + "\n\n" if core else "") + tagline + "\n"
    return normalize_newlines(result, newline)


def note_tags(content: str) -> list[str]:
    frontmatter, _body = split_frontmatter(content)
    return normalize_tags(frontmatter_tags(frontmatter) + extract_inline_tags(content))


def scan_blocks(text: str):
    """Yield (in_code, line) for each line, tracking fenced code blocks."""
    in_code = False
    for line in text.splitlines():
        if FENCE_RE.match(line):
            in_code = not in_code
            yield in_code, line
            continue
        yield in_code, line


def has_unclosed_fence(text: str) -> bool:
    """True when `text` ends inside a fenced code block.

    Uses the same toggle semantics as `scan_blocks`/`FENCE_RE`, so any fence
    delimiter line closes an open fence and the only way to end in code is an
    unclosed block.
    """
    in_code = False
    for line in text.splitlines():
        if FENCE_RE.match(line):
            in_code = not in_code
    return in_code


def protected_spans(line: str) -> list[tuple[int, int]]:
    """Spans that look like `#tag` but are URL fragments, not tags.

    `https://example.com/#section` and a Markdown link destination are not
    Quill tags. The link *label* is still ordinary visible text, so only the
    destination is masked (which also keeps offsets stable for rewrites).
    """
    spans = [match.span() for match in URL_RE.finditer(line)]
    spans.extend(match.span(1) for match in MD_DEST_RE.finditer(line))
    return spans


def overlaps(span: tuple[int, int], spans: list[tuple[int, int]]) -> bool:
    start, end = span
    for other_start, other_end in spans:
        if start < other_end and other_start < end:
            return True
    return False


def extract_inline_tags(text: str) -> list[str]:
    found: list[str] = []
    for in_code, line in scan_blocks(text):
        if in_code:
            continue
        protected = protected_spans(line)
        pieces: list[tuple[int, int]] = []
        cursor = 0
        for match in INLINE_CODE_RE.finditer(line):
            pieces.append((cursor, match.start()))
            cursor = match.end()
        pieces.append((cursor, len(line)))
        for start, end in pieces:
            for match in TAG_RE.finditer(line, start, end):
                if not overlaps(match.span(), protected):
                    found.append(match.group(1))
    return found


def extract_wiki_links(text: str) -> list[dict]:
    links: list[dict] = []
    for in_code, line in scan_blocks(text):
        if in_code:
            continue
        pieces: list[tuple[int, int]] = []
        cursor = 0
        for match in INLINE_CODE_RE.finditer(line):
            pieces.append((cursor, match.start()))
            cursor = match.end()
        pieces.append((cursor, len(line)))
        for start, end in pieces:
            for match in WIKI_RE.finditer(line, start, end):
                raw = match.group(1)
                target_part, _, alias = raw.partition("|")
                target_part = target_part.strip()
                heading = ""
                if "#" in target_part:
                    target_part, heading = target_part.split("#", 1)
                    target_part, heading = target_part.strip(), heading.strip()
                if not target_part:
                    continue
                links.append(
                    {
                        "target": target_part,
                        "norm": link_key(target_part),
                        "heading": heading,
                        "alias": alias.strip(),
                    }
                )
    return links


def plain_line(line: str) -> str:
    value = line.strip()
    if not value:
        return ""
    value = HEADING_RE.sub("", value)
    value = LIST_RE.sub("", value)
    value = value.replace("```", "").replace("~~~", "")
    value = re.sub(r"!\[([^\]]*)\]\([^)]*\)", r"\1", value)
    value = re.sub(r"\[\[([^\]|#]+)(?:#[^\]|]*)?(?:\|([^\]]*))?\]\]", lambda m: m.group(2) or m.group(1), value)
    value = re.sub(r"\[([^\]]*)\]\([^)]*\)", r"\1", value)
    value = value.replace("`", "")
    value = re.sub(r"[*_~]", "", value)
    value = re.sub(r"^\s*>\s?", "", value)
    return value.strip()


def title_and_snippet(content: str) -> tuple[str, str]:
    frontmatter, body = split_frontmatter(content)
    title = frontmatter_title(frontmatter)
    useful: list[str] = []
    seen_title = bool(title)
    in_code = False
    for raw in body.splitlines():
        if FENCE_RE.match(raw):
            in_code = not in_code
            continue
        if in_code:
            continue
        line = plain_line(raw)
        if not line:
            continue
        if not seen_title:
            title = line[:120]
            seen_title = True
            continue
        useful.append(line)
        if len(" ".join(useful)) >= 200:
            break
    return (title or "Untitled"), " ".join(useful)[:180]


def sanitise_link_title(value) -> str:
    """Make a title safe to inject inside `[[...]]` link syntax."""
    title = clean_title(value)
    return (
        title.replace("|", "-")
        .replace("#", "-")
        .replace("[", "(")
        .replace("]", ")")
    )


def rewrite_wiki_links(text: str, old_keys: set[str], new_title: str) -> tuple[str, int]:
    """Rewrite `[[old]]` wiki links to point at `new_title`.

    Only link targets whose `link_key` is in `old_keys` are touched. Fenced
    code, fence delimiter lines, and inline code spans are left byte-identical,
    as is all other text (including CRLF line endings). Aliases, headings, and
    the presence of `|`/`#` are preserved exactly as written.
    """
    keys = {link_key(value) for value in old_keys if value is not None}
    if not keys:
        return text, 0
    replacement_title = sanitise_link_title(new_title)
    in_code = False
    changes = 0
    output_lines: list[str] = []

    def replace(match: re.Match) -> str | None:
        nonlocal changes
        raw = match.group(1)
        target_part, sep, alias = raw.partition("|")
        stripped = target_part.strip()
        heading = None
        if "#" in stripped:
            stripped, heading = stripped.split("#", 1)
        if not stripped.strip():
            return None
        if link_key(stripped.strip()) not in keys:
            return None
        parts = replacement_title
        if heading is not None:
            parts += "#" + heading
        if sep:
            parts += "|" + alias
        rewritten = "[[" + parts + "]]"
        if rewritten == match.group(0):
            return None
        changes += 1
        return rewritten

    for line in text.splitlines(keepends=True):
        if FENCE_RE.match(line):
            in_code = not in_code
            output_lines.append(line)
            continue
        if in_code:
            output_lines.append(line)
            continue
        segments: list[tuple[int, int, bool]] = []
        cursor = 0
        for match in INLINE_CODE_RE.finditer(line):
            segments.append((cursor, match.start(), False))
            segments.append((match.start(), match.end(), True))
            cursor = match.end()
        segments.append((cursor, len(line), False))
        rewritten_line: list[str] = []
        for start, end, is_code in segments:
            segment = line[start:end]
            if is_code:
                rewritten_line.append(segment)
                continue
            pieces: list[str] = []
            last = 0
            for match in WIKI_RE.finditer(segment):
                changed = replace(match)
                if changed is None:
                    continue
                pieces.append(segment[last : match.start()])
                pieces.append(changed)
                last = match.end()
            pieces.append(segment[last:])
            rewritten_line.append("".join(pieces))
        output_lines.append("".join(rewritten_line))
    return "".join(output_lines), changes


# --------------------------------------------------------------------------
# index


def index_connect() -> sqlite3.Connection:
    ROOT.mkdir(parents=True, exist_ok=True)
    conn = sqlite3.connect(str(INDEX), timeout=15)
    conn.execute("PRAGMA journal_mode=WAL")
    conn.execute("PRAGMA synchronous=NORMAL")
    conn.execute("PRAGMA busy_timeout=15000")
    version = 0
    try:
        version = int(conn.execute("PRAGMA user_version").fetchone()[0])
    except (sqlite3.DatabaseError, TypeError):
        version = -1
    if version != SCHEMA_VERSION:
        conn.close()
        for suffix in ("", "-wal", "-shm"):
            with contextlib.suppress(OSError):
                os.unlink(str(INDEX) + suffix)
        conn = sqlite3.connect(str(INDEX), timeout=15)
        conn.execute("PRAGMA journal_mode=WAL")
        conn.execute("PRAGMA synchronous=NORMAL")
        conn.execute("PRAGMA busy_timeout=15000")
        create_schema(conn)
    return conn


def create_schema(conn: sqlite3.Connection) -> None:
    conn.executescript(
        """
        CREATE TABLE IF NOT EXISTS notes (
          key TEXT PRIMARY KEY,
          id TEXT NOT NULL,
          trashed INTEGER NOT NULL DEFAULT 0,
          folder TEXT NOT NULL DEFAULT '',
          title TEXT NOT NULL,
          stem TEXT NOT NULL,
          snippet TEXT NOT NULL DEFAULT '',
          size INTEGER NOT NULL DEFAULT 0,
          mtime_ms INTEGER NOT NULL DEFAULT 0,
          pinned INTEGER NOT NULL DEFAULT 0
        );
        CREATE INDEX IF NOT EXISTS notes_id ON notes(id);
        CREATE TABLE IF NOT EXISTS tags (
          note_key TEXT NOT NULL,
          tag TEXT NOT NULL,
          tag_key TEXT NOT NULL,
          PRIMARY KEY (note_key, tag_key)
        );
        CREATE INDEX IF NOT EXISTS tags_tag ON tags(tag_key);
        CREATE TABLE IF NOT EXISTS links (
          src_key TEXT NOT NULL,
          src_id TEXT NOT NULL,
          target TEXT NOT NULL,
          target_norm TEXT NOT NULL,
          resolved_id TEXT
        );
        CREATE INDEX IF NOT EXISTS links_target ON links(target_norm);
        CREATE INDEX IF NOT EXISTS links_resolved ON links(resolved_id);
        CREATE VIRTUAL TABLE IF NOT EXISTS notes_fts USING fts5(
          id UNINDEXED, title, body, tokenize='unicode61 remove_diacritics 2'
        );
        CREATE VIRTUAL TABLE IF NOT EXISTS notes_vocab USING fts5vocab(notes_fts, 'row');
        PRAGMA user_version=%d;
        """
        % SCHEMA_VERSION
    )
    conn.execute(f"PRAGMA user_version={SCHEMA_VERSION}")
    conn.commit()


def read_state() -> dict:
    """Return state.json as a dict, preserving unknown keys.

    A missing or malformed file reads as an empty state; callers supply their
    own defaults so pins and saved searches survive independently. Commands
    that write the file back use read_state_strict() instead.
    """
    state = read_json(STATE, {})
    return state if isinstance(state, dict) else {}


def read_state_strict() -> dict:
    """Return state.json, refusing to read a damaged file as empty.

    update_state() merges into this and writes it back, so falling back here
    would replace every pin, saved search and setting with the defaults the
    calling command happens to supply.
    """
    try:
        exists = STATE.exists()
    except OSError:
        exists = False
    if not exists:
        return {}
    state = read_json(STATE, None)
    if not isinstance(state, dict):
        raise StoreError(
            "state.json is damaged; move it aside to reset the pins, saved "
            "searches and settings it stores")
    return state


def update_state(**changes) -> dict:
    """Merge changes into state.json without dropping unrelated keys."""
    state = read_state_strict()
    state.update(changes)
    state.setdefault("version", 1)
    write_json(STATE, state)
    return state


def pinned_set() -> set[str]:
    state = read_state()
    values = state.get("pinned", [])
    return {str(value) for value in values if isinstance(value, str)}


def save_pinned(values: set[str]) -> None:
    update_state(pinned=sorted(values))


def note_key(identifier: str, trashed: bool) -> str:
    return ("T:" if trashed else "N:") + identifier


def index_file(conn: sqlite3.Connection, path: Path, trashed: bool, pinned: set[str]) -> bool:
    key = note_key(path.relative_to(TRASH if trashed else NOTES).as_posix(), trashed)
    try:
        stat = path.stat()
        raw = read_note_bytes(path, MAX_INDEX_BYTES)
    except OSError:
        return False
    binary = raw[:MAX_INDEX_BYTES]
    content = binary.decode("utf-8", errors="replace")
    frontmatter, body = split_frontmatter(content)
    title, snippet = title_and_snippet(content)
    identifier = path.relative_to(TRASH if trashed else NOTES).as_posix()
    folder = rel_folder(path, TRASH if trashed else NOTES)
    tags = []
    seen = set()
    for tag in list(frontmatter_tags(frontmatter)) + list(extract_inline_tags(body)):
        normalized = normalize_tags([tag])
        if not normalized:
            continue
        value = normalized[0]
        lowered = value.casefold()
        if lowered in seen:
            continue
        seen.add(lowered)
        tags.append(value)
    links = extract_wiki_links(content)
    is_pinned = 1 if (not trashed and identifier in pinned) else 0

    conn.execute(
        """
        INSERT INTO notes(key,id,trashed,folder,title,stem,snippet,size,mtime_ms,pinned)
        VALUES(?,?,?,?,?,?,?,?,?,?)
        ON CONFLICT(key) DO UPDATE SET
          id=excluded.id, trashed=excluded.trashed, folder=excluded.folder,
          title=excluded.title, stem=excluded.stem, snippet=excluded.snippet,
          size=excluded.size, mtime_ms=excluded.mtime_ms, pinned=excluded.pinned
        """,
        (
            key,
            identifier,
            1 if trashed else 0,
            folder,
            title,
            path.stem,
            snippet,
            stat.st_size,
            int(stat.st_mtime * 1000),
            is_pinned,
        ),
    )
    conn.execute("DELETE FROM tags WHERE note_key=?", (key,))
    conn.executemany(
        "INSERT OR REPLACE INTO tags(note_key,tag,tag_key) VALUES(?,?,?)",
        [(key, tag, tag.casefold()) for tag in tags],
    )
    conn.execute("DELETE FROM links WHERE src_key=?", (key,))
    conn.executemany(
        "INSERT INTO links(src_key,src_id,target,target_norm,resolved_id) VALUES(?,?,?,?,NULL)",
        [(key, identifier, link["target"], link["norm"]) for link in links],
    )
    conn.execute("DELETE FROM notes_fts WHERE id=?", (key,))
    conn.execute(
        "INSERT INTO notes_fts(id,title,body) VALUES(?,?,?)",
        (key, title, body[:MAX_INDEX_BYTES]),
    )
    return True


LINK_UPDATE_CHUNK = 400


def _chunks(values, size: int = LINK_UPDATE_CHUNK):
    for start in range(0, len(values), size):
        yield values[start : start + size]


def resolve_links(
    conn: sqlite3.Connection,
    src_keys=None,
    target_norms=None,
) -> None:
    """Fill `links.resolved_id` from the current (non-trashed) note titles.

    With both selectors omitted every link row is recomputed. Otherwise only
    rows whose source note is in `src_keys` or whose normalised target is in
    `target_norms` are touched, which keeps autosave and single-note mutations
    proportional to what actually changed.
    """
    rows = conn.execute(
        "SELECT id,title,stem FROM notes WHERE trashed=0 ORDER BY pinned DESC, mtime_ms DESC, id"
    ).fetchall()
    by_title: dict[str, str] = {}
    by_stem: dict[str, str] = {}
    for identifier, title, stem in rows:
        by_title.setdefault(link_key(title), str(identifier))
        by_stem.setdefault(link_key(stem), str(identifier))

    if src_keys is None and target_norms is None:
        links = conn.execute("SELECT rowid,target_norm FROM links").fetchall()
    else:
        selected: dict[int, str] = {}
        source_values = [str(value) for value in (src_keys or ()) if value is not None]
        for chunk in _chunks(source_values):
            placeholders = ",".join("?" for _ in chunk)
            for rowid, target_norm in conn.execute(
                f"SELECT rowid,target_norm FROM links WHERE src_key IN ({placeholders})",
                chunk,
            ):
                selected[rowid] = str(target_norm)
        target_values = [
            link_key(value) for value in (target_norms or ()) if value is not None
        ]
        # Preserve order while removing duplicates so the IN lists stay small.
        target_values = list(dict.fromkeys(target_values))
        for chunk in _chunks(target_values):
            placeholders = ",".join("?" for _ in chunk)
            for rowid, target_norm in conn.execute(
                f"SELECT rowid,target_norm FROM links WHERE target_norm IN ({placeholders})",
                chunk,
            ):
                selected[rowid] = str(target_norm)
        links = list(selected.items())

    for rowid, target_norm in links:
        norm = link_key(target_norm)
        resolved = by_title.get(norm) or by_stem.get(norm)
        conn.execute("UPDATE links SET resolved_id=? WHERE rowid=?", (resolved, rowid))


def index_and_resolve(conn: sqlite3.Connection, path: Path, trashed: bool = False) -> bool:
    """Reindex one note and resolve only the links affected by its title/stem."""
    root = TRASH if trashed else NOTES
    key = note_key(path.relative_to(root).as_posix(), trashed)
    old_row = conn.execute(
        "SELECT title,stem FROM notes WHERE key=?", (key,)
    ).fetchone()
    changed = index_file(conn, path, trashed, pinned_set())
    new_row = conn.execute(
        "SELECT title,stem FROM notes WHERE key=?", (key,)
    ).fetchone()
    norms: set[str] = set()
    for row in (old_row, new_row):
        if row is None:
            continue
        norms.add(link_key(row[0]))
        norms.add(link_key(row[1]))
    norms.discard(None)
    resolve_links(conn, src_keys={key}, target_norms=norms)
    return changed


def sync_index(conn: sqlite3.Connection, full: bool = False) -> bool:
    pinned = pinned_set()
    existing = {
        (row[0], row[1]): (row[2], row[3])
        for row in conn.execute("SELECT key,trashed,size,mtime_ms FROM notes").fetchall()
    }
    seen: set[tuple[str, int]] = set()
    changed = full
    changed_keys: set[str] = set()
    affected_norms: set[str] = set()
    for trashed, root in ((False, NOTES), (True, TRASH)):
        if not root.exists():
            continue
        for path in root.rglob("*.md"):
            if not path.is_file():
                continue
            identifier = path.relative_to(root).as_posix()
            key = note_key(identifier, trashed)
            try:
                stat = path.stat()
            except OSError:
                continue
            seen.add((key, 1 if trashed else 0))
            previous = existing.get((key, 1 if trashed else 0))
            if full or previous is None or previous != (stat.st_size, int(stat.st_mtime * 1000)):
                old_row = conn.execute(
                    "SELECT title,stem FROM notes WHERE key=?", (key,)
                ).fetchone()
                if index_file(conn, path, trashed, pinned):
                    changed = True
                    changed_keys.add(key)
                    new_row = conn.execute(
                        "SELECT title,stem FROM notes WHERE key=?", (key,)
                    ).fetchone()
                    for row in (old_row, new_row):
                        if row is None:
                            continue
                        affected_norms.add(link_key(row[0]))
                        affected_norms.add(link_key(row[1]))
    for (key, _trashed), _value in existing.items():
        if (key, _trashed) not in seen:
            # Links resolved to this note now become broken (trash/delete) and
            # a later restore must be able to resolve them again, so their
            # targets are part of the affected set either way.
            previous_id = conn.execute(
                "SELECT id FROM notes WHERE key=?", (key,)
            ).fetchone()
            if previous_id is not None:
                for (target_norm,) in conn.execute(
                    "SELECT DISTINCT target_norm FROM links WHERE resolved_id=?",
                    (str(previous_id[0]),),
                ).fetchall():
                    affected_norms.add(str(target_norm))
            conn.execute("DELETE FROM notes WHERE key=?", (key,))
            conn.execute("DELETE FROM tags WHERE note_key=?", (key,))
            conn.execute("DELETE FROM links WHERE src_key=?", (key,))
            conn.execute("DELETE FROM notes_fts WHERE id=?", (key,))
            changed = True
    # Pinned flags live in state.json, so they can change without touching a
    # note file. Reconcile them on every sync rather than only when a file
    # changed.
    desired = {(note_key(identifier, False)) for identifier in pinned}
    current = {row[0] for row in conn.execute("SELECT key FROM notes WHERE pinned=1").fetchall()}
    pinned_changed = desired != current
    if pinned_changed:
        conn.execute("UPDATE notes SET pinned=0")
        if pinned:
            conn.executemany(
                "UPDATE notes SET pinned=1 WHERE trashed=0 AND id=?",
                [(value,) for value in pinned],
            )
        changed = True
    if changed:
        # Pinned ordering decides which of two equal titles wins, so a pin
        # change always needs a global resolve. Otherwise scope to the notes
        # that were indexed plus every target whose resolution may have moved.
        if full or pinned_changed:
            resolve_links(conn)
        else:
            resolve_links(conn, src_keys=changed_keys, target_norms=affected_norms)
        conn.commit()
    return changed


def with_index():
    conn = index_connect()
    if not INDEX_TRUSTED:
        sync_index(conn)
    return conn


# --------------------------------------------------------------------------
# commands


def command_list(args) -> dict:
    ensure_store()
    with locked():
        conn = with_index()
        try:
            trashed = 1 if getattr(args, "trashed", False) else 0
            rows = conn.execute(
                """
                SELECT id,title,snippet,folder,mtime_ms,pinned,size
                FROM notes WHERE trashed=? AND id NOT LIKE '.quill-%'
                ORDER BY pinned DESC, mtime_ms DESC, title COLLATE NOCASE
                LIMIT ?
                """,
                (trashed, MAX_LIST_NOTES),
            ).fetchall()
            notes = []
            for identifier, title, snippet, folder, mtime_ms, pinned, size in rows:
                key = note_key(str(identifier), bool(trashed))
                tags = [
                    row[0]
                    for row in conn.execute(
                        "SELECT tag FROM tags WHERE note_key=? ORDER BY tag COLLATE NOCASE", (key,)
                    ).fetchall()
                ]
                notes.append(
                    {
                        "id": str(identifier),
                        "title": str(title),
                        "snippet": str(snippet),
                        "folder": str(folder),
                        "modified": int(mtime_ms),
                        "tags": tags,
                        "pinned": bool(pinned) and not trashed,
                        "size": int(size),
                        **({"trashed": True} if trashed else {}),
                    }
                )
            tag_rows = conn.execute(
                """
                SELECT t.tag, COUNT(*) AS n
                FROM tags t JOIN notes n ON n.key=t.note_key
                WHERE n.trashed=0
                GROUP BY t.tag_key
                ORDER BY n DESC, t.tag COLLATE NOCASE
                """
            ).fetchall()
            tag_counts = [{"tag": str(tag), "count": int(count)} for tag, count in tag_rows]
            trash_count = int(
                conn.execute("SELECT COUNT(*) FROM notes WHERE trashed=1").fetchone()[0]
            )
            total_count = int(
                conn.execute("SELECT COUNT(*) FROM notes WHERE trashed=0").fetchone()[0]
            )
        finally:
            conn.close()

    folders: list[str] = []
    if NOTES.exists():
        for directory in NOTES.rglob("*"):
            if directory.is_dir():
                folders.append(directory.relative_to(NOTES).as_posix())
            if len(folders) >= MAX_LIST_FOLDERS:
                break
    for note in notes:
        folder = note["folder"]
        if folder and folder not in folders:
            folders.append(folder)
    folders = sorted(dict.fromkeys(folders), key=str.casefold)
    return {
        "notes": notes,
        "folders": folders,
        "tags": tag_counts,
        "trashCount": trash_count,
        "totalCount": total_count,
        "maxNoteBytes": MAX_NOTE_BYTES,
    }


def command_read(args) -> dict:
    ensure_store()
    trashed = bool(getattr(args, "trashed", False))
    path = note_path(args.id, trashed=trashed)
    if not path.is_file():
        raise StoreError(f"note not found: {args.id}")
    stat = path.stat()
    identifier = safe_relative(args.id)
    if stat.st_size > MAX_NOTE_BYTES:
        return {
            "id": identifier,
            "content": "",
            "tooLarge": True,
            "size": int(stat.st_size),
            "modified": int(stat.st_mtime * 1000),
            "maxBytes": MAX_NOTE_BYTES,
        }
    payload = read_note_bytes(path)
    if len(payload) > MAX_NOTE_BYTES:
        return {
            "id": identifier,
            "content": "",
            "tooLarge": True,
            "size": len(payload),
            "modified": int(stat.st_mtime * 1000),
            "maxBytes": MAX_NOTE_BYTES,
        }
    content = payload.decode("utf-8", errors="replace")
    result = {
        "id": identifier,
        "content": content,
        "tooLarge": False,
        "size": int(stat.st_size),
        "modified": int(stat.st_mtime * 1000),
        "maxBytes": MAX_NOTE_BYTES,
    }
    # A crash draft is only interesting for a live note. Trashed notes never
    # advertise one, and an equal draft (newline style aside) is invisible.
    if not trashed:
        draft = read_draft(path)
        if draft is not None:
            draft_text, draft_modified = draft
            newline = detect_newline(content)
            if normalize_newlines(draft_text, newline) != content:
                result["draft"] = {
                    "content": draft_text,
                    "modified": draft_modified,
                }
    return result


def command_write(args) -> dict:
    # The UI hands over one throwaway `.quill-save-*` buffer per save. Clean
    # it up on every exit path (failed note lookup, oversized payload, write
    # error), but never delete a caller-supplied arbitrary file.
    content_path = None
    cleanup_path = None
    raw_content_file = getattr(args, "content_file", None)
    if raw_content_file:
        content_path = Path(os.path.expanduser(str(raw_content_file)))
        if content_path.name.startswith(".quill-save-"):
            cleanup_path = content_path
    try:
        return write_note(args, content_path)
    finally:
        if cleanup_path is not None:
            with contextlib.suppress(OSError):
                cleanup_path.unlink()


def write_note(args, content_path: Path | None) -> dict:
    ensure_store()
    identifier = safe_relative(args.id)
    path = note_path(identifier)
    create = bool(getattr(args, "create", False))
    if not path.is_file() and not create:
        raise StoreError(f"note not found: {args.id}")
    if path.exists() and not path.is_file():
        raise StoreError(f"note path is not a file: {args.id}")
    if content_path is not None:
        try:
            payload = content_path.read_bytes()
        except OSError as error:
            raise StoreError(f"could not read content file: {error}") from error
    else:
        payload = read_stdin(MAX_NOTE_BYTES)
    if len(payload) > MAX_NOTE_BYTES:
        raise StoreError(f"note exceeds {MAX_NOTE_BYTES} bytes")
    try:
        content = payload.decode("utf-8")
    except UnicodeDecodeError as error:
        raise StoreError("note content is not valid UTF-8") from error
    draft_deleted = False
    with locked():
        newline = "\n"
        if path.is_file():
            try:
                previous_raw = path.read_bytes()
            except OSError as error:
                raise StoreError(f"could not read the existing note: {error}") from error
            previous = previous_raw.decode("utf-8", errors="replace")
            newline = detect_newline(previous) if previous else "\n"
            content = normalize_newlines(content, newline)
            updated = content.encode("utf-8")
            if updated != previous_raw:
                snapshot_note(identifier, previous_raw, "write")
        else:
            # Explicit mapped id (restore path): there is no previous content
            # to snapshot, so newline normalisation starts from LF.
            path.parent.mkdir(parents=True, exist_ok=True)
            content = normalize_newlines(content, "\n")
            updated = content.encode("utf-8")
        atomic_write(path, updated)
        # The save is the source of truth now. Delete the adjacent draft only
        # when it holds exactly these bytes (newline style aside): a newer
        # draft written during the save must survive for the next open.
        try:
            draft = read_draft(path)
            if draft is not None and normalize_newlines(draft[0], newline) == content:
                draft_path(path).unlink()
                draft_deleted = True
        except OSError:
            # Draft cleanup is best-effort; it must never fail the note write.
            pass
        stat = path.stat()
        conn = index_connect()
        try:
            index_and_resolve(conn, path)
            conn.commit()
        finally:
            conn.close()
        prune_versions(identifier)
    return {
        "id": identifier,
        "modified": int(stat.st_mtime * 1000),
        "size": int(stat.st_size),
        "draftDeleted": draft_deleted,
    }


def command_draft(args) -> dict:
    ensure_store()
    identifier = safe_relative(args.id)
    path = note_path(identifier)
    discarded = False
    with locked():
        draft = draft_path(path)
        try:
            if draft.is_file() or draft.is_symlink():
                draft.unlink()
                discarded = True
        except FileNotFoundError:
            discarded = False
        except OSError as error:
            raise StoreError(f"could not discard the draft: {error}") from error
    return {"id": identifier, "discarded": discarded}


def command_create(args) -> dict:
    ensure_store()
    folder = clean_folder(args.folder)
    template_id = str(getattr(args, "template", "") or "").strip()
    if template_id:
        if args.content_stdin:
            raise StoreError("--template cannot be combined with --content-stdin")
        # The template owns its H1, so --title is ignored for its content.
        content = render_template(template_id)
    elif args.content_stdin:
        payload = read_stdin(MAX_NOTE_BYTES)
        if len(payload) > MAX_NOTE_BYTES:
            raise StoreError(f"note exceeds {MAX_NOTE_BYTES} bytes")
        try:
            content = payload.decode("utf-8")
        except UnicodeDecodeError as error:
            raise StoreError("note content is not valid UTF-8") from error
    else:
        title = str(args.title or "").strip() or "Untitled"
        content = f"# {title}\n\n"
    try:
        encoded = normalize_newlines(content, "\n").encode("utf-8")
    except UnicodeEncodeError as error:
        raise StoreError("note content is not valid UTF-8") from error
    if len(encoded) > MAX_NOTE_BYTES:
        raise StoreError(f"note exceeds {MAX_NOTE_BYTES} bytes")
    with locked():
        parent = NOTES / folder
        parent.mkdir(parents=True, exist_ok=True)
        identifier = f"{int(time.time() * 1000)}-{uuid.uuid4().hex[:8]}.md"
        path = parent / identifier
        while path.exists():
            identifier = f"{int(time.time() * 1000)}-{uuid.uuid4().hex[:8]}.md"
            path = parent / identifier
        atomic_write(path, encoded)
        conn = index_connect()
        try:
            index_and_resolve(conn, path)
            conn.commit()
        finally:
            conn.close()
        return {"id": path.relative_to(NOTES).as_posix(), "modified": int(path.stat().st_mtime * 1000)}


def template_result(path: Path, fields: dict, body: str) -> dict:
    stat = path.stat()
    return {
        "id": path.stem,
        **{key: fields.get(key, "") for key in TEMPLATE_KEYS},
        "content": body,
        "modified": int(stat.st_mtime * 1000),
    }


def command_templates(args) -> dict:
    ensure_store()
    action = str(getattr(args, "templates_action", "") or "")
    if action == "list":
        entries = []
        for path in (TEMPLATES_DIR.glob("*.md")
                     if TEMPLATES_DIR.is_dir() else []):
            if not path.is_file():
                continue
            try:
                fields, _unknown, _body = parse_template_document(
                    path.read_text(encoding="utf-8"))
                modified = int(path.stat().st_mtime * 1000)
            except (OSError, UnicodeDecodeError):
                continue
            entry = {"id": path.stem}
            entry.update({key: fields[key] for key in TEMPLATE_KEYS})
            entry["modified"] = modified
            entries.append(entry)
        entries.sort(key=lambda item: (item["name"].casefold(), item["id"]))
        return {"templates": entries}
    if action == "show":
        path, fields, _unknown, body = load_template(args.template_id)
        return template_result(path, fields, body)
    if action == "save":
        return save_template(args)
    if action == "delete":
        path, _fields, _unknown, _body = load_template(args.template_id)
        identifier = path.stem
        try:
            path.unlink()
        except OSError as error:
            raise StoreError(f"could not delete template {identifier}: {error}") from error
        return {"deleted": True, "id": identifier}
    raise StoreError(f"unknown templates action: {action}")


def save_template(args) -> dict:
    """Upsert one template file, owning only name/description/icon."""
    requested = template_slug(getattr(args, "template_id", ""))
    stdin_flag = bool(getattr(args, "content_stdin", False))
    raw_content_file = getattr(args, "content_file", None)
    with locked():
        path = find_template_path(requested, strict=True)
        if path is None:
            identifier = requested
            path = TEMPLATES_DIR / f"{identifier}.md"
            fields = {key: "" for key in TEMPLATE_KEYS}
            unknown: list[str] = []
            body = ""
        else:
            # The on-disk stem is canonical, so a case-insensitive collision
            # saves the existing file instead of creating a second one.
            identifier = path.stem
            try:
                existing_text = path.read_bytes().decode("utf-8")
            except OSError as error:
                raise StoreError(f"could not read template {identifier}: {error}") from error
            except UnicodeDecodeError as error:
                raise StoreError(f"template is not valid UTF-8: {identifier}") from error
            fields, unknown, body = parse_template_document(existing_text)
        if stdin_flag:
            payload = read_stdin(MAX_NOTE_BYTES)
        elif raw_content_file:
            source = Path(os.path.expanduser(str(raw_content_file)))
            try:
                payload = source.read_bytes()
            except OSError as error:
                raise StoreError(f"could not read content file: {error}") from error
        else:
            payload = None
        if payload is not None:
            if len(payload) > MAX_NOTE_BYTES:
                raise StoreError(f"template exceeds {MAX_NOTE_BYTES} bytes")
            try:
                body = payload.decode("utf-8")
            except UnicodeDecodeError as error:
                raise StoreError("template content is not valid UTF-8") from error
        name = getattr(args, "name", None)
        if name is None or not str(name).strip():
            name = fields.get("name") or template_default_name(identifier)
        else:
            name = str(name).strip()
        description = getattr(args, "description", None)
        if description is None:
            description = fields.get("description", "")
        icon = getattr(args, "icon", None)
        if icon is None:
            icon = fields.get("icon", "")
        fields = {
            "name": name,
            "description": str(description or "").strip(),
            "icon": str(icon or "").strip(),
        }
        try:
            encoded = body.encode("utf-8")
        except UnicodeEncodeError as error:
            raise StoreError("template content is not valid UTF-8") from error
        if len(encoded) > MAX_NOTE_BYTES:
            raise StoreError(f"template exceeds {MAX_NOTE_BYTES} bytes")
        document = compose_template_document(fields, unknown, body)
        atomic_write(path, document.encode("utf-8"))
        return template_result(path, fields, body)


def decode_note_utf8(raw: bytes) -> str:
    """Decode stored note bytes, refusing anything that is not UTF-8.

    Commands that rewrite a note must not fall back to replacement characters:
    writing the result back would silently corrupt every non-UTF-8 byte. Reads
    that never write can keep using errors="replace".
    """
    try:
        return raw.decode("utf-8")
    except UnicodeDecodeError as error:
        raise StoreError("note is not valid UTF-8") from error


def rewrite_title(content: str, title: str) -> str:
    clean = clean_title(title)
    newline = detect_newline(content)
    lines = content.splitlines(keepends=True)
    # Update frontmatter title when one exists, because it wins over headings.
    if lines and lines[0].strip() == "---":
        closing = None
        for index in range(1, min(len(lines), 400)):
            if lines[index].strip() == "---":
                closing = index
                break
        if closing is not None:
            for index in range(1, closing):
                match = re.match(r"^(\s*title\s*:\s*)(.*?)(\r?\n)?$", lines[index], re.IGNORECASE)
                if match:
                    lines[index] = match.group(1) + json.dumps(clean, ensure_ascii=False) + (match.group(3) or "")
                    return "".join(lines)
            lines.insert(closing, f"title: {json.dumps(clean, ensure_ascii=False)}{newline}")
            return "".join(lines)
    fence = ""
    for index, line in enumerate(lines):
        marker = FENCE_RE.match(line)
        if marker:
            # Track fences so a `# comment` inside a code block is not taken
            # for the note's heading.
            char = marker.group(1)[0]
            if fence == "":
                fence = char
            elif fence == char:
                fence = ""
            continue
        if fence:
            continue
        if HEADING_RE.match(line):
            ending = "\r\n" if line.endswith("\r\n") else "\n" if line.endswith("\n") else ""
            lines[index] = f"# {clean}{ending}"
            return "".join(lines)
    prefix = f"# {clean}{newline}"
    if content and not content.startswith(("\n", "\r\n")):
        prefix += newline
    return prefix + content


COPY_SUFFIX_RE = re.compile(r"\s+copy(?:\s+\d+)?$", re.IGNORECASE)


def copy_title(base: str, used: set[str]) -> str:
    """Return the next unused "<base> copy" / "<base> copy N" title."""
    stem = COPY_SUFFIX_RE.sub("", str(base or "").strip()).strip() or "Untitled"
    counter = 1
    while True:
        title = f"{stem} copy" if counter == 1 else f"{stem} copy {counter}"
        if title.casefold() not in used:
            return title
        counter += 1


def command_duplicate(args) -> dict:
    ensure_store()
    identifier = safe_relative(args.id)
    with locked():
        source = note_path(identifier)
        if not source.is_file():
            trashed = note_path(identifier, trashed=True)
            if trashed.is_file():
                raise StoreError(
                    f"note is in Trash: {identifier} (restore it before duplicating)")
            raise StoreError(f"note not found: {identifier}")
        try:
            source_stat = source.stat()
        except OSError as error:
            raise StoreError(f"could not read the note: {error}") from error
        if source_stat.st_size > MAX_NOTE_BYTES:
            raise StoreError(f"note exceeds {MAX_NOTE_BYTES} bytes")
        try:
            data = source.read_bytes()
        except OSError as error:
            raise StoreError(f"could not read the note: {error}") from error
        if len(data) > MAX_NOTE_BYTES:
            raise StoreError(f"note exceeds {MAX_NOTE_BYTES} bytes")
        content = decode_note_utf8(data)
        folder_path = source.parent.relative_to(NOTES)
        folder = "" if str(folder_path) == "." else folder_path.as_posix()
        conn = index_connect()
        try:
            sync_index(conn)
            used = {
                str(row[0]).casefold()
                for row in conn.execute(
                    "SELECT title FROM notes WHERE folder=? AND trashed=0", (folder,)
                ).fetchall()
            }
            base, _snippet = title_and_snippet(content)
            title = copy_title(base, used)
            updated = rewrite_title(content, title)
            try:
                encoded = normalize_newlines(updated, detect_newline(content)).encode("utf-8")
            except UnicodeEncodeError as error:
                raise StoreError("note content is not valid UTF-8") from error
            if len(encoded) > MAX_NOTE_BYTES:
                raise StoreError(f"note exceeds {MAX_NOTE_BYTES} bytes")
            target_dir = NOTES / folder_path
            target_dir.mkdir(parents=True, exist_ok=True)
            new_id = f"{int(time.time() * 1000)}-{uuid.uuid4().hex[:8]}.md"
            target = target_dir / new_id
            while target.exists():
                new_id = f"{int(time.time() * 1000)}-{uuid.uuid4().hex[:8]}.md"
                target = target_dir / new_id
            atomic_write(target, encoded)
            index_and_resolve(conn, target)
            conn.commit()
        finally:
            conn.close()
        stat = target.stat()
    return {
        "id": target.relative_to(NOTES).as_posix(),
        "modified": int(stat.st_mtime * 1000),
    }


def command_rename(args) -> dict:
    ensure_store()
    identifier = safe_relative(args.id)
    path = note_path(identifier)
    if not path.is_file():
        raise StoreError(f"note not found: {args.id}")
    title = clean_title(getattr(args, "title", ""))
    update_links = str(getattr(args, "links", "update") or "update") != "skip"
    dry_run = bool(getattr(args, "dry_run", False))
    with locked():
        try:
            previous_raw = path.read_bytes()
        except OSError as error:
            raise StoreError(f"could not read the existing note: {error}") from error
        content = decode_note_utf8(previous_raw)
        # Open the index first so a stale cache cannot hide inbound links.
        old_norms: set[str] = set()
        conn = with_index()
        try:
            old_norms = {
                str(row[0])
                for row in conn.execute(
                    "SELECT DISTINCT target_norm FROM links WHERE resolved_id=?",
                    (identifier,),
                ).fetchall()
            }
        finally:
            conn.close()
        updated_content = rewrite_title(content, title)
        rewrite = update_links and bool(old_norms)

        if dry_run:
            links_updated = 0
            sources: list[dict] = []
            for candidate in sorted(NOTES.rglob("*.md")):
                if not candidate.is_file():
                    continue
                try:
                    raw = candidate.read_bytes()
                except OSError:
                    continue
                if len(raw) > MAX_NOTE_BYTES:
                    continue
                try:
                    note_content = raw.decode("utf-8")
                except UnicodeDecodeError:
                    continue
                source_id = candidate.relative_to(NOTES).as_posix()
                if source_id == identifier:
                    if rewrite:
                        _text, count = rewrite_wiki_links(updated_content, old_norms, title)
                        links_updated += count
                    continue
                if not rewrite:
                    continue
                _text, count = rewrite_wiki_links(note_content, old_norms, title)
                if not count:
                    continue
                source_title, _snippet = title_and_snippet(note_content)
                links_updated += count
                sources.append(
                    {"id": source_id, "title": source_title, "count": count}
                )
            return {
                "id": identifier,
                "title": title,
                "dryRun": True,
                "linksUpdated": links_updated,
                "notesUpdated": len(sources),
                "sources": sources,
            }

        updated = updated_content.encode("utf-8")
        if updated != previous_raw:
            snapshot_note(identifier, previous_raw, "rename", destructive=True)
        atomic_write(path, updated)
        links_updated = 0
        sources: list[dict] = []
        if rewrite:
            # Live notes only: trashed notes must stay byte-identical, and a
            # draft is never scanned because it is not a `*.md` file.
            for candidate in sorted(NOTES.rglob("*.md")):
                if not candidate.is_file():
                    continue
                try:
                    raw = candidate.read_bytes()
                except OSError:
                    continue
                if len(raw) > MAX_NOTE_BYTES:
                    continue
                try:
                    note_content = raw.decode("utf-8")
                except UnicodeDecodeError:
                    continue
                rewritten, count = rewrite_wiki_links(note_content, old_norms, title)
                if not count:
                    continue
                encoded = rewritten.encode("utf-8")
                if encoded == raw:
                    continue
                source_id = candidate.relative_to(NOTES).as_posix()
                snapshot_note(source_id, raw, "link-rename", destructive=True)
                atomic_write(candidate, encoded)
                links_updated += count
                if source_id != identifier:
                    source_title, _snippet = title_and_snippet(note_content)
                    sources.append(
                        {"id": source_id, "title": source_title, "count": count}
                    )
        conn = index_connect()
        try:
            changed_keys: set[str] = set()
            for source_id in [identifier] + [source["id"] for source in sources]:
                source_path = note_path(source_id)
                changed_keys.add(note_key(source_id, False))
                index_file(conn, source_path, False, pinned_set())
            target_norms = set(old_norms)
            target_norms.add(link_key(title))
            resolve_links(conn, src_keys=changed_keys, target_norms=target_norms)
            conn.commit()
        finally:
            conn.close()
        for source in sources:
            prune_versions(source["id"])
        prune_versions(identifier)
        stat = path.stat()
    return {
        "id": identifier,
        "modified": int(stat.st_mtime * 1000),
        "title": title,
        "linksUpdated": links_updated,
        "notesUpdated": len(sources),
        "sources": sources,
    }


def unique_target(directory: Path, name: str, suffix: str = "") -> Path:
    target = directory / name
    if not target.exists():
        return target
    stem = Path(name).stem
    extension = Path(name).suffix
    counter = 1
    while True:
        candidate = directory / f"{stem}-{suffix or ''}{counter}{extension}"
        if not candidate.exists():
            return candidate
        counter += 1


def collect_ids(args) -> list[str]:
    """Every id for a bulk call: the positional primary id, then ``--id``.

    Deduplicated in order so `trash <id> --id <id>` stays a single-note call.
    """
    values: list[str] = []
    primary = getattr(args, "id", None)
    if primary is not None:
        values.append(primary)
    values.extend(getattr(args, "more_ids", None) or [])
    seen: set[str] = set()
    output: list[str] = []
    for value in values:
        if value in seen:
            continue
        seen.add(value)
        output.append(value)
    return output


def batch_targets(args, trashed: bool = False) -> list[tuple[str, Path]]:
    """Validate every id before the caller performs any write.

    All-or-nothing batches depend on this running first: one missing note
    raises before a single file is touched, so the CLI exits 1 with the
    store unchanged.
    """
    targets: list[tuple[str, Path]] = []
    seen: set[str] = set()
    for raw in collect_ids(args):
        identifier = safe_relative(raw)
        if identifier in seen:
            continue
        seen.add(identifier)
        path = note_path(identifier, trashed=trashed)
        if not path.is_file():
            label = "note not found in trash" if trashed else "note not found"
            raise StoreError(f"{label}: {identifier}")
        targets.append((identifier, path))
    return targets


def sync_index_once() -> None:
    """Refresh the derived index once, at the end of a bulk command."""
    conn = index_connect()
    try:
        sync_index(conn)
    finally:
        conn.close()


def apply_note_content(
    identifier: str, path: Path, previous_raw: bytes, updated_content: str, reason: str
) -> tuple[bool, bool]:
    """Write changed bytes for one note; return (changed, draft_deleted)."""
    updated = updated_content.encode("utf-8")
    if updated == previous_raw:
        return False, False
    snapshot_note(identifier, previous_raw, reason)
    atomic_write(path, updated)
    draft_deleted = False
    try:
        draft = read_draft(path)
        if (draft is not None
                and normalize_newlines(draft[0], detect_newline(updated_content))
                == updated_content):
            draft_path(path).unlink()
            draft_deleted = True
    except OSError:
        pass
    return True, draft_deleted


def move_note(identifier: str, source: Path, target_dir: Path, pins: set[str]) -> str:
    """Move one live note; remap its pin in the shared in-memory set."""
    target = target_dir / source.name
    if target.resolve() == source.resolve():
        return identifier
    if target.exists():
        target = unique_target(target_dir, source.name, "moved")
    try:
        data = source.read_bytes()
    except OSError as error:
        raise StoreError(f"could not read the note before moving it: {error}") from error
    snapshot_note(identifier, data, "move", destructive=True)
    shutil.move(str(source), str(target))
    move_draft(source, target)
    prune_empty_dirs(source.parent)
    next_id = target.relative_to(NOTES).as_posix()
    move_version_dir(identifier, next_id)
    if identifier in pins:
        pins.discard(identifier)
        pins.add(next_id)
    prune_versions(next_id)
    return next_id


def command_move(args) -> dict:
    ensure_store()
    folder = clean_folder(args.folder)
    targets = batch_targets(args)
    with locked():
        target_dir = NOTES / folder
        target_dir.mkdir(parents=True, exist_ok=True)
        pins = pinned_set()
        pins_before = set(pins)
        new_ids = [
            move_note(identifier, source, target_dir, pins)
            for identifier, source in targets
        ]
        if pins != pins_before:
            save_pinned(pins)
        sync_index_once()
    return {"id": new_ids[0], "ids": new_ids, "count": len(new_ids)}


def trash_note(identifier: str, source: Path, pins: set[str]) -> str:
    """Move one live note into the trash, preserving its folder path."""
    target_dir = TRASH / source.parent.relative_to(NOTES)
    target_dir.mkdir(parents=True, exist_ok=True)
    target = target_dir / source.name
    if target.exists():
        target = unique_target(target_dir, source.name, "trashed-")
    try:
        data = source.read_bytes()
    except OSError as error:
        raise StoreError(f"could not read the note before trashing it: {error}") from error
    snapshot_note(identifier, data, "trash", destructive=True)
    shutil.move(str(source), str(target))
    move_draft(source, target)
    prune_empty_dirs(source.parent)
    pins.discard(identifier)
    prune_versions(identifier)
    return target.relative_to(TRASH).as_posix()


def command_trash(args) -> dict:
    ensure_store()
    targets = batch_targets(args)
    with locked():
        pins = pinned_set()
        pins_before = set(pins)
        new_ids = [
            trash_note(identifier, source, pins)
            for identifier, source in targets
        ]
        if pins != pins_before:
            save_pinned(pins)
        sync_index_once()
    return {"id": new_ids[0], "ids": new_ids, "count": len(new_ids)}


def restore_note(identifier: str, source: Path) -> str:
    """Move one trashed note back to its mirrored live folder."""
    target_dir = NOTES / source.parent.relative_to(TRASH)
    target_dir.mkdir(parents=True, exist_ok=True)
    target = target_dir / source.name
    if target.exists():
        target = unique_target(target_dir, source.name, "restored-")
    shutil.move(str(source), str(target))
    move_draft(source, target)
    prune_empty_dirs(source.parent)
    next_id = target.relative_to(NOTES).as_posix()
    move_version_dir(identifier, next_id)
    return next_id


def command_restore(args) -> dict:
    ensure_store()
    targets = batch_targets(args, trashed=True)
    with locked():
        new_ids = [restore_note(identifier, source) for identifier, source in targets]
        sync_index_once()
    return {"id": new_ids[0], "ids": new_ids, "count": len(new_ids)}


def delete_note(identifier: str, path: Path) -> None:
    """Permanently delete one note from the trash after snapshotting it."""
    try:
        data = path.read_bytes()
    except OSError as error:
        raise StoreError(f"could not read the note before deleting it: {error}") from error
    snapshot_note(identifier, data, "delete", destructive=True)
    path.unlink()
    discard_draft(path)
    prune_versions(identifier)


def command_delete(args) -> dict:
    ensure_store()
    targets = batch_targets(args, trashed=True)
    with locked():
        for identifier, path in targets:
            delete_note(identifier, path)
        sync_index_once()
    identifiers = [identifier for identifier, _path in targets]
    return {
        "deleted": True,
        "id": identifiers[0],
        "ids": identifiers,
        "count": len(identifiers),
    }


def command_versions(args) -> dict:
    """Read-only listing; deliberately does not create the store or index."""
    identifier = safe_relative(args.id)
    directory = version_dir(identifier)
    versions = []
    for path in version_files(directory):
        try:
            stat = path.stat(follow_symlinks=False)
            digest = file_sha256(path)
        except OSError:
            continue
        versions.append(
            {
                "path": str(path.resolve()),
                "name": path.name,
                "mtime": int(stat.st_mtime * 1000),
                "size": int(stat.st_size),
                "sha256": digest,
            }
        )
    return {"id": identifier, "versions": versions, "retention": version_retention()}


def command_restore_version(args) -> dict:
    ensure_store()
    identifier = safe_relative(args.id)
    snapshot = snapshot_path(identifier, args.snapshot)
    try:
        data = snapshot.read_bytes()
    except OSError as error:
        raise StoreError(f"could not read snapshot: {error}") from error
    if len(data) > MAX_NOTE_BYTES:
        raise StoreError(f"snapshot exceeds {MAX_NOTE_BYTES} bytes")
    path = note_path(identifier)
    with locked():
        if path.exists() and not path.is_file():
            raise StoreError(f"note path is not a file: {identifier}")
        if path.is_file():
            try:
                current = path.read_bytes()
            except OSError as error:
                raise StoreError(f"could not read the current note: {error}") from error
            if current != data:
                snapshot_note(identifier, current, "restore-version", destructive=True)
        else:
            path.parent.mkdir(parents=True, exist_ok=True)
        atomic_write(path, data)
        stat = path.stat()
        conn = index_connect()
        try:
            index_and_resolve(conn, path)
            conn.commit()
        finally:
            conn.close()
        prune_versions(identifier)
    return {
        "id": identifier,
        "size": int(stat.st_size),
        "modified": int(stat.st_mtime * 1000),
        "snapshot": snapshot.name,
    }


def command_empty_trash(_args) -> dict:
    ensure_store()
    deleted = 0
    snapshotted: list[str] = []
    with locked():
        files = [path for path in TRASH.rglob("*") if path.is_file()] if TRASH.exists() else []
        # Snapshot every note before deleting anything. A snapshot failure
        # aborts the whole operation, so Trash is never partially destroyed.
        for path in files:
            if path.suffix.lower() != ".md":
                continue
            identifier = path.relative_to(TRASH).as_posix()
            try:
                data = path.read_bytes()
            except OSError as error:
                raise StoreError(
                    f"could not read a trashed note before emptying Trash: {error}"
                ) from error
            snapshot_note(identifier, data, "empty-trash", destructive=True)
            snapshotted.append(identifier)
        for path in sorted(files, key=lambda item: len(item.parts), reverse=True):
            with contextlib.suppress(OSError):
                path.unlink()
                deleted += 1
        if TRASH.exists():
            for path in sorted(TRASH.rglob("*"), key=lambda item: len(item.parts), reverse=True):
                if path.is_dir():
                    with contextlib.suppress(OSError):
                        path.rmdir()
        conn = index_connect()
        try:
            sync_index(conn)
        finally:
            conn.close()
        for identifier in snapshotted:
            prune_versions(identifier)
    return {"deleted": deleted}


def pin_note(identifier: str, path: Path, mode: str, pins: set[str]) -> bool:
    """Apply one pin change; return True only when the state changed."""
    current = identifier in pins
    desired = not current if mode == "toggle" else mode == "on"
    if desired == current:
        return False
    try:
        data = path.read_bytes()
    except OSError as error:
        raise StoreError(f"could not read the note before pinning it: {error}") from error
    snapshot_note(identifier, data, "pin", destructive=True)
    if desired:
        pins.add(identifier)
    else:
        pins.discard(identifier)
    prune_versions(identifier)
    return True


def command_pin(args) -> dict:
    ensure_store()
    mode = str(getattr(args, "state", "toggle") or "toggle")
    if mode not in {"on", "off", "toggle"}:
        raise StoreError(f"invalid pin state: {mode}")
    targets = batch_targets(args)
    identifiers = [identifier for identifier, _path in targets]
    with locked():
        pins = pinned_set()
        pins_before = set(pins)
        updated = 0
        for identifier, path in targets:
            if pin_note(identifier, path, mode, pins):
                updated += 1
        if pins != pins_before:
            save_pinned(pins)
        sync_index_once()
        state = identifiers[0] in pins
    return {
        "id": identifiers[0],
        "ids": identifiers,
        "pinned": state,
        "updated": updated,
    }


def command_folder(args) -> dict:
    ensure_store()
    action = args.folder_action
    snapshotted: list[str] = []
    with locked():
        if action == "create":
            folder = clean_folder(args.path)
            if not folder:
                raise StoreError("folder name is empty")
            target = NOTES / folder
            if target.exists():
                raise StoreError(f"folder already exists: {folder}")
            target.mkdir(parents=True)
            result = {"folder": folder}
        elif action == "rename":
            folder = clean_folder(args.path)
            if not folder:
                raise StoreError("cannot rename the notes root")
            source = NOTES / folder
            if not source.is_dir():
                raise StoreError(f"folder not found: {folder}")
            next_name = clean_folder(args.new)
            if not next_name:
                raise StoreError("new folder name is empty")
            target = NOTES / next_name
            if target.exists() and target != source:
                raise StoreError(f"folder already exists: {next_name}")
            target.parent.mkdir(parents=True, exist_ok=True)
            source.rename(target)
            # Note ids carry the folder path, so their history does too.
            for path in sorted(target.rglob("*.md")):
                if not path.is_file():
                    continue
                relative = path.relative_to(target).as_posix()
                move_version_dir(f"{folder}/{relative}", f"{next_name}/{relative}")
            pins = pinned_set()
            next_pins = set()
            for pin in pins:
                if pin == folder or pin.startswith(folder + "/"):
                    next_pins.add(next_name + pin[len(folder) :])
                else:
                    next_pins.add(pin)
            save_pinned(next_pins)
            prune_empty_dirs(source.parent)
            result = {"folder": next_name, "from": folder}
        elif action == "delete":
            folder = clean_folder(args.path)
            if not folder:
                raise StoreError("cannot delete the notes root")
            target = NOTES / folder
            if not target.is_dir():
                raise StoreError(f"folder not found: {folder}")
            files = [path for path in target.rglob("*") if path.is_file()]
            if files and not args.force:
                raise StoreError(f"folder is not empty: {folder}")
            # Notes moved out of the folder survive, but the folder itself is
            # removed and non-Markdown files are discarded. Snapshot every note
            # first so a failure aborts before anything is moved or deleted.
            for path in files:
                if path.suffix.lower() != ".md":
                    continue
                identifier = path.relative_to(NOTES).as_posix()
                try:
                    data = path.read_bytes()
                except OSError as error:
                    raise StoreError(
                        f"could not read a note before deleting the folder: {error}"
                    ) from error
                snapshot_note(identifier, data, "folder-delete", destructive=True)
                snapshotted.append(identifier)
            moved = 0
            if files:
                root = NOTES
                for path in files:
                    if path.suffix.lower() != ".md":
                        with contextlib.suppress(OSError):
                            path.unlink()
                        continue
                    identifier = path.relative_to(NOTES).as_posix()
                    destination = root / path.name
                    if destination.exists():
                        destination = unique_target(root, path.name, "moved")
                    shutil.move(str(path), str(destination))
                    move_version_dir(
                        identifier, destination.relative_to(NOTES).as_posix())
                    moved += 1
                pins = pinned_set()
                next_pins = set()
                for pin in pins:
                    if pin.startswith(folder + "/"):
                        next_pins.add(Path(pin).name)
                    else:
                        next_pins.add(pin)
                save_pinned(next_pins)
            for path in sorted(target.rglob("*"), key=lambda item: len(item.parts), reverse=True):
                if path.is_dir():
                    with contextlib.suppress(OSError):
                        path.rmdir()
            with contextlib.suppress(OSError):
                target.rmdir()
            prune_empty_dirs(target.parent)
            result = {"deleted": True, "folder": folder, "moved": moved}
        else:
            raise StoreError("unknown folder action")
        conn = index_connect()
        try:
            sync_index(conn)
        finally:
            conn.close()
        for identifier in snapshotted:
            prune_versions(identifier)
    return result


def fold_term(value: str) -> str:
    """Case- and accent-fold a term the way the unicode61 index tokenizer does."""
    decomposed = unicodedata.normalize("NFKD", str(value or ""))
    return "".join(ch for ch in decomposed if not unicodedata.combining(ch)).casefold()


def osa_distance(left: str, right: str, limit: int) -> int:
    """Optimal string alignment distance, banded to ``limit``; > limit means "too far"."""
    if left == right:
        return 0
    if abs(len(left) - len(right)) > limit:
        return limit + 1
    inf = limit + 1
    previous_previous = None
    previous = [j if j <= limit else inf for j in range(len(right) + 1)]
    for i in range(1, len(left) + 1):
        current = [inf] * (len(right) + 1)
        current[0] = i if i <= limit else inf
        for j in range(max(1, i - limit), min(len(right), i + limit) + 1):
            cost = 0 if left[i - 1] == right[j - 1] else 1
            value = min(previous[j] + 1, current[j - 1] + 1, previous[j - 1] + cost)
            if (
                i > 1
                and j > 1
                and previous_previous is not None
                and left[i - 1] == right[j - 2]
                and left[i - 2] == right[j - 1]
            ):
                value = min(value, previous_previous[j - 2] + 1)
            current[j] = value
        previous_previous, previous = previous, current
    return previous[-1] if previous[-1] <= limit else inf


def quote_term(value: str) -> str:
    """Quote a term for FTS5, doubling embedded quotes."""
    return '"' + str(value).replace('"', '""') + '"'


def vocabulary_matches(conn, folded: str, limit: int, suffix: bool = False) -> list:
    """Vocabulary terms near ``folded``.

    Terms are fetched through the first character (a range scan over the
    sorted vocabulary) or, when a first-character typo left that empty,
    through the last character. Scanning every term costs seconds on a large
    library; this keeps a typo query in the tens of milliseconds.
    """
    matched = []
    if suffix:
        if not folded[-1].isalnum():
            return matched
        low = max(1, len(folded) - limit)
        high = len(folded) + limit
        rows = conn.execute(
            "SELECT term, doc FROM notes_vocab WHERE term GLOB ? AND length(term) BETWEEN ? AND ?",
            ("*" + folded[-1], low, high),
        )
    else:
        first = folded[0]
        rows = conn.execute(
            "SELECT term, doc FROM notes_vocab WHERE term >= ? AND term < ?",
            (first, chr(ord(first) + 1)),
        )
    for term, doc in rows:
        term = str(term)
        # Prefixes of any length count: "sear" must still find "searching".
        if term.startswith(folded):
            matched.append((0, -int(doc), term))
            continue
        if abs(len(term) - len(folded)) > limit:
            continue
        distance = osa_distance(folded, term, limit)
        if distance <= limit:
            matched.append((distance, -int(doc), term))
    return matched


def fuzzy_query(raw: str, conn: sqlite3.Connection) -> str:
    """Expand each query token to close vocabulary terms, joined with AND."""
    tokens = re.findall(r"[^\s]+", str(raw or ""))[:12]
    if not tokens:
        return ""
    conn.execute("CREATE VIRTUAL TABLE IF NOT EXISTS notes_vocab USING fts5vocab(notes_fts, 'row')")
    docs = int(conn.execute("SELECT COUNT(*) FROM notes WHERE trashed=0").fetchone()[0] or 0)
    common = max(1, int(docs * 0.6)) if docs else 0
    parts = []
    for token in tokens:
        folded = fold_term(token)
        if len(folded) < FUZZY_MIN_TOKEN or not folded[0].isalnum():
            parts.append(quote_term(folded) + "*")
            continue
        limit = 1 if len(folded) <= 5 else 2
        matched = vocabulary_matches(conn, folded, limit)
        if not matched and len(folded) >= 4:
            # First-character typo ("wuill" for "quill"): the first-character
            # bucket cannot see it, so look at terms ending the same way.
            matched = vocabulary_matches(conn, folded, limit, suffix=True)
        if not matched:
            parts.append(quote_term(folded) + "*")
            continue
        nearest = min(item[0] for item in matched)
        matched = [item for item in matched if item[0] == nearest]
        if nearest > 0:
            # A typo must not expand into an everyday word that matches most notes.
            filtered = [item for item in matched if -item[1] <= common]
            if filtered:
                matched = filtered
        matched.sort()
        chosen = [item[2] for item in matched[:FUZZY_TERMS]]
        parts.append("(" + " OR ".join(quote_term(term) for term in chosen) + ")")
    return " AND ".join(parts)


def fts_query(raw: str) -> str:
    tokens = re.findall(r"[^\s]+", str(raw or ""))
    tokens = tokens[:12]
    parts = []
    for token in tokens:
        cleaned = token.replace('"', '""')
        if cleaned.strip('"*'):
            parts.append(f'"{cleaned}"*')
    return " AND ".join(parts)


SEARCH_FILTER_KEYS = ("tag", "folder", "before", "after")
DATE_ONLY_RE = re.compile(r"^\d{4}-\d{2}-\d{2}$")


def _read_quoted(text: str, start: int) -> tuple[str, int]:
    """Read a double-quoted value from ``text[start]``.

    A doubled quote is one literal quote inside the value. An unterminated
    quote is a user error rather than a partial match.
    """
    index = start + 1
    output: list[str] = []
    length = len(text)
    while index < length:
        char = text[index]
        if char == '"':
            if index + 1 < length and text[index + 1] == '"':
                output.append('"')
                index += 2
                continue
            return "".join(output), index + 1
        output.append(char)
        index += 1
    raise StoreError("unterminated quote in search query")


def local_day_start_ms(value: str, key: str) -> int:
    """Return local midnight for a strict YYYY-MM-DD value, as Unix ms."""
    if not DATE_ONLY_RE.match(value):
        raise StoreError(f"invalid date in {key}:{value}; expected YYYY-MM-DD")
    try:
        day = datetime.date.fromisoformat(value)
    except ValueError as error:
        raise StoreError(f"invalid date in {key}:{value}; expected YYYY-MM-DD") from error
    return int(datetime.datetime.combine(day, datetime.time.min).timestamp() * 1000)


def parse_search_query(raw: str) -> dict:
    """Split a search string into free terms, filters, and negations.

    Recognised filters are only created by a leading, unquoted ``key:``. A
    quoted value may contain anything, including ``tag:``. Unknown ``foo:bar``
    stays a free-text token.
    """
    text = str(raw or "")
    parsed = {
        "empty": True,
        "plain": False,
        "structured": False,
        "negated": False,
        "phrase": False,
        "free": [],      # {"kind": "word"|"phrase", "value", "negated"}
        "tags": [],      # (value, negated)
        "folders": [],   # (value, negated)
        "dates": [],     # (key, mtime_ms, negated)
        "positive_free": 0,
    }
    index = 0
    length = len(text)
    while index < length:
        while index < length and text[index].isspace():
            index += 1
        if index >= length:
            break
        parsed["empty"] = False
        negated = False
        if (
            text[index] == "-"
            and index + 1 < length
            and not text[index + 1].isspace()
        ):
            negated = True
            parsed["negated"] = True
            index += 1
        if text[index] == '"':
            value, index = _read_quoted(text, index)
            parsed["free"].append({"kind": "phrase", "value": value, "negated": negated})
            parsed["phrase"] = True
            if not negated and value:
                parsed["positive_free"] += 1
            continue
        start = index
        while index < length and not text[index].isspace() and text[index] != '"':
            index += 1
        bare = text[start:index]
        key = ""
        value = bare
        colon = bare.find(":")
        if colon > 0:
            candidate = bare[:colon].lower()
            if candidate in SEARCH_FILTER_KEYS:
                key = candidate
                value = bare[colon + 1:]
        if key:
            if index < length and text[index] == '"':
                quoted, index = _read_quoted(text, index)
                value = value + quoted
        elif index < length and text[index] == '"':
            # A quote glued to a bare word: keep it as one free-text token.
            quoted, index = _read_quoted(text, index)
            value = bare + quoted
        if key:
            parsed["structured"] = True
            if key in ("tag", "folder"):
                parsed[key + "s"].append((value, negated))
            else:
                parsed["dates"].append((key, local_day_start_ms(value, key), negated))
            continue
        parsed["free"].append({"kind": "word", "value": value, "negated": negated})
        if not negated and value.strip('"*'):
            parsed["positive_free"] += 1
    parsed["plain"] = (
        not parsed["empty"]
        and not parsed["structured"]
        and not parsed["negated"]
        and not parsed["phrase"]
        and parsed["positive_free"] > 0
    )
    return parsed


def _search_term_expression(term: dict) -> str:
    value = str(term["value"]).replace('"', '""')
    return f'"{value}"' if term["kind"] == "phrase" else f'"{value}"*'


def _like_escape(value: str) -> str:
    return value.replace("\\", "\\\\").replace("%", "\\%").replace("_", "\\_")


def _folder_clause(value: str) -> tuple[str, list]:
    folder = str(value)
    if not folder:
        return "n.folder = ''", []
    return (
        "(n.folder = ? COLLATE NOCASE OR n.folder LIKE ? ESCAPE '\\')",
        [folder, _like_escape(folder) + "/%"],
    )


def _date_clause(key: str, mtime_ms: int) -> tuple[str, list]:
    if key == "before":
        return "n.mtime_ms < ?", [mtime_ms]
    return "n.mtime_ms >= ?", [mtime_ms]


def search_rows_filtered(conn: sqlite3.Connection, parsed: dict, limit: int) -> list:
    """Run an advanced search, using FTS only when positive free text exists."""
    clauses: list[str] = []
    params: list = []
    for value, negated in parsed["tags"]:
        expression = "EXISTS (SELECT 1 FROM tags t WHERE t.note_key=n.key AND t.tag_key=?)"
        clauses.append(f"NOT ({expression})" if negated else expression)
        params.append(tag_key(value))
    for value, negated in parsed["folders"]:
        expression, expression_params = _folder_clause(value)
        clauses.append(f"NOT ({expression})" if negated else expression)
        params.extend(expression_params)
    for key, mtime_ms, negated in parsed["dates"]:
        expression, expression_params = _date_clause(key, mtime_ms)
        clauses.append(f"NOT ({expression})" if negated else expression)
        params.extend(expression_params)
    for term in parsed["free"]:
        if not term["negated"] or not term["value"]:
            continue
        clauses.append(
            "n.key NOT IN (SELECT id FROM notes_fts WHERE notes_fts MATCH ?)"
        )
        params.append(_search_term_expression(term))

    positive_terms = [
        term for term in parsed["free"] if not term["negated"] and term["value"]
    ][:12]
    fts_expression = " AND ".join(_search_term_expression(term) for term in positive_terms)
    if not fts_expression and not clauses:
        # A query made only of empty/stripped tokens must not fall through to
        # an unfiltered listing of every note.
        return []
    where = " AND ".join(["n.trashed=0"] + clauses)
    try:
        if fts_expression:
            statement = (
                "SELECT n.id, n.title, "
                "snippet(notes_fts, 2, '⟪', '⟫', '…', 14) AS snip, "
                "n.folder, n.mtime_ms, n.key, n.pinned, n.size "
                "FROM notes_fts JOIN notes n ON n.key=notes_fts.id "
                f"WHERE notes_fts MATCH ? AND {where} "
                "ORDER BY bm25(notes_fts, 4.0, 1.0), n.mtime_ms DESC "
                "LIMIT ?"
            )
            values = [fts_expression] + params + [limit]
        else:
            statement = (
                "SELECT n.id, n.title, n.snippet AS snip, "
                "n.folder, n.mtime_ms, n.key, n.pinned, n.size "
                "FROM notes n "
                f"WHERE {where} "
                "ORDER BY n.pinned DESC, n.mtime_ms DESC, n.id "
                "LIMIT ?"
            )
            values = params + [limit]
        return conn.execute(statement, values).fetchall()
    except sqlite3.OperationalError as error:
        raise StoreError(f"search failed: {error}") from error


def search_rows(conn: sqlite3.Connection, query: str, limit: int) -> list:
    try:
        return conn.execute(
            """
            SELECT n.id, n.title,
                   snippet(notes_fts, 2, '⟪', '⟫', '…', 14) AS snip,
                   n.folder, n.mtime_ms, n.key, n.pinned, n.size
            FROM notes_fts JOIN notes n ON n.key=notes_fts.id
            WHERE notes_fts MATCH ? AND n.trashed=0
            ORDER BY bm25(notes_fts, 4.0, 1.0), n.mtime_ms DESC
            LIMIT ?
            """,
            (query, limit),
        ).fetchall()
    except sqlite3.OperationalError as error:
        raise StoreError(f"search failed: {error}") from error


def search_result(conn: sqlite3.Connection, row, fuzzy: bool) -> dict:
    identifier, title, snip, folder, mtime_ms, key, pinned, size = row
    tags = [
        entry[0]
        for entry in conn.execute(
            "SELECT tag FROM tags WHERE note_key=? ORDER BY tag COLLATE NOCASE", (key,)
        ).fetchall()
    ]
    result = {
        "id": str(identifier),
        "title": str(title),
        "snippet": " ".join(str(snip or "").split()),
        "folder": str(folder),
        "tags": tags,
        "modified": int(mtime_ms),
        "pinned": bool(pinned),
        "size": int(size),
    }
    if fuzzy:
        result["fuzzy"] = True
    return result


def command_titles(args) -> dict:
    ensure_store()
    limit = max(1, min(MAX_TITLES_LIMIT, int(args.limit)))
    with locked():
        conn = with_index()
        try:
            rows = conn.execute(
                """
                SELECT id,title,folder,mtime_ms,pinned
                FROM notes
                WHERE trashed=0 AND id NOT LIKE '.quill-%'
                ORDER BY pinned DESC, mtime_ms DESC, id
                LIMIT ?
                """,
                (limit,),
            ).fetchall()
        finally:
            conn.close()
    return {
        "notes": [
            {
                "id": str(identifier),
                "title": str(title),
                "folder": str(folder),
                "modified": int(mtime_ms),
                "pinned": bool(pinned),
            }
            for identifier, title, folder, mtime_ms, pinned in rows
        ]
    }


def saved_searches() -> list[dict]:
    state = read_state()
    raw = state.get("searches", [])
    output: list[dict] = []
    if not isinstance(raw, list):
        return output
    for entry in raw:
        if not isinstance(entry, dict):
            continue
        query = entry.get("query")
        if not isinstance(query, str) or not query:
            continue
        label = entry.get("label")
        if not isinstance(label, str) or not label.strip():
            label = query
        output.append({"query": query, "label": label})
    return output


def command_searches(args) -> dict:
    ensure_store()
    action = args.searches_action
    if action == "list":
        return {"searches": saved_searches()}
    query = str(args.query).strip()
    with locked():
        entries = saved_searches()
        if action == "add":
            if not query:
                raise StoreError("saved search cannot be empty")
            label = str(getattr(args, "label", "") or "").strip() or query
            for entry in entries:
                if entry["query"] == query:
                    entry["label"] = label
                    break
            else:
                if len(entries) >= MAX_SAVED_SEARCHES:
                    raise StoreError(f"too many saved searches (max {MAX_SAVED_SEARCHES})")
                entries.append({"query": query, "label": label})
            update_state(searches=entries)
        elif action == "remove":
            entries = [entry for entry in entries if entry["query"] != query]
            update_state(searches=entries)
    return {"searches": entries}


def command_settings(args) -> dict:
    """Read or replace the opaque UI settings object in state.json.

    `get` is deliberately read-only: it must not create the data root, so it
    skips `ensure_store()`/`locked()`. The store never interprets `ui`; the
    front end owns its shape and replaces the whole object on every `set`.
    """
    action = str(getattr(args, "settings_action", "") or "")
    if action == "get":
        ui = read_state().get("ui")
        return {"ui": ui if isinstance(ui, dict) else {}}
    if action != "set":
        raise StoreError(f"unknown settings action: {action}")

    raw_json = getattr(args, "settings_json", None)
    from_stdin = bool(getattr(args, "settings_stdin", False))
    if (raw_json is not None) == from_stdin:
        raise StoreError("choose exactly one of --json and --stdin")
    if from_stdin:
        raw = read_stdin(MAX_UI_SETTINGS_BYTES)
        if len(raw) > MAX_UI_SETTINGS_BYTES:
            raise StoreError("Settings are too large")
        try:
            text = raw.decode("utf-8")
        except UnicodeDecodeError as error:
            raise StoreError("Settings must be UTF-8 JSON") from error
    else:
        text = str(raw_json)
        if len(text.encode("utf-8")) > MAX_UI_SETTINGS_BYTES:
            raise StoreError("Settings are too large")

    try:
        settings = json.loads(text)
    except json.JSONDecodeError as error:
        raise StoreError(f"Settings must be a JSON object: {error.msg}") from error
    if not isinstance(settings, dict):
        raise StoreError("Settings must be a JSON object")
    for key in settings:
        if not isinstance(key, str) or not key:
            raise StoreError("Settings keys must be non-empty strings")
        if "\x00" in key:
            raise StoreError("Settings keys must not contain NUL")
        if len(key) > MAX_UI_SETTINGS_KEY_CHARS:
            raise StoreError(
                f"Settings keys must be at most {MAX_UI_SETTINGS_KEY_CHARS} characters"
            )
    serialized = json.dumps(settings, ensure_ascii=False).encode("utf-8")
    if len(serialized) > MAX_UI_SETTINGS_BYTES:
        raise StoreError("Settings are too large")

    with locked():
        update_state(ui=settings)
    return {"ui": settings}


def command_search(args) -> dict:
    ensure_store()
    parsed = parse_search_query(args.query)
    limit = max(1, min(MAX_SEARCH_LIMIT, int(args.limit)))
    with locked():
        conn = with_index()
        try:
            if parsed["empty"]:
                return {"results": [], "fuzzy": False}
            if not parsed["plain"]:
                rows = search_rows_filtered(conn, parsed, limit)
                return {
                    "results": [search_result(conn, row, False) for row in rows],
                    "fuzzy": False,
                }
            query = fts_query(args.query)
            if not query:
                return {"results": [], "fuzzy": False}
            results_rows = search_rows(conn, query, limit)
            exact_count = len(results_rows)
            fuzzy_used = False
            if exact_count < min(limit, FUZZY_TRIGGER):
                try:
                    fallback = fuzzy_query(args.query, conn)
                    if fallback and fallback != query:
                        seen = {row[0] for row in results_rows}
                        extras = [
                            row for row in search_rows(conn, fallback, limit) if row[0] not in seen
                        ]
                        extras = extras[: max(0, limit - len(results_rows))]
                        if extras:
                            results_rows = results_rows + extras
                            fuzzy_used = True
                except (sqlite3.DatabaseError, StoreError):
                    # The fallback is best-effort: keep the exact hits.
                    pass
            results = []
            for index, row in enumerate(results_rows):
                results.append(search_result(conn, row, fuzzy_used and index >= exact_count))
        finally:
            conn.close()
    return {"results": results, "fuzzy": fuzzy_used}


def command_tags(_args) -> dict:
    ensure_store()
    with locked():
        conn = with_index()
        try:
            rows = conn.execute(
                """
                SELECT t.tag, COUNT(*) AS n
                FROM tags t JOIN notes n ON n.key=t.note_key
                WHERE n.trashed=0
                GROUP BY t.tag_key
                ORDER BY n DESC, t.tag COLLATE NOCASE
                """
            ).fetchall()
        finally:
            conn.close()
    return {"tags": [{"tag": str(tag), "count": int(count)} for tag, count in rows]}


def plan_tag_add(identifier: str, path: Path, requested: list[str]) -> dict:
    """Plan one tag-add without writing (so a batch is all-or-nothing)."""
    try:
        previous_raw = path.read_bytes()
    except OSError as error:
        raise StoreError(f"could not read the note: {error}") from error
    try:
        content = previous_raw.decode("utf-8")
    except UnicodeDecodeError as error:
        raise StoreError("note is not valid UTF-8") from error
    present = {tag.casefold() for tag in note_tags(content)}
    missing: list[str] = []
    for tag in requested:
        key = tag.casefold()
        if key in present:
            continue
        present.add(key)
        missing.append(tag)
        if len(missing) >= 20:
            break
    # Tags appended inside an open fence would be invisible to
    # `extract_inline_tags`, so refuse rather than silently losing them.
    # A request whose tags are all present still succeeds as a no-op.
    if missing and has_unclosed_fence(content):
        raise StoreError("cannot add tags while a fenced code block is open")
    return {
        "id": identifier,
        "path": path,
        "previous": previous_raw,
        "content": append_inline_tags(content, missing),
    }


def command_tag_add(args) -> dict:
    ensure_store()
    targets = batch_targets(args)
    requested = normalize_tags(getattr(args, "tags", []) or [])
    with locked():
        plans = [
            plan_tag_add(identifier, path, requested)
            for identifier, path in targets
        ]
        updated = 0
        draft_deleted = False
        for index, plan in enumerate(plans):
            changed, consumed_draft = apply_note_content(
                plan["id"], plan["path"], plan["previous"], plan["content"], "tag-add"
            )
            if changed:
                updated += 1
                prune_versions(plan["id"])
            if index == 0:
                draft_deleted = consumed_draft
        if updated:
            sync_index_once()
        first = plans[0]
        stat = first["path"].stat()
    return {
        "id": first["id"],
        "tags": note_tags(first["content"]),
        "content": first["content"],
        "modified": int(stat.st_mtime * 1000),
        "draftDeleted": draft_deleted,
        "ids": [plan["id"] for plan in plans],
        "updated": updated,
    }


def replace_inline_tag(line: str, old_key: str, new_tag: str) -> tuple[str, int]:
    pieces: list[tuple[int, int]] = []
    cursor = 0
    for match in INLINE_CODE_RE.finditer(line):
        pieces.append((cursor, match.start()))
        cursor = match.end()
    pieces.append((cursor, len(line)))
    protected = protected_spans(line)
    changes = 0
    output = line
    # Right-to-left keeps earlier offsets valid.
    spans = []
    for start, end in pieces:
        for match in TAG_RE.finditer(line, start, end):
            if tag_key(match.group(1)) == old_key and not overlaps(match.span(), protected):
                spans.append(match.span(1))
    for start, end in reversed(spans):
        output = output[:start] + new_tag + output[end:]
        changes += 1
    return output, changes


def rewrite_tags(content: str, old: str, new: str) -> tuple[str, int]:
    old_key = tag_key(old)
    if not old_key:
        # Every tag whose characters all normalize away (for example 日本語)
        # shares the "" key; treating that as a match would rewrite all of them.
        raise StoreError("cannot rewrite tags: old tag has no comparable characters")
    newline = detect_newline(content)
    lines = content.splitlines(keepends=True)
    changes = 0
    # Frontmatter (inline or block list forms). Track the current YAML key
    # while scanning so `- item` lines under `aliases:`, `categories:` or any
    # other key are never rewritten.
    if lines and lines[0].strip() == "---":
        closing = None
        for index in range(1, min(len(lines), 400)):
            if lines[index].strip() == "---":
                closing = index
                break
        if closing is not None:
            current_key = None
            current_indent = -1
            for index in range(1, closing):
                line = lines[index]
                body = line.rstrip("\r\n")
                if body.strip() == "" or body.lstrip().startswith("#"):
                    continue
                key_match = re.match(
                    r"^(\s*)([^\s:#\-][^:]*?)\s*:\s*(.*)$", body)
                if key_match:
                    key_indent = len(key_match.group(1))
                    key_name = key_match.group(2).strip().lower()
                    rest = key_match.group(3)
                    current_key = key_name if key_name == "tags" and not rest.strip() else None
                    current_indent = key_indent
                    if key_name != "tags":
                        continue
                    if rest.strip().startswith("["):
                        inner = rest.strip()[1:-1] if rest.strip().endswith("]") else rest.strip()[1:]
                        values = [value.strip().strip("'\"") for value in inner.split(",")]
                        next_values = [
                            new if tag_key(value) == old_key else value
                            for value in values
                        ]
                        changes += sum(
                            1
                            for before, after in zip(values, next_values)
                            if before != after
                        )
                        lines[index] = (
                            body[:key_match.start(3)]
                            + "[" + ", ".join(next_values) + "]"
                            + (line[len(body):] or "")
                        )
                    elif rest.strip() and tag_key(rest) == old_key:
                        lines[index] = (
                            body[:key_match.start(3)] + new + (line[len(body):] or "")
                        )
                        changes += 1
                    continue
                item = re.match(r"^(\s*)-\s*(.+?)\s*$", body)
                if (item and current_key == "tags"
                        and len(item.group(1)) >= current_indent
                        and tag_key(item.group(2).strip().strip("'\"")) == old_key):
                    lines[index] = (
                        item.group(1) + "- " + new + (line[len(body):] or "")
                    )
                    changes += 1
                elif item is None and not body.lstrip().startswith("-"):
                    # Unknown non-list content (a nested mapping value, ...):
                    # stop treating following items as tag entries.
                    current_key = None
            content = "".join(lines)
    # Inline tags outside frontmatter and code.
    frontmatter, body = split_frontmatter(content)
    in_code = False
    output_lines = []
    for line in body.splitlines(keepends=True):
        bare = line.rstrip("\r\n")
        ending = line[len(bare) :]
        if FENCE_RE.match(bare):
            in_code = not in_code
            output_lines.append(line)
            continue
        if in_code:
            output_lines.append(line)
            continue
        replaced, count = replace_inline_tag(bare, old_key, new)
        changes += count
        output_lines.append(replaced + ending)
    body = "".join(output_lines)
    if frontmatter is not None:
        # Rebuild with the original fences.
        return "---" + newline + frontmatter + "---" + newline + body, changes
    return body, changes


def remove_frontmatter_tags(frontmatter: str, keys: set[str]) -> tuple[str, int]:
    """Drop matching entries from `tags:` in frontmatter, both YAML forms."""
    lines = frontmatter.splitlines(keepends=True)
    output: list[str] = []
    changes = 0
    index = 0
    while index < len(lines):
        line = lines[index]
        body = line.rstrip("\r\n")
        ending = line[len(body):]
        key_match = re.match(r"^(\s*)([^\s:#\-][^:]*?)\s*:\s*(.*)$", body)
        if key_match is None or key_match.group(2).strip().lower() != "tags":
            output.append(line)
            index += 1
            continue
        rest = key_match.group(3)
        stripped = rest.strip()
        if stripped.startswith("["):
            closing = stripped.find("]")
            if closing == -1:
                output.append(line)
                index += 1
                continue
            inner = stripped[1:closing]
            tail = stripped[closing + 1:]
            items = [part.strip() for part in inner.split(",")]
            kept: list[str] = []
            for item in items:
                value = item.strip().strip("'\"").strip()
                if not value:
                    continue
                if tag_key(value) in keys:
                    changes += 1
                    continue
                kept.append(item)
            prefix = body[:key_match.start(3)]
            replacement = "[" + ", ".join(kept) + "]"
            if tail:
                replacement += tail if tail.startswith(" ") else " " + tail
            output.append(prefix + replacement + ending)
            index += 1
            continue
        if stripped and tag_key(stripped.strip("'\"").strip()) in keys:
            # A scalar `tags: alpha` line loses the whole key when it matches.
            changes += 1
            index += 1
            continue
        if stripped:
            # A non-matching scalar tag: leave the line and its siblings alone.
            output.append(line)
            index += 1
            continue
        # `tags:` with an empty value starts a block list.
        output.append(line)
        index += 1
        key_indent = len(key_match.group(1))
        while index < len(lines):
            follow = lines[index]
            follow_body = follow.rstrip("\r\n")
            item = re.match(r"^(\s*)-\s*(.+?)\s*$", follow_body)
            if item is None or len(item.group(1)) < key_indent:
                break
            value = item.group(2).strip().strip("'\"").strip()
            if tag_key(value) in keys:
                changes += 1
                index += 1
                continue
            output.append(follow)
            index += 1
    return "".join(output), changes


def remove_inline_tags_from_line(line: str, keys: set[str]) -> tuple[str, int]:
    """Remove matching `#tag` tokens outside code/URLs and tidy the gap.

    One adjacent whitespace run is swallowed so `hello #tag world` becomes
    `hello world` and `hello #tag` becomes `hello`.
    """
    blocked = [match.span() for match in INLINE_CODE_RE.finditer(line)]
    blocked.extend(protected_spans(line))
    output: list[str] = []
    cursor = 0
    retained = False
    changes = 0
    for match in TAG_RE.finditer(line):
        if tag_key(match.group(1)) not in keys:
            continue
        if overlaps(match.span(), blocked):
            continue
        chunk = line[cursor:match.start()]
        output.append(chunk)
        if (chunk and chunk[-1] in " \t"
                and (retained or chunk[:-1].strip(" \t"))):
            output[-1] = chunk[:-1]
            cursor = match.end()
        else:
            cursor = match.end()
            if cursor < len(line) and line[cursor] in " \t":
                cursor += 1
        if any(character not in " \t" for character in chunk):
            retained = True
        changes += 1
    output.append(line[cursor:])
    return "".join(output), changes


def remove_inline_tags(text: str, keys: set[str]) -> tuple[str, int]:
    """Remove inline tags from a body, skipping fenced code blocks."""
    in_code = False
    output: list[str] = []
    changes = 0
    for line in text.splitlines(keepends=True):
        bare = line.rstrip("\r\n")
        ending = line[len(bare):]
        if FENCE_RE.match(bare):
            in_code = not in_code
            output.append(line)
            continue
        if in_code:
            output.append(line)
            continue
        replaced, count = remove_inline_tags_from_line(bare, keys)
        changes += count
        output.append(replaced + ending)
    return "".join(output), changes


def remove_tags(content: str, keys: set[str]) -> tuple[str, int]:
    """Remove tags from frontmatter and inline text; never edit code or URLs."""
    if not keys:
        return content, 0
    newline = detect_newline(content)
    frontmatter, body = split_frontmatter(content)
    changes = 0
    if frontmatter is not None:
        frontmatter, frontmatter_changes = remove_frontmatter_tags(frontmatter, keys)
        changes += frontmatter_changes
        body, body_changes = remove_inline_tags(body, keys)
        changes += body_changes
        return "---" + newline + frontmatter + "---" + newline + body, changes
    body, changes = remove_inline_tags(body, keys)
    return body, changes


def dedupe_frontmatter_tags(frontmatter: str) -> tuple[str, int]:
    """Drop repeated entries from `tags:` in frontmatter, keeping the first.

    Both YAML forms are handled: a flow list (`tags: [a, b, a]`) and a block
    list (`tags:` followed by `- a` lines). Survivors keep their on-disk order
    and formatting; only the duplicate entries are removed.
    """
    lines = frontmatter.splitlines(keepends=True)
    output: list[str] = []
    changes = 0
    index = 0
    while index < len(lines):
        line = lines[index]
        body = line.rstrip("\r\n")
        ending = line[len(body):]
        key_match = re.match(r"^(\s*)([^\s:#\-][^:]*?)\s*:\s*(.*)$", body)
        if key_match is None or key_match.group(2).strip().lower() != "tags":
            output.append(line)
            index += 1
            continue
        rest = key_match.group(3)
        stripped = rest.strip()
        if stripped.startswith("["):
            closing = stripped.find("]")
            if closing == -1:
                output.append(line)
                index += 1
                continue
            inner = stripped[1:closing]
            tail = stripped[closing + 1:]
            seen: set[str] = set()
            kept: list[str] = []
            for item in [part.strip() for part in inner.split(",")]:
                value = item.strip().strip("'\"").strip()
                if not value:
                    continue
                key = tag_key(value)
                if key and key in seen:
                    changes += 1
                    continue
                if key:
                    seen.add(key)
                kept.append(item)
            prefix = body[:key_match.start(3)]
            replacement = "[" + ", ".join(kept) + "]"
            if tail:
                replacement += tail if tail.startswith(" ") else " " + tail
            output.append(prefix + replacement + ending)
            index += 1
            continue
        if stripped:
            # A scalar `tags: alpha` cannot contain a duplicate.
            output.append(line)
            index += 1
            continue
        # Empty value: a block list follows. Duplicate item lines are dropped.
        output.append(line)
        index += 1
        key_indent = len(key_match.group(1))
        seen = set()
        while index < len(lines):
            follow = lines[index]
            follow_body = follow.rstrip("\r\n")
            item = re.match(r"^(\s*)-\s*(.+?)\s*$", follow_body)
            if item is None or len(item.group(1)) < key_indent:
                break
            value = item.group(2).strip().strip("'\"").strip()
            key = tag_key(value)
            if key and key in seen:
                changes += 1
                index += 1
                continue
            if key:
                seen.add(key)
            output.append(follow)
            index += 1
    return "".join(output), changes


def dedupe_inline_tags_from_line(line: str) -> tuple[str, int]:
    """Drop repeated `#tag` tokens within one line, keeping the first.

    Inline code, fenced code (handled by the caller), URLs and Markdown link
    destinations are never touched. One adjacent whitespace run is collapsed
    on removal, matching `tag-remove`.
    """
    blocked = [match.span() for match in INLINE_CODE_RE.finditer(line)]
    blocked.extend(protected_spans(line))
    seen: set[str] = set()
    output: list[str] = []
    cursor = 0
    retained = False
    changes = 0
    for match in TAG_RE.finditer(line):
        if overlaps(match.span(), blocked):
            continue
        key = tag_key(match.group(1))
        if not key:
            continue
        if key not in seen:
            seen.add(key)
            continue
        chunk = line[cursor:match.start()]
        output.append(chunk)
        if (chunk and chunk[-1] in " \t"
                and (retained or chunk[:-1].strip(" \t"))):
            output[-1] = chunk[:-1]
            cursor = match.end()
        else:
            cursor = match.end()
            if cursor < len(line) and line[cursor] in " \t":
                cursor += 1
        if any(character not in " \t" for character in chunk):
            retained = True
        changes += 1
    output.append(line[cursor:])
    return "".join(output), changes


def dedupe_inline_tags(text: str) -> tuple[str, int]:
    """Drop duplicate inline tags from a body, skipping fenced code blocks."""
    in_code = False
    output: list[str] = []
    changes = 0
    for line in text.splitlines(keepends=True):
        bare = line.rstrip("\r\n")
        ending = line[len(bare):]
        if FENCE_RE.match(bare):
            in_code = not in_code
            output.append(line)
            continue
        if in_code:
            output.append(line)
            continue
        replaced, count = dedupe_inline_tags_from_line(bare)
        changes += count
        output.append(replaced + ending)
    return "".join(output), changes


def dedupe_tags(content: str) -> tuple[str, int]:
    """Remove duplicate tag entries in frontmatter and on each inline line."""
    newline = detect_newline(content)
    frontmatter, body = split_frontmatter(content)
    changes = 0
    if frontmatter is not None:
        frontmatter, frontmatter_changes = dedupe_frontmatter_tags(frontmatter)
        changes += frontmatter_changes
        body, body_changes = dedupe_inline_tags(body)
        changes += body_changes
        return "---" + newline + frontmatter + "---" + newline + body, changes
    body, changes = dedupe_inline_tags(body)
    return body, changes


def delete_tag_everywhere(tag) -> dict:
    """Remove one normalised tag from every live note and resync the index."""
    raw = str(tag or "").strip().lstrip("#")
    if not raw:
        raise StoreError("tag is empty")
    key = tag_key(raw)
    if not key:
        raise StoreError(
            f"cannot delete {raw!r}: it has no comparable characters "
            "(tags that normalize to an empty key would all match)")
    display = normalize_tags([raw])
    if not display:
        raise StoreError("tag is empty")
    tag = display[0]
    updated = 0
    snapshotted: list[str] = []
    with locked():
        for path in list(NOTES.rglob("*.md")):
            if not path.is_file():
                continue
            try:
                previous_raw = path.read_bytes()
            except OSError:
                continue
            try:
                content = previous_raw.decode("utf-8")
            except UnicodeDecodeError:
                # Rewriting this note would replace its invalid bytes.
                continue
            updated_content, changes = remove_tags(content, {key})
            if not changes:
                continue
            updated_bytes = updated_content.encode("utf-8")
            if updated_bytes == previous_raw:
                continue
            identifier = path.relative_to(NOTES).as_posix()
            snapshot_note(identifier, previous_raw, "tag-delete", destructive=True)
            atomic_write(path, updated_bytes)
            snapshotted.append(identifier)
            updated += 1
        conn = index_connect()
        try:
            sync_index(conn, full=True)
        finally:
            conn.close()
        for identifier in snapshotted:
            prune_versions(identifier)
    # ids let a UI reload an open buffer without waiting for the file watcher.
    return {"tag": display[0], "updated": updated, "ids": snapshotted}


def plan_tag_remove(identifier: str, path: Path, keys: set[str]) -> dict:
    """Plan one tag-remove without writing (so a batch is all-or-nothing)."""
    try:
        previous_raw = path.read_bytes()
    except OSError as error:
        raise StoreError(f"could not read the note: {error}") from error
    try:
        content = previous_raw.decode("utf-8")
    except UnicodeDecodeError as error:
        raise StoreError("note is not valid UTF-8") from error
    # No unclosed-fence refusal: anything inside a fence is protected and is
    # skipped, so removal is always unambiguous (and best-effort).
    updated_content, _changes = remove_tags(content, keys)
    return {
        "id": identifier,
        "path": path,
        "previous": previous_raw,
        "content": updated_content,
    }


def command_tag_remove(args) -> dict:
    ensure_store()
    targets = batch_targets(args)
    requested = normalize_tags(getattr(args, "tags", []) or [])
    keys = {tag_key(tag) for tag in requested}
    keys.discard("")
    with locked():
        plans = [
            plan_tag_remove(identifier, path, keys)
            for identifier, path in targets
        ]
        updated = 0
        draft_deleted = False
        for index, plan in enumerate(plans):
            changed, consumed_draft = apply_note_content(
                plan["id"], plan["path"], plan["previous"], plan["content"], "tag-remove"
            )
            if changed:
                updated += 1
                prune_versions(plan["id"])
            if index == 0:
                draft_deleted = consumed_draft
        if updated:
            sync_index_once()
        first = plans[0]
        stat = first["path"].stat()
    return {
        "id": first["id"],
        "tags": note_tags(first["content"]),
        "content": first["content"],
        "modified": int(stat.st_mtime * 1000),
        "draftDeleted": draft_deleted,
        "ids": [plan["id"] for plan in plans],
        "updated": updated,
    }


def command_tag_rename(args) -> dict:
    ensure_store()
    old = str(args.old or "").strip().lstrip("#")
    new = normalize_tags([args.new])
    if not old:
        raise StoreError("old tag is empty")
    if not tag_key(old):
        raise StoreError(
            f"cannot rename {old!r}: it has no comparable characters "
            "(tags that normalize to an empty key would all match)")
    if not new:
        raise StoreError("new tag is empty")
    new = new[0]
    new_key = tag_key(new)
    updated = 0
    merged = False
    snapshotted: list[str] = []
    with locked():
        for path in list(NOTES.rglob("*.md")):
            if not path.is_file():
                continue
            try:
                previous_raw = path.read_bytes()
            except OSError:
                continue
            try:
                content = previous_raw.decode("utf-8")
            except UnicodeDecodeError:
                # Rewriting this note would replace its invalid bytes.
                continue
            # `merged` is true when the destination tag already existed
            # anywhere, because then the rename merges two tags into one.
            if any(tag_key(tag) == new_key for tag in note_tags(content)):
                merged = True
            updated_content, changes = rewrite_tags(content, old, new)
            if changes:
                # Renaming onto an existing tag can leave the destination tag
                # twice in one note; keep the first entry everywhere.
                updated_content, _deduped = dedupe_tags(updated_content)
                identifier = path.relative_to(NOTES).as_posix()
                updated_bytes = updated_content.encode("utf-8")
                if updated_bytes != previous_raw:
                    snapshot_note(identifier, previous_raw, "tag-rename", destructive=True)
                atomic_write(path, updated_bytes)
                snapshotted.append(identifier)
                updated += 1
        conn = index_connect()
        try:
            sync_index(conn, full=True)
        finally:
            conn.close()
        for identifier in snapshotted:
            prune_versions(identifier)
    return {
        "tag": new,
        "from": old,
        "updated": updated,
        "merged": merged,
        "ids": snapshotted,
    }


def command_tag_delete(args) -> dict:
    return delete_tag_everywhere(getattr(args, "tag", ""))


def command_backlinks(args) -> dict:
    ensure_store()
    identifier = safe_relative(args.id)
    with locked():
        conn = with_index()
        try:
            rows = conn.execute(
                """
                SELECT n.id, n.title, n.snippet
                FROM links l JOIN notes n ON n.key=l.src_key
                WHERE l.resolved_id=? AND n.trashed=0 AND n.id<>?
                GROUP BY n.id
                ORDER BY n.mtime_ms DESC
                """,
                (identifier, identifier),
            ).fetchall()
        finally:
            conn.close()
    return {
        "backlinks": [
            {"id": str(identifier), "title": str(title), "snippet": str(snippet)}
            for identifier, title, snippet in rows
        ]
    }


def command_unresolved(args) -> dict:
    ensure_store()
    identifier = None
    raw_id = getattr(args, "id", None)
    if raw_id:
        identifier = safe_relative(raw_id)
    try:
        limit = int(getattr(args, "limit", 500))
    except (TypeError, ValueError):
        limit = 500
    limit = max(1, limit)
    with locked():
        conn = with_index()
        try:
            params: list = []
            filter_sql = ""
            if identifier is not None:
                filter_sql = " AND l.src_id=?"
                params.append(identifier)
            params.append(limit)
            rows = conn.execute(
                f"""
                SELECT l.src_id, n.title, l.target, COUNT(*) AS n
                FROM links l JOIN notes n ON n.key=l.src_key
                WHERE l.resolved_id IS NULL
                  AND n.trashed=0
                  AND n.id NOT LIKE '.quill-%'
                  {filter_sql}
                GROUP BY l.src_id, l.target COLLATE NOCASE
                ORDER BY l.src_id COLLATE NOCASE, l.target COLLATE NOCASE
                LIMIT ?
                """,
                params,
            ).fetchall()
        finally:
            conn.close()
    unresolved = [
        {
            "source": str(source),
            "sourceTitle": str(title),
            "target": str(target),
            "count": int(count),
        }
        for source, title, target, count in rows
    ]
    return {
        "unresolved": unresolved,
        "total": sum(entry["count"] for entry in unresolved),
        "sources": len({entry["source"] for entry in unresolved}),
    }


TITLE_ROWS_SQL = (
    "SELECT id,title,stem FROM notes WHERE trashed=0 ORDER BY pinned DESC, mtime_ms DESC, id"
)


def titles_from_rows(rows) -> tuple[dict[str, str], dict[str, str]]:
    by_title: dict[str, str] = {}
    by_stem: dict[str, str] = {}
    for identifier, title, stem in rows:
        by_title.setdefault(link_key(title), str(identifier))
        by_stem.setdefault(link_key(stem), str(identifier))
    return by_title, by_stem


def lookup_titles(conn: sqlite3.Connection) -> tuple[dict[str, str], dict[str, str]]:
    rows = conn.execute(TITLE_ROWS_SQL).fetchall()
    return titles_from_rows(rows)


def lookup_titles_readonly() -> tuple[dict[str, str], dict[str, str]]:
    """Read link targets from an existing index without touching the store.

    Previewing unsaved buffer text must not rebuild the index, take the write
    lock, or sweep the notes directory: this runs on every keystroke. A
    missing, unreadable, or old-schema index is not an error; links simply
    render as ``quill://missing`` until the next real sync.
    """
    if not INDEX.is_file():
        return {}, {}
    uri = f"file:{urllib.parse.quote(str(INDEX), safe='/')}?mode=ro"
    try:
        conn = sqlite3.connect(uri, uri=True, timeout=2)
    except sqlite3.Error:
        return {}, {}
    try:
        version = int(conn.execute("PRAGMA user_version").fetchone()[0])
        if version != SCHEMA_VERSION:
            return {}, {}
        return lookup_titles(conn)
    except (sqlite3.Error, TypeError, ValueError):
        return {}, {}
    finally:
        conn.close()


def transform_line(line: str, by_title: dict[str, str], by_stem: dict[str, str]) -> str:
    def wiki(match: re.Match) -> str:
        raw = match.group(1)
        target_part, _, alias = raw.partition("|")
        target_part = target_part.strip()
        if "#" in target_part:
            target_part = target_part.split("#", 1)[0].strip()
        if not target_part:
            return match.group(0)
        label = alias.strip() or target_part
        norm = link_key(target_part)
        resolved = by_title.get(norm) or by_stem.get(norm)
        if resolved:
            url = "quill://note/" + urllib.parse.quote(resolved, safe="/")
        else:
            url = "quill://missing/" + urllib.parse.quote(target_part, safe="")
        return f"[{label}]({url})"

    def tag(match: re.Match) -> str:
        value = match.group(1)
        return f"[#{value}](quill://tag/{urllib.parse.quote(value, safe='')})"

    # Protect ordinary Markdown links and bare URLs so a `#fragment` in a
    # URL is never mistaken for an inline tag.
    protected: list[str] = []

    def stash(match: re.Match) -> str:
        protected.append(match.group(0))
        return f"\x00{len(protected) - 1}\x00"

    output = re.sub(r"\[[^\]\n]+\]\([^\s()\n]+\)|https?://[^\s<>()]+", stash, line)
    output = WIKI_RE.sub(wiki, output)
    output = TAG_RE.sub(tag, output)
    if protected:
        output = re.sub(
            r"\x00(\d+)\x00",
            lambda match: protected[int(match.group(1))],
            output,
        )
    return output


def render_preview(
    content: str,
    by_title: dict[str, str],
    by_stem: dict[str, str],
    too_large: bool = False,
) -> dict:
    """Render note text for the preview pane.

    Shared by the on-disk note path and the editor-buffer path so both rewrite
    links identically. ``too_large`` short-circuits before any parsing; callers
    measure the raw bytes because decoding may replace invalid sequences.
    """
    if too_large:
        return {"markdown": "", "tooLarge": True, "lineOffset": 0}
    frontmatter, body = split_frontmatter(content)
    # Preview lines are body-relative; tell the UI how many file lines the
    # stripped frontmatter occupied so image resize edits the right line.
    line_offset = content.count("\n", 0, len(content) - len(body))
    output: list[str] = []
    in_code = False
    for line in body.splitlines():
        if FENCE_RE.match(line):
            in_code = not in_code
            output.append(line)
            continue
        if in_code:
            output.append(line)
            continue
        segments: list[tuple[int, int, bool]] = []
        cursor = 0
        for match in INLINE_CODE_RE.finditer(line):
            if match.start() > cursor:
                segments.append((cursor, match.start(), False))
            segments.append((match.start(), match.end(), True))
            cursor = match.end()
        if cursor < len(line):
            segments.append((cursor, len(line), False))
        rendered = ""
        for start, end, is_code in segments:
            segment = line[start:end]
            rendered += segment if is_code else transform_line(segment, by_title, by_stem)
        output.append(rendered)
    markdown = "\n".join(output)
    return {"markdown": markdown, "tooLarge": False, "lineOffset": line_offset}


def command_preview(args) -> dict:
    identifier = getattr(args, "id", None)
    content_file = getattr(args, "content_file", None)
    from_stdin = bool(getattr(args, "stdin", False))
    if sum((identifier is not None, content_file is not None, from_stdin)) != 1:
        raise StoreError("choose exactly one of <id>, --content-file, --stdin")
    trashed = bool(getattr(args, "trashed", False))

    if identifier is not None:
        ensure_store()
        path = note_path(identifier, trashed=trashed)
        if not path.is_file():
            raise StoreError(f"note not found: {identifier}")
        payload = read_note_bytes(path)
        with locked():
            conn = index_connect()
            try:
                sync_index(conn)
                by_title, by_stem = lookup_titles(conn)
            finally:
                conn.close()
    else:
        if trashed:
            raise StoreError("--trashed requires a note id")
        if content_file is not None:
            try:
                payload = read_note_bytes(Path(content_file).expanduser())
            except OSError as error:
                raise StoreError(
                    f"cannot read content file: {content_file}: {error}"
                ) from error
        else:
            payload = read_stdin(MAX_NOTE_BYTES)
        # Buffer preview is deliberately sync-free: no index mutation, no
        # write lock, and no note stat/read.
        by_title, by_stem = lookup_titles_readonly()

    too_large = len(payload) > MAX_NOTE_BYTES
    content = "" if too_large else payload.decode("utf-8", errors="replace")
    return render_preview(content, by_title, by_stem, too_large=too_large)


def command_import(args) -> dict:
    ensure_store()
    source = Path(
        os.path.expanduser(os.environ.get("OMANANO_DATA_DIR") or "~/.local/share/omanano")
    ).resolve()
    source_notes = source / "notes"
    imported = 0
    skipped = 0
    imported_ids: list[str] = []
    if source_notes.is_dir():
        with locked():
            for path in source_notes.rglob("*.md"):
                if not path.is_file():
                    continue
                relative = path.relative_to(source_notes)
                target = NOTES / relative
                if target.exists():
                    skipped += 1
                    continue
                target.parent.mkdir(parents=True, exist_ok=True)
                shutil.copy2(path, target)
                imported += 1
                imported_ids.append(relative.as_posix())
            if imported_ids:
                source_state = read_json(source / "state.json", {"pinned": []})
                source_pins = set(source_state.get("pinned", []) if isinstance(source_state, dict) else [])
                if source_pins:
                    pins = pinned_set()
                    existing = {path.relative_to(NOTES).as_posix() for path in NOTES.rglob("*.md")}
                    pins.update(value for value in source_pins if value in existing)
                    save_pinned(pins)
            conn = index_connect()
            try:
                sync_index(conn, full=True)
            finally:
                conn.close()
    return {"imported": imported, "skipped": skipped, "ids": imported_ids}


def command_index(args) -> dict:
    ensure_store()
    with locked():
        if args.rebuild:
            for suffix in ("", "-wal", "-shm"):
                with contextlib.suppress(OSError):
                    os.unlink(str(INDEX) + suffix)
        conn = index_connect()
        try:
            sync_index(conn, full=bool(args.rebuild))
            notes = int(conn.execute("SELECT COUNT(*) FROM notes WHERE trashed=0").fetchone()[0])
            trashed = int(conn.execute("SELECT COUNT(*) FROM notes WHERE trashed=1").fetchone()[0])
            links = int(conn.execute("SELECT COUNT(*) FROM links").fetchone()[0])
        finally:
            conn.close()
    return {"notes": notes, "trashed": trashed, "links": links, "rebuilt": bool(args.rebuild)}


def command_attachment_save(args) -> dict:
    ensure_store()
    source: Path | None = None
    raw_file = getattr(args, "file", None)
    if raw_file:
        source = Path(os.path.expanduser(raw_file))
        try:
            info = source.stat()
        except FileNotFoundError:
            raise StoreError(f"file not found: {raw_file}") from None
        except OSError as error:
            raise StoreError(f"cannot read file {raw_file}: {error}") from None
        if stat.S_ISDIR(info.st_mode):
            raise StoreError(f"not a file: {raw_file} (directory)")
        if not stat.S_ISREG(info.st_mode):
            raise StoreError(f"not a regular file: {raw_file}")
        if info.st_size > MAX_ATTACHMENT_BYTES:
            raise StoreError("file is larger than 20 MiB")
        try:
            with source.open("rb") as handle:
                payload = handle.read(MAX_ATTACHMENT_BYTES + 1)
        except FileNotFoundError:
            raise StoreError(f"file not found: {raw_file}") from None
        except IsADirectoryError:
            raise StoreError(f"not a file: {raw_file} (directory)") from None
        except OSError as error:
            raise StoreError(f"cannot read file {raw_file}: {error}") from None
    else:
        payload = read_stdin(MAX_ATTACHMENT_BYTES)

    if not payload:
        raise StoreError("file is empty")
    if len(payload) > MAX_ATTACHMENT_BYTES:
        raise StoreError("file is larger than 20 MiB")

    image = sniff_image(payload)
    if image is not None:
        extension, mime = image
        kind = "image"
    else:
        extension = attachment_extension(source.name if source else "")
        kind = "file"

    digest = hashlib.sha256(payload).hexdigest()
    name = f"{digest}.{extension}"
    if kind == "file":
        mime = mimetypes.guess_type(name)[0] or "application/octet-stream"
    default_alt = "image" if kind == "image" else (source.stem if source else "file")
    alt = attachment_alt(getattr(args, "name", "") or "", default_alt)

    with locked():
        directory = attachments_dir()
        target = directory / name
        deduped = (
            target.is_file()
            and not target.is_symlink()
            and target.stat().st_size == len(payload)
        )
        if not deduped:
            atomic_write(target, payload)
            with contextlib.suppress(OSError):
                os.chmod(target, 0o644)

    markdown = (
        attachment_markdown(alt, target)
        if kind == "image"
        else attachment_link(alt, target)
    )
    return {
        "id": digest,
        "path": str(target),
        "markdown": markdown,
        "kind": kind,
        "name": name,
        "size": len(payload),
        "mime": mime,
        "deduped": bool(deduped),
    }


def command_attachment_list(_args) -> dict:
    ensure_store()
    with locked():
        referenced = referenced_attachment_names()
        files = []
        for path in attachment_files():
            try:
                stat = path.stat(follow_symlinks=False)
            except OSError:
                continue
            files.append(
                {
                    "path": str(path),
                    "size": int(stat.st_size),
                    "mtime": int(stat.st_mtime * 1000),
                    "referenced": path.name in referenced,
                }
            )
    return {"attachments": files}


def command_attachment_gc(args) -> dict:
    ensure_store()
    dry_run = bool(getattr(args, "dry_run", False))
    removed = 0
    freed = 0
    kept = 0
    with locked():
        referenced = referenced_attachment_names()
        for path in attachment_files():
            if path.name in referenced:
                kept += 1
                continue
            try:
                size = int(path.stat(follow_symlinks=False).st_size)
            except OSError:
                kept += 1
                continue
            if dry_run:
                removed += 1
                freed += size
                continue
            try:
                path.unlink()
            except OSError:
                kept += 1
                continue
            removed += 1
            freed += size
    return {"removed": removed, "freed": freed, "kept": kept, "dryRun": dry_run}


def command_stats(_args) -> dict:
    ensure_store()
    notes = 0
    trashed = 0
    total_bytes = 0
    folders = 0
    with locked():
        conn = with_index()
        try:
            notes = int(conn.execute("SELECT COUNT(*) FROM notes WHERE trashed=0").fetchone()[0])
            trashed = int(conn.execute("SELECT COUNT(*) FROM notes WHERE trashed=1").fetchone()[0])
            total_bytes = int(conn.execute("SELECT COALESCE(SUM(size),0) FROM notes").fetchone()[0])
            tags = int(conn.execute("SELECT COUNT(DISTINCT tag_key) FROM tags").fetchone()[0])
        finally:
            conn.close()
        if NOTES.exists():
            folders = sum(1 for path in NOTES.rglob("*") if path.is_dir())
    return {
        "notes": notes,
        "trashed": trashed,
        "folders": folders,
        "tags": tags,
        "bytes": total_bytes,
        "dataRoot": str(ROOT),
        "attachments": len(attachment_files()),
        "indexBytes": INDEX.stat().st_size if INDEX.exists() else 0,
    }


# --------------------------------------------------------------------------
# daemon
#
# The daemon is optional: it serves the exact same commands over a Unix socket
# so the UI pays one process start instead of one per command. The request and
# response shapes are documented in docs/cli-contract.md.

IN_CLOSE_WRITE = 0x00000008
IN_MOVED_FROM = 0x00000040
IN_MOVED_TO = 0x00000080
IN_CREATE = 0x00000100
IN_DELETE = 0x00000200
IN_DELETE_SELF = 0x00000400
IN_MOVE_SELF = 0x00000800
IN_Q_OVERFLOW = 0x00004000
IN_IGNORED = 0x00008000
IN_ISDIR = 0x40000000
WATCH_MASK = (
    IN_CLOSE_WRITE
    | IN_MOVED_TO
    | IN_MOVED_FROM
    | IN_CREATE
    | IN_DELETE
    | IN_DELETE_SELF
    | IN_MOVE_SELF
)
INOTIFY_EVENT = struct.Struct("iIII")
WATCH_DEBOUNCE = 0.4
WATCH_READ_TIMEOUT = 0.5


def daemon_identity() -> str:
    """A digest that changes when the data root or this script changes.

    A long-lived daemon serves a snapshot of the command table it was started
    with, so a store upgrade must not keep talking to an old one: including the
    file's size and mtime in the socket name gives the new build a new socket,
    and the previous daemon exits on its idle timeout.
    """
    try:
        info = Path(__file__).resolve().stat()
        stamp = f"{info.st_mtime_ns}:{info.st_size}"
    except OSError:
        stamp = ""
    return hashlib.sha1(f"{ROOT}|{stamp}".encode("utf-8")).hexdigest()[:12]


def daemon_socket_path() -> Path:
    """Return the daemon socket, never inside the data root.

    $QUILL_SOCKET wins; otherwise $XDG_RUNTIME_DIR/quill-<hash>.sock, falling
    back to the system temporary directory. The data root is deliberately
    excluded so the socket is neither watched nor indexed.
    """
    override = os.environ.get("QUILL_SOCKET")
    if override:
        candidate = Path(os.path.expanduser(override)).resolve()
    else:
        runtime = os.environ.get("XDG_RUNTIME_DIR")
        base = Path(os.path.expanduser(runtime)) if runtime else Path(tempfile.gettempdir())
        candidate = base / f"quill-{daemon_identity()}.sock"
    if candidate == ROOT or ROOT in candidate.parents:
        candidate = Path(tempfile.gettempdir()) / f"quill-{daemon_identity()}.sock"
    return candidate


def _index_note_count() -> int:
    try:
        if not INDEX.exists():
            return -1
        conn = sqlite3.connect(
            f"file:{urllib.parse.quote(str(INDEX), safe='/')}?mode=ro",
            uri=True,
            timeout=2,
        )
        try:
            return int(conn.execute("SELECT COUNT(*) FROM notes WHERE trashed=0").fetchone()[0])
        finally:
            conn.close()
    except (sqlite3.Error, OSError, TypeError):
        return -1


class _Watcher:
    """Inotify watcher that keeps the index warm between commands."""

    def __init__(self, libc, fd: int, broadcast) -> None:
        self.libc = libc
        self.fd = fd
        self.broadcast = broadcast
        self.watches: dict[int, Path] = {}
        self.pending: dict[Path, bool] = {}
        self.fallback = False
        self.rebuild = False

    # -- watch registration -------------------------------------------------

    def _add_watch(self, directory: Path) -> bool:
        try:
            wd = self.libc.inotify_add_watch(
                self.fd, str(directory).encode("utf-8"), WATCH_MASK
            )
        except OSError:
            return False
        if wd < 0:
            return False
        self.watches[wd] = directory
        return True

    def _add_tree(self, root: Path) -> int:
        added = 0
        if self._add_watch(root):
            added += 1
        try:
            walker = os.walk(root)
        except OSError:
            return added
        for dirpath, dirnames, _filenames in walker:
            for name in dirnames:
                if self._add_watch(Path(dirpath) / name):
                    added += 1
        return added

    def attach(self) -> bool:
        self.watches.clear()
        if self._add_tree(NOTES) == 0:
            return False
        self._add_tree(TRASH)
        return True

    def _reset(self) -> None:
        self.watches.clear()
        self._add_tree(NOTES)
        self._add_tree(TRASH)

    # -- events -------------------------------------------------------------

    def _consume(self, data: bytes) -> None:
        offset = 0
        while offset + INOTIFY_EVENT.size <= len(data):
            wd, mask, _cookie, name_len = INOTIFY_EVENT.unpack_from(data, offset)
            offset += INOTIFY_EVENT.size
            raw_name = data[offset : offset + name_len]
            offset += name_len
            name = raw_name.split(b"\x00", 1)[0].decode("utf-8", "replace")
            self._event(wd, mask, name)

    def _event(self, wd: int, mask: int, name: str) -> None:
        if mask & IN_Q_OVERFLOW:
            self.fallback = True
            self.rebuild = True
            return
        if mask & IN_IGNORED:
            self.watches.pop(wd, None)
            if mask & (IN_DELETE_SELF | IN_MOVE_SELF):
                self.fallback = True
                self.rebuild = True
            return
        directory = self.watches.get(wd)
        if directory is None:
            self.fallback = True
            self.rebuild = True
            return
        if mask & (IN_DELETE_SELF | IN_MOVE_SELF):
            # The watched directory itself moved or vanished; wd mappings are
            # no longer trustworthy.
            self.fallback = True
            self.rebuild = True
            return
        path = directory / name if name else directory
        if mask & IN_ISDIR:
            # A directory appeared, moved or disappeared: files inside it were
            # not individually reported, so a full sync is the safe fallback.
            self.fallback = True
            if mask & (IN_CREATE | IN_MOVED_TO):
                self._add_tree(path)
            else:
                self.rebuild = True
            return
        if path.suffix != ".md":
            return
        self.pending[path] = TRASH in path.parents

    # -- index maintenance --------------------------------------------------

    def _flush(self) -> None:
        pending = self.pending
        fallback = self.fallback
        self.pending = {}
        self.fallback = False
        if self.rebuild:
            self.rebuild = False
            self._reset()
        if not pending and not fallback:
            return

        touched: list[str] = []
        removed: list[str] = []
        full = False
        with EXEC_LOCK:
            with locked():
                conn = index_connect()
                try:
                    if fallback:
                        sync_index(conn, full=False)
                        full = True
                    else:
                        affected: set[str] = set()
                        for path, trashed in pending.items():
                            root = TRASH if trashed else NOTES
                            try:
                                identifier = path.relative_to(root).as_posix()
                            except ValueError:
                                full = True
                                sync_index(conn, full=False)
                                touched = []
                                removed = []
                                break
                            key = note_key(identifier, trashed)
                            if path.is_file():
                                index_and_resolve(conn, path, trashed)
                                touched.append(identifier)
                                continue
                            # Mirror the deletion block in sync_index: links
                            # that resolved to this note become unresolved and
                            # can resolve again after a restore.
                            previous = conn.execute(
                                "SELECT id FROM notes WHERE key=?", (key,)
                            ).fetchone()
                            if previous is not None:
                                for (target_norm,) in conn.execute(
                                    "SELECT DISTINCT target_norm FROM links "
                                    "WHERE resolved_id=?",
                                    (str(previous[0]),),
                                ).fetchall():
                                    affected.add(str(target_norm))
                            conn.execute("DELETE FROM notes WHERE key=?", (key,))
                            conn.execute("DELETE FROM tags WHERE note_key=?", (key,))
                            conn.execute("DELETE FROM links WHERE src_key=?", (key,))
                            conn.execute("DELETE FROM notes_fts WHERE id=?", (key,))
                            removed.append(identifier)
                        if not full and affected:
                            resolve_links(conn, target_norms=affected)
                    conn.commit()
                finally:
                    conn.close()
        if full:
            self.broadcast({"event": "notes", "ids": [], "removed": [], "full": True})
        elif touched or removed:
            self.broadcast({"event": "notes", "ids": touched, "removed": removed})

    def run(self) -> None:
        global INDEX_TRUSTED
        last_event = time.monotonic()
        try:
            while True:
                timeout = WATCH_READ_TIMEOUT
                if self.pending or self.fallback:
                    remaining = WATCH_DEBOUNCE - (time.monotonic() - last_event)
                    timeout = max(0.05, min(WATCH_READ_TIMEOUT, remaining))
                try:
                    ready, _w, _x = select.select([self.fd], [], [], timeout)
                except (OSError, ValueError):
                    return
                if ready:
                    while True:
                        try:
                            data = os.read(self.fd, 65536)
                        except BlockingIOError:
                            break
                        except OSError:
                            return
                        if not data:
                            break
                        self._consume(data)
                    last_event = time.monotonic()
                if (self.pending or self.fallback) and (
                    time.monotonic() - last_event >= WATCH_DEBOUNCE
                ):
                    self._flush()
        except Exception:
            # A broken watcher must never take the server down; fall back to
            # syncing in with_index() on the next command.
            pass
        finally:
            INDEX_TRUSTED = False
            with contextlib.suppress(OSError):
                os.close(self.fd)


def start_watcher(broadcast) -> bool:
    """Start the inotify watcher thread. Returns False on any OS failure."""
    try:
        libc = ctypes.CDLL("libc.so.6", use_errno=True)
        libc.inotify_init1.argtypes = [ctypes.c_int]
        libc.inotify_init1.restype = ctypes.c_int
        libc.inotify_add_watch.argtypes = [ctypes.c_int, ctypes.c_char_p, ctypes.c_uint32]
        libc.inotify_add_watch.restype = ctypes.c_int
        fd = int(libc.inotify_init1(os.O_NONBLOCK | os.O_CLOEXEC))
    except (OSError, AttributeError, TypeError):
        return False
    if fd < 0:
        return False
    watcher = _Watcher(libc, fd, broadcast)
    try:
        attached = watcher.attach()
    except OSError:
        attached = False
    if not attached:
        with contextlib.suppress(OSError):
            os.close(fd)
        return False
    threading.Thread(target=watcher.run, name="quill-watch", daemon=True).start()
    return True


class _Client:
    """One daemon connection: a Queue plus a writer thread for ordered output."""

    def __init__(self, conn: socket.socket) -> None:
        self.conn = conn
        self.events: queue.Queue = queue.Queue()
        self.send_lock = threading.Lock()
        self.writer = threading.Thread(
            target=self._write_loop, name="quill-send", daemon=True
        )

    def start(self) -> None:
        self.writer.start()

    def send(self, payload: dict) -> None:
        self.events.put(payload)

    def close_after_flush(self) -> None:
        self.events.put(None)
        self.writer.join(timeout=2.0)

    def _write_loop(self) -> None:
        while True:
            payload = self.events.get()
            if payload is None:
                return
            data = (json.dumps(payload, ensure_ascii=False) + "\n").encode("utf-8")
            with self.send_lock:
                try:
                    self.conn.sendall(data)
                except OSError:
                    return


def serve(socket_path: Path, watch: bool = True, idle: float = 0.0) -> None:
    """Serve commands on `socket_path` until shutdown or idle exit."""
    global INDEX_TRUSTED

    # The watcher indexes files, so under E2E this must never point at the
    # user's library — a QML harness that forgot to set the data root would
    # otherwise quietly migrate and rewrite the real index.
    if (
        os.environ.get("QUILL_E2E") == "1"
        and os.environ.get("QUILL_E2E_ALLOW_REAL") != "1"
        and ROOT == real_data_root()
    ):
        raise StoreError(
            "QUILL_E2E=1 refuses to serve the real Quill data root; "
            "point QUILL_DATA_DIR at a clone"
        )

    ensure_store()
    socket_path = Path(socket_path)
    if socket_path.exists():
        probe = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        try:
            probe.settimeout(1.0)
            probe.connect(str(socket_path))
        except OSError:
            with contextlib.suppress(OSError):
                socket_path.unlink()
        else:
            raise StoreError(f"quill daemon already running on {socket_path}")
        finally:
            probe.close()

    socket_path.parent.mkdir(parents=True, exist_ok=True)
    server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    stop = threading.Event()
    clients: list[_Client] = []
    clients_lock = threading.Lock()
    threads: set[threading.Thread] = set()
    last_empty = [time.monotonic()]

    def broadcast(event: dict) -> None:
        with clients_lock:
            targets = list(clients)
        for client in targets:
            client.send(event)

    def handle(payload):
        if not isinstance(payload, dict):
            return {"ok": False, "error": "request must be a JSON object"}
        reply: dict = {}
        if "id" in payload:
            reply["id"] = payload["id"]
        op = payload.get("op")
        if op is not None:
            if op == "ping":
                reply["ok"] = True
                reply["result"] = {
                    "pid": os.getpid(),
                    "dataRoot": str(ROOT),
                    "notes": _index_note_count(),
                    "watcher": bool(INDEX_TRUSTED),
                    "version": SCHEMA_VERSION,
                }
                return reply
            if op == "shutdown":
                reply["ok"] = True
                reply["result"] = {"stopped": True}
                stop.set()
                return reply
            reply["ok"] = False
            reply["error"] = f"unknown op: {op}"
            return reply
        raw_args = payload.get("args")
        if not isinstance(raw_args, list) or not all(
            isinstance(value, str) for value in raw_args
        ):
            reply["ok"] = False
            reply["error"] = "args must be a list of strings"
            return reply
        if raw_args and raw_args[0] == "__serve":
            reply["ok"] = False
            reply["error"] = "cannot serve __serve from an existing daemon"
            return reply
        raw_stdin = payload.get("stdin")
        if raw_stdin is None:
            stdin_payload = b""
        elif isinstance(raw_stdin, str):
            stdin_payload = raw_stdin.encode("utf-8")
        else:
            reply["ok"] = False
            reply["error"] = "stdin must be a string"
            return reply
        try:
            code, out, err = run_command(raw_args, stdin_payload)
        except SystemExit as error:
            reply["ok"] = False
            reply["error"] = f"invalid arguments (exit {error.code})"
            return reply
        except BaseException as error:  # never let a traceback reach the wire
            reply["ok"] = False
            reply["error"] = f"{type(error).__name__}: {error}"
            return reply
        if code == 0:
            try:
                reply["result"] = json.loads(out)
            except json.JSONDecodeError:
                reply["ok"] = False
                reply["error"] = "command produced invalid JSON"
            else:
                reply["ok"] = True
            return reply
        message = err.strip()
        try:
            parsed = json.loads(err)
        except json.JSONDecodeError:
            parsed = None
        if isinstance(parsed, dict) and isinstance(parsed.get("error"), str):
            message = parsed["error"]
        reply["ok"] = False
        reply["error"] = message
        return reply

    def client_thread(client: _Client) -> None:
        try:
            client.start()
            buffer = b""
            while not stop.is_set():
                try:
                    chunk = client.conn.recv(65536)
                except socket.timeout:
                    continue
                except OSError:
                    break
                if not chunk:
                    break
                buffer += chunk
                while b"\n" in buffer:
                    line, _sep, buffer = buffer.partition(b"\n")
                    if len(line) > MAX_REQUEST_BYTES:
                        client.send({"ok": False, "error": "request too large"})
                        continue
                    try:
                        payload = json.loads(line.decode("utf-8"))
                    except (UnicodeDecodeError, json.JSONDecodeError) as error:
                        client.send({"ok": False, "error": f"invalid request: {error}"})
                        continue
                    client.send(handle(payload))
                    if stop.is_set():
                        break
                if stop.is_set():
                    break
                if len(buffer) > MAX_REQUEST_BYTES:
                    # No newline in sight: the stream cannot be resynchronised.
                    client.send({"ok": False, "error": "request too large"})
                    break
        finally:
            client.close_after_flush()
            with contextlib.suppress(OSError):
                client.conn.close()
            with clients_lock:
                if client in clients:
                    clients.remove(client)
                if not clients:
                    last_empty[0] = time.monotonic()
            threads.discard(threading.current_thread())

    try:
        server.bind(str(socket_path))
        os.chmod(socket_path, 0o600)
        server.listen(64)
        server.settimeout(0.25)
        if watch and start_watcher(broadcast):
            with EXEC_LOCK:
                with locked():
                    conn = index_connect()
                    try:
                        sync_index(conn)
                    finally:
                        conn.close()
            INDEX_TRUSTED = True
        while not stop.is_set():
            try:
                conn, _address = server.accept()
            except socket.timeout:
                if idle > 0:
                    with clients_lock:
                        busy = bool(clients)
                    if not busy and time.monotonic() - last_empty[0] >= idle:
                        break
                continue
            except OSError:
                break
            conn.settimeout(0.25)
            client = _Client(conn)
            with clients_lock:
                clients.append(client)
            thread = threading.Thread(
                target=client_thread, args=(client,), name="quill-client", daemon=True
            )
            with clients_lock:
                threads.add(thread)
            thread.start()
    finally:
        stop.set()
        server.close()
        with contextlib.suppress(OSError):
            socket_path.unlink()
        with clients_lock:
            pending = list(threads)
        for thread in pending:
            thread.join(timeout=2.0)
        INDEX_TRUSTED = False


def command_serve(args) -> dict:
    raw_socket = getattr(args, "socket", None)
    path = (
        Path(os.path.expanduser(str(raw_socket))).resolve()
        if raw_socket
        else daemon_socket_path()
    )
    serve(
        path,
        watch=not bool(getattr(args, "no_watch", False)),
        idle=float(getattr(args, "idle", 0.0) or 0.0),
    )
    return {"stopped": True, "socket": str(path)}


def run_command(
    argv: list[str], stdin_payload: bytes | None = None
) -> tuple[int, str, str]:
    """Run one CLI invocation and return (exit_code, stdout_text, stderr_text).

    The output is byte-for-byte what main() writes for the same argv: one JSON
    line on stdout on success, one JSON error line on stderr on failure.
    """
    global SERVE_STDIN

    # `__serve` owns the process for as long as the daemon runs, so it must
    # not hold EXEC_LOCK for that lifetime: each served request takes it
    # individually (with_index/sync also serialise against the watcher).
    serving = bool(argv) and argv[0] == "__serve"
    guard = contextlib.nullcontext() if serving else EXEC_LOCK
    with guard:
        previous = SERVE_STDIN
        SERVE_STDIN = stdin_payload
        try:
            args = build_parser().parse_args(normalize_search_argv(argv))
            enforce_e2e(args)
            result = args.func(args)
            return 0, json.dumps(result, ensure_ascii=False) + "\n", ""
        except StoreError as error:
            return 1, "", json.dumps({"error": str(error)}, ensure_ascii=False) + "\n"
        except FileNotFoundError as error:
            return 1, "", json.dumps({"error": str(error)}, ensure_ascii=False) + "\n"
        except PermissionError as error:
            return 1, "", json.dumps({"error": str(error)}, ensure_ascii=False) + "\n"
        except sqlite3.Error as error:
            return 1, "", json.dumps(
                {"error": f"index error: {error}"}, ensure_ascii=False
            ) + "\n"
        except ValueError as error:
            return 1, "", json.dumps({"error": str(error)}, ensure_ascii=False) + "\n"
        except OSError as error:
            return 1, "", json.dumps({"error": str(error)}, ensure_ascii=False) + "\n"
        except Exception as error:  # keep the shell contract: JSON on stderr
            return 1, "", json.dumps(
                {"error": f"{type(error).__name__}: {error}"}, ensure_ascii=False
            ) + "\n"
        finally:
            SERVE_STDIN = previous


# --------------------------------------------------------------------------
# entry point


MUTATING_COMMANDS = {
    "write",
    "create",
    "duplicate",
    "rename",
    "move",
    "trash",
    "restore",
    "delete",
    "empty-trash",
    "pin",
    "tag-add",
    "tag-remove",
    "tag-rename",
    "tag-delete",
    "import-omanano",
    "index",
    "restore-version",
}


def real_data_root() -> Path:
    return Path(os.path.expanduser("~/.local/share/quill")).resolve()


def command_is_mutating(args) -> bool:
    command = str(getattr(args, "command", "") or "")
    if command == "folder":
        return True
    if command == "draft":
        return str(getattr(args, "draft_action", "") or "") == "discard"
    if command == "attachment":
        return str(getattr(args, "attachment_command", "") or "") in {"save", "gc"}
    if command == "searches":
        return str(getattr(args, "searches_action", "") or "") in {"add", "remove"}
    if command == "templates":
        return str(getattr(args, "templates_action", "") or "") in {"save", "delete"}
    if command == "settings":
        return str(getattr(args, "settings_action", "") or "") != "get"
    return command in MUTATING_COMMANDS


def enforce_e2e(args) -> None:
    """Refuse mutations of the user's real root from an E2E harness.

    Read-only commands still work so a harness can inspect a clone or (for a
    deliberate read-only check) the real root. Our tooling must never set
    QUILL_E2E_ALLOW_REAL.
    """
    if os.environ.get("QUILL_E2E") != "1":
        return
    if os.environ.get("QUILL_E2E_ALLOW_REAL") == "1":
        return
    if command_is_mutating(args) and ROOT == real_data_root():
        raise StoreError(
            "QUILL_E2E=1 refuses to modify the real Quill data root; "
            "point QUILL_DATA_DIR at a clone or set QUILL_E2E_ALLOW_REAL=1 deliberately"
        )


def normalize_search_argv(argv: list[str]) -> list[str]:
    """Let ``search`` accept a query that starts with ``-`` without ``--``.

    argparse treats a leading dash as an option, but negation is part of the
    search grammar. Known search options are kept before the query, then ``--``
    separates the single positional query.
    """
    if not argv or argv[0] != "search":
        return argv
    options: list[str] = []
    positionals: list[str] = []
    index = 1
    while index < len(argv):
        argument = argv[index]
        if argument == "--":
            positionals.extend(argv[index + 1:])
            break
        if argument in {"-h", "--help"}:
            options.append(argument)
            index += 1
            continue
        if argument == "--limit":
            options.extend(argv[index:index + 2])
            index += 2
            continue
        if argument.startswith("--limit="):
            options.append(argument)
            index += 1
            continue
        positionals.append(argument)
        index += 1
    if any(argument.startswith("-") for argument in positionals):
        return ["search"] + options + ["--"] + positionals
    return ["search"] + options + positionals


def add_bulk_id(parser: argparse.ArgumentParser) -> None:
    """Add the repeatable ``--id`` used by every bulk-capable command."""
    parser.add_argument(
        "--id", dest="more_ids", action="append", default=[], metavar="ID",
        help="additional note id (repeatable)",
    )


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="quill-store", description="Quill notes backend")
    sub = parser.add_subparsers(dest="command", required=True)

    listing = sub.add_parser("list")
    listing.add_argument("--trashed", action="store_true")
    listing.set_defaults(func=command_list)

    read = sub.add_parser("read")
    read.add_argument("id")
    read.add_argument("--trashed", action="store_true")
    read.set_defaults(func=command_read)

    write = sub.add_parser("write")
    write.add_argument("id")
    write.add_argument("--stdin", action="store_true", help="read the new body from stdin")
    write.add_argument("--content-file", help="read the new body from a file (UI convenience)")
    write.add_argument("--create", action="store_true",
                       help="create the note at this exact id when it is missing")
    write.set_defaults(func=command_write)

    draft = sub.add_parser("draft")
    draft_sub = draft.add_subparsers(dest="draft_action", required=True)
    draft_discard = draft_sub.add_parser("discard")
    draft_discard.add_argument("id")
    draft_discard.set_defaults(func=command_draft)

    create = sub.add_parser("create")
    create.add_argument("--folder", default="")
    create.add_argument("--title", default="")
    create.add_argument("--content-stdin", action="store_true")
    create.add_argument("--template", default=None,
                        help="start from a stored template id (ignores --title)")
    create.set_defaults(func=command_create)

    duplicate = sub.add_parser("duplicate")
    duplicate.add_argument("id")
    duplicate.set_defaults(func=command_duplicate)

    rename = sub.add_parser("rename")
    rename.add_argument("id")
    rename.add_argument("--title", required=True)
    rename.add_argument("--links", choices=("update", "skip"), default="update",
                        help="rewrite inbound [[wiki links]] (default: update)")
    rename.add_argument("--dry-run", action="store_true",
                        help="report link rewrites without writing anything")
    rename.set_defaults(func=command_rename)

    move = sub.add_parser("move")
    move.add_argument("id")
    add_bulk_id(move)
    move.add_argument("--folder", default="")
    move.set_defaults(func=command_move)

    for name, handler in (
        ("trash", command_trash),
        ("restore", command_restore),
        ("delete", command_delete),
        ("pin", command_pin),
    ):
        item = sub.add_parser(name)
        item.add_argument("id")
        add_bulk_id(item)
        if name == "pin":
            item.add_argument(
                "--state", choices=("on", "off", "toggle"), default="toggle",
                help="force pinned on/off, or toggle the current state (default)",
            )
        item.set_defaults(func=handler)

    sub.add_parser("empty-trash").set_defaults(func=command_empty_trash)

    versions = sub.add_parser("versions")
    versions.add_argument("id")
    versions.set_defaults(func=command_versions)

    restore_version = sub.add_parser("restore-version")
    restore_version.add_argument("id")
    restore_version.add_argument("snapshot", help="snapshot basename or absolute path")
    restore_version.set_defaults(func=command_restore_version)

    folder = sub.add_parser("folder")
    folder_sub = folder.add_subparsers(dest="folder_action", required=True)
    folder_create = folder_sub.add_parser("create")
    folder_create.add_argument("path")
    folder_create.set_defaults(func=command_folder)
    folder_rename = folder_sub.add_parser("rename")
    folder_rename.add_argument("path")
    folder_rename.add_argument("new")
    folder_rename.set_defaults(func=command_folder)
    folder_delete = folder_sub.add_parser("delete")
    folder_delete.add_argument("path")
    folder_delete.add_argument("--force", action="store_true")
    folder_delete.set_defaults(func=command_folder)

    search = sub.add_parser("search")
    search.add_argument("query")
    search.add_argument("--limit", type=int, default=50)
    search.set_defaults(func=command_search)

    titles = sub.add_parser("titles")
    titles.add_argument("--limit", type=int, default=5000)
    titles.set_defaults(func=command_titles)

    searches = sub.add_parser("searches")
    searches_sub = searches.add_subparsers(dest="searches_action", required=True)
    searches_sub.add_parser("list").set_defaults(func=command_searches)
    searches_add = searches_sub.add_parser("add")
    searches_add.add_argument("query")
    searches_add.add_argument("--label", default=None)
    searches_add.set_defaults(func=command_searches)
    searches_remove = searches_sub.add_parser("remove")
    searches_remove.add_argument("query")
    searches_remove.set_defaults(func=command_searches)

    settings = sub.add_parser("settings")
    settings_sub = settings.add_subparsers(dest="settings_action", required=True)
    settings_sub.add_parser("get").set_defaults(func=command_settings)
    settings_set = settings_sub.add_parser("set")
    settings_set.add_argument("--json", dest="settings_json", default=None,
                              help="replace the ui object with this JSON object")
    settings_set.add_argument("--stdin", dest="settings_stdin", action="store_true",
                              help="read the replacement ui object from stdin")
    settings_set.set_defaults(func=command_settings)

    sub.add_parser("tags").set_defaults(func=command_tags)

    templates = sub.add_parser("templates")
    templates_sub = templates.add_subparsers(dest="templates_action", required=True)
    templates_sub.add_parser("list").set_defaults(func=command_templates)
    templates_show = templates_sub.add_parser("show")
    templates_show.add_argument("template_id")
    templates_show.set_defaults(func=command_templates)
    templates_save = templates_sub.add_parser("save")
    templates_save.add_argument("template_id")
    templates_save.add_argument("--name", default=None)
    templates_save.add_argument("--description", default=None)
    templates_save.add_argument("--icon", default=None)
    templates_source = templates_save.add_mutually_exclusive_group()
    templates_source.add_argument("--content-file", help="read the body from this file")
    templates_source.add_argument("--stdin", dest="content_stdin", action="store_true",
                                  help="read the body from stdin")
    templates_save.set_defaults(func=command_templates)
    templates_delete = templates_sub.add_parser("delete")
    templates_delete.add_argument("template_id")
    templates_delete.set_defaults(func=command_templates)

    tag_rename = sub.add_parser("tag-rename")
    tag_rename.add_argument("old")
    tag_rename.add_argument("new")
    tag_rename.set_defaults(func=command_tag_rename)

    tag_delete = sub.add_parser("tag-delete")
    tag_delete.add_argument("tag")
    tag_delete.set_defaults(func=command_tag_delete)

    tag_add = sub.add_parser("tag-add")
    tag_add.add_argument("id")
    add_bulk_id(tag_add)
    tag_add.add_argument("tags", nargs="+")
    tag_add.set_defaults(func=command_tag_add)

    tag_remove = sub.add_parser("tag-remove")
    tag_remove.add_argument("id")
    add_bulk_id(tag_remove)
    tag_remove.add_argument("tags", nargs="+")
    tag_remove.set_defaults(func=command_tag_remove)

    backlinks = sub.add_parser("backlinks")
    backlinks.add_argument("id")
    backlinks.set_defaults(func=command_backlinks)

    unresolved = sub.add_parser("unresolved")
    unresolved.add_argument("--id", default=None)
    unresolved.add_argument("--limit", type=int, default=500)
    unresolved.set_defaults(func=command_unresolved)

    preview = sub.add_parser("preview")
    preview.add_argument("id", nargs="?")
    preview.add_argument("--trashed", action="store_true")
    preview.add_argument("--content-file", default=None)
    preview.add_argument("--stdin", action="store_true")
    preview.set_defaults(func=command_preview)

    sub.add_parser("import-omanano").set_defaults(func=command_import)

    index = sub.add_parser("index")
    index.add_argument("--rebuild", action="store_true")
    index.set_defaults(func=command_index)

    attachment = sub.add_parser("attachment")
    attachment_sub = attachment.add_subparsers(dest="attachment_command", required=True)
    attachment_save = attachment_sub.add_parser("save")
    attachment_source = attachment_save.add_mutually_exclusive_group(required=True)
    attachment_source.add_argument("--file", help="read the file from this path")
    attachment_source.add_argument("--stdin", action="store_true", help="read the file from stdin")
    attachment_save.add_argument("--name", default="", help="alt text for the Markdown link")
    attachment_save.set_defaults(func=command_attachment_save)
    attachment_sub.add_parser("list").set_defaults(func=command_attachment_list)
    attachment_gc = attachment_sub.add_parser("gc")
    attachment_gc.add_argument("--dry-run", action="store_true")
    attachment_gc.set_defaults(func=command_attachment_gc)

    sub.add_parser("stats").set_defaults(func=command_stats)

    serve_parser = sub.add_parser("__serve")
    serve_parser.add_argument("--socket", default=None, help="socket path override")
    serve_parser.add_argument("--no-watch", action="store_true", help="disable the inotify watcher")
    serve_parser.add_argument("--idle", type=float, default=0.0, help="exit after N idle seconds (0 = never)")
    serve_parser.set_defaults(func=command_serve)
    return parser


def main() -> int:
    code, out, err = run_command(sys.argv[1:])
    if out:
        sys.stdout.write(out)
        sys.stdout.flush()
    if err:
        sys.stderr.write(err)
        sys.stderr.flush()
    return code


if __name__ == "__main__":
    raise SystemExit(main())
