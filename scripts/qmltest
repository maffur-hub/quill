#!/usr/bin/env bash
# Drive real components through real behaviour in a disposable, headless
# Quickshell, and fail on any assertion the case reports.
#
# scripts/qmlcheck proves the components *load*. This proves they still *work*:
# a case instantiates a component, calls into it and checks the result. That is
# the class of bug the load check cannot see (a save callback throwing on an
# out-of-scope variable, a conflict banner that never appears).
#
# Each case gets its own temp data root and its own offscreen instance, so no
# live note is ever read or written. A case is a QML Item exposing start(harness)
# and reporting through harness.check(name, ok, detail) / harness.done().
set -u

cd "$(dirname "$0")/.." || exit 1
root=$(pwd)

shell_root="${OMARCHY_PATH:-/usr/share/omarchy}/shell"
if [[ ! -f "$shell_root/shell.qml" ]]; then
  echo "skip: Omarchy shell not found at $shell_root"
  exit 0
fi
if ! command -v quickshell >/dev/null 2>&1; then
  echo "skip: quickshell is not installed"
  exit 0
fi

cases=(
  tests/qml/library-save.qml
  tests/qml/library-draft.qml
  tests/qml/library-external-change.qml
  tests/qml/library-inflight-save.qml
  tests/qml/library-save-guard.qml
  tests/qml/library-daemon-missing.qml
  tests/qml/library-large-note.qml
  tests/qml/library-long-note.qml
  tests/qml/tablegrid.qml
  tests/qml/preview-table.qml
  tests/qml/editor-underlay.qml
  tests/qml/editor-keys.qml
  tests/qml/formatbar.qml
  tests/qml/detached-save.qml
  tests/qml/detached-close.qml
)

status=0

# scripts/quill-window stages the detached window in the cache on every launch.
# Prove the stage is rebuilt from the plugin and pruned: a component that an
# older plugin version left behind must not survive to be loaded. Uses a stub
# quickshell so no real window opens and no real cache dir is touched.
check_window_stage() {
  local tmp stage argfile
  tmp=$(mktemp -d "${TMPDIR:-/tmp}/quill-window.XXXXXX")
  stage="$tmp/cache/quill/detached"
  argfile="$tmp/argv"
  mkdir -p "$tmp/bin"
  cat > "$tmp/bin/quickshell" <<'STUB'
#!/bin/sh
printf '%s\n' "$@" > "$QUILL_STUB_ARGV"
exit 0
STUB
  chmod +x "$tmp/bin/quickshell"

  run_window() {
    PATH="$tmp/bin:$PATH" \
      QUILL_STUB_ARGV="$argfile" \
      XDG_CACHE_HOME="$tmp/cache" \
      QUILL_DATA_DIR="$tmp/data" \
      "$root/scripts/quill-window" some-note-id "A title" "$tmp/data" >/dev/null 2>&1
  }

  report() { # name ok [detail]
    if [[ "$2" == "1" ]]; then
      echo "ok - window stage: $1"
    else
      echo "not ok - window stage: $1${3:+: $3}"
      status=1
    fi
  }

  local rc=0
  run_window || rc=$?
  if [[ "$rc" -ne 0 ]]; then
    report "quill-window runs against the stub" 0 "exit $rc"
    rm -rf "$tmp"
    return
  fi

  report "the launch stages Detached.qml" \
    "$([[ -f "$stage/Detached.qml" ]] && echo 1 || echo 0)"
  local links_ok=1 links_detail="" target expected
  for target in Commons Ui scripts vendor; do
    case "$target" in
      Commons|Ui) expected="/usr/share/omarchy/shell/$target" ;;
      scripts|vendor) expected="$root/$target" ;;
    esac
    if [[ -L "$stage/$target" && "$(readlink "$stage/$target")" == "$expected" ]]; then
      continue
    fi
    links_ok=0
    links_detail+="$target -> $(readlink "$stage/$target" 2>/dev/null || echo missing), "
  done
  report "the stage links the shell modules and plugin dirs" "$links_ok" "${links_detail%, }"
  report "quickshell is pointed at the staged window" \
    "$([[ -f "$argfile" ]] && grep -qx -- "-p" "$argfile" && grep -qF -- "$stage" "$argfile" && echo 1 || echo 0)" \
    "$(tr '\n' ' ' < "$argfile" 2>/dev/null)"
  report "the staged Library.qml matches the plugin" \
    "$(cmp -s "$root/Library.qml" "$stage/Library.qml" && echo 1 || echo 0)"

  # A stale component from an older launch must not outlive the next one.
  printf 'stale\n' > "$stage/Library.qml"
  printf 'stale\n' > "$stage/Orphan.qml"
  run_window
  report "a relaunch restores an overwritten component" \
    "$(cmp -s "$root/Library.qml" "$stage/Library.qml" && echo 1 || echo 0)"
  report "a relaunch removes a component the plugin no longer ships" \
    "$([[ ! -e "$stage/Orphan.qml" ]] && echo 1 || echo 0)"

  rm -rf "$tmp"
}

check_window_stage

for case in "${cases[@]}"; do
  name=$(basename "$case" .qml)
  stage=$(mktemp -d "${TMPDIR:-/tmp}/quill-qmltest.XXXXXX")
  mkdir -p "$stage/imports" "$stage/data"
  ln -sfn "$shell_root" "$stage/imports/qs"

  export QUILL_DATA_DIR="$stage/data"
  export QUILL_TEST_DATA="$stage/data"
  export QUILL_TEST_STORE="$root/scripts/quill-store"
  export QUILL_TEST_NOTE_ID
  # Detached.qml resolves its identity from the environment only, so a case
  # that instantiates it needs the same names scripts/quill-window exports.
  export QUILL_STORE_PATH="$root/scripts/quill-store"
  QUILL_TEST_NOTE_ID=$("$root/scripts/quill-store" create \
    --title "Save harness" \
    --content-stdin <<'NOTE' | python3 -c 'import json,sys; print(json.load(sys.stdin)["id"])'
# Save harness

original body
NOTE
  ) || { echo "not ok - $name: could not seed a note"; rm -rf "$stage"; status=1; continue; }
  export QUILL_NOTE_ID="$QUILL_TEST_NOTE_ID"

  cat > "$stage/shell.qml" <<EOF
import QtQuick
import Quickshell

ShellRoot {
  id: harness
  property string dataRoot: Quickshell.env("QUILL_TEST_DATA") || ""
  property string storePath: Quickshell.env("QUILL_TEST_STORE") || ""
  property int passed: 0
  property int failed: 0

  function check(name, ok, detail) {
    if (ok) {
      harness.passed += 1
      console.log("ok - " + name)
    } else {
      harness.failed += 1
      console.log("not ok - " + name + (detail ? ": " + detail : ""))
    }
  }
  function done() {
    console.log("SUMMARY passed=" + harness.passed + " failed=" + harness.failed)
    Qt.exit(harness.failed === 0 ? 0 : 1)
  }

  Loader {
    id: caseLoader
    source: "file://$root/$case"
    onStatusChanged: {
      if (status === Loader.Error) {
        harness.check("$name loads", false, "QML error")
        harness.done()
      } else if (status === Loader.Ready) {
        caseLoader.item.start(harness)
      }
    }
  }

  Timer {
    interval: 45000
    running: true
    onTriggered: {
      harness.check("$name finished", false, "timed out")
      harness.done()
    }
  }
}
EOF

  echo "== $name =="
  output=$(QML_IMPORT_PATH="$stage/imports" \
    QT_QPA_PLATFORM=offscreen \
    QUILL_E2E=1 \
    timeout 90 quickshell -n -p "$stage" 2>&1)
  # Quickshell prefixes each console line with a coloured "DEBUG qml:" tag, so
  # strip the escape codes and the tag before looking for assertions.
  clean=$(printf '%s\n' "$output" | sed -e 's/\x1b\[[0-9;]*m//g' -e 's/^.*qml: //')
  printf '%s\n' "$clean" | grep -E "^(ok|not ok|SUMMARY)" || true
  if printf '%s\n' "$clean" | grep -q "^not ok" \
     || ! printf '%s\n' "$clean" | grep -q "^SUMMARY passed="; then
    status=1
    # Keep the rest of the log when something failed, it is the evidence.
    printf '%s\n' "$clean" | grep -vE "^(ok|not ok|SUMMARY)" | tail -20
  fi
  rm -rf "$stage"
done

if [[ "$status" -eq 0 ]]; then
  echo "QML behaviour: all cases passed"
else
  echo "QML behaviour: failures above"
fi
exit "$status"
