#!/usr/bin/env python3
"""quill-joplin-tags - mirror Quill's note tags onto already-synced Joplin notes.

The shared omanano-joplin-sync tool mirrors note bodies but knows nothing about
tags. This helper runs after a successful sync, reads the same Markdown tree,
and uses the sync state's relpath -> Joplin note id mapping to reconcile each
note's tags through the Joplin Data API:

    POST   /tags {title}              create a missing tag
    POST   /tags/<id>/notes {id}      attach it to a note
    DELETE /tags/<id>/notes/<noteId>  detach a tag no longer in Quill

Tags come from frontmatter ``tags:`` (inline or YAML list) and inline ``#tag``
outside fenced code, inline code, URLs and Markdown link destinations - the
same rules quill-store indexes. The pass is idempotent: a second run with
unchanged notes performs no writes.

Best-effort by design: unique exits let the wrapper ignore failures.
Exit codes: 0 = ok (including nothing to do), 1 = real failure,
3 = Joplin unreachable (Joplin not running).
"""
from __future__ import annotations

import argparse
import json
import os
import re
import sys
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

EXIT_OK, EXIT_ERROR, EXIT_NO_JOPLIN = 0, 1, 3
DEFAULT_API = "http://127.0.0.1:41184"
DEFAULT_NOTES_DIR = "~/.local/share/quill/notes"
DEFAULT_STATE = "~/.local/share/quill-joplin/state.json"
JOPLIN_SETTINGS = Path("~/.config/joplin-desktop/settings.json").expanduser()
TIMEOUT = 8

TAG_RE = re.compile(r"(?<![#\w\\])#([A-Za-z0-9_/-]+)")
INLINE_CODE_RE = re.compile(r"`[^`\n]*`")
FENCE_RE = re.compile(r"^\s{0,3}(```|~~~)")
URL_RE = re.compile(r"(?:https?://|mailto:)[^\s<>()]+")
MD_DEST_RE = re.compile(r"\]\(\s*([^\s()]+)")


class JoplinError(Exception):
    def __init__(self, message, code=0):
        super().__init__(message)
        self.code = code


def expand(path: str) -> Path:
    return Path(os.path.expanduser(path))


def split_frontmatter(text: str):
    if not text.startswith("---"):
        return None, text
    lines = text.splitlines(keepends=True)
    if not lines or lines[0].strip() != "---":
        return None, text
    for index in range(1, min(len(lines), 400)):
        if lines[index].strip() == "---":
            return "".join(lines[1:index]), "".join(lines[index + 1:])
    return None, text


def normalize_tags(values):
    output, seen = [], set()
    for raw in values:
        value = str(raw or "").strip().lstrip("#").strip()
        if not value:
            continue
        value = re.sub(r"[^A-Za-z0-9_/-]+", "-", value).strip("-/")
        if not value:
            continue
        key = value.casefold()
        if key in seen:
            continue
        seen.add(key)
        output.append(value[:80])
    return output


def frontmatter_tags(frontmatter):
    if not frontmatter:
        return []
    lines = frontmatter.splitlines()
    collected = []
    for index, line in enumerate(lines):
        match = re.match(r"^\s*tags\s*:\s*(.*)$", line, re.IGNORECASE)
        if not match:
            continue
        rest = match.group(1).strip()
        values = []
        if rest:
            rest = rest.strip("[]")
            values = [part.strip() for part in rest.split(",")]
        else:
            for follow in lines[index + 1:]:
                item = re.match(r"^\s*-\s*(.+)$", follow)
                if item:
                    values.append(item.group(1).strip())
                elif follow.strip() == "":
                    continue
                else:
                    break
        for value in values:
            value = value.strip().strip("'\"").strip()
            if value:
                collected.append(value.lstrip("#"))
        break
    return normalize_tags(collected)


def protected_spans(line):
    spans = [match.span() for match in URL_RE.finditer(line)]
    spans.extend(match.span(1) for match in MD_DEST_RE.finditer(line))
    return spans


def overlaps(span, spans):
    start, end = span
    return any(start < other_end and other_start < end for other_start, other_end in spans)


def extract_inline_tags(text):
    found = []
    in_code = False
    for line in text.splitlines():
        if FENCE_RE.match(line):
            in_code = not in_code
            continue
        if in_code:
            continue
        protected = protected_spans(line)
        pieces, cursor = [], 0
        for match in INLINE_CODE_RE.finditer(line):
            pieces.append((cursor, match.start()))
            cursor = match.end()
        pieces.append((cursor, len(line)))
        for start, end in pieces:
            for match in TAG_RE.finditer(line, start, end):
                if not overlaps(match.span(), protected):
                    found.append(match.group(1))
    return found


def note_tags(path: Path):
    try:
        text = path.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return []
    frontmatter, body = split_frontmatter(text)
    return normalize_tags(list(frontmatter_tags(frontmatter)) + list(extract_inline_tags(body)))


def load_token(explicit=None):
    if explicit:
        return explicit
    for var in ("QUILL_JOPLIN_TOKEN", "OMANANO_JOPLIN_TOKEN"):
        if os.environ.get(var):
            return os.environ[var]
    try:
        settings = json.loads(JOPLIN_SETTINGS.read_text(encoding="utf-8"))
        token = settings.get("api.token")
    except (OSError, json.JSONDecodeError):
        token = None
    if not token:
        raise RuntimeError(
            "no Joplin API token: pass --token, set QUILL_JOPLIN_TOKEN, or enable "
            "Options -> Web Clipper in Joplin")
    return str(token)


class Joplin:
    def __init__(self, base, token):
        self.base, self.token = base.rstrip("/"), token

    def request(self, method, path, params=None, body=None):
        query = dict(params or {}, token=self.token)
        url = f"{self.base}{path}?{urllib.parse.urlencode(query)}"
        payload = json.dumps(body).encode("utf-8") if body is not None else None
        req = urllib.request.Request(
            url, data=payload, method=method,
            headers={"Content-Type": "application/json"})
        try:
            with urllib.request.urlopen(req, timeout=TIMEOUT) as resp:
                raw = resp.read()
                return json.loads(raw) if raw else {}
        except urllib.error.HTTPError as exc:
            text = exc.read().decode("utf-8", "replace")[:300]
            raise JoplinError(f"HTTP {exc.code} on {method} {path}: {text}", exc.code) from exc
        except (urllib.error.URLError, TimeoutError, OSError) as exc:
            raise JoplinError(f"{method} {path}: {exc}") from exc

    def ping(self):
        try:
            with urllib.request.urlopen(
                    f"{self.base}/ping?{urllib.parse.urlencode({'token': self.token})}",
                    timeout=TIMEOUT) as resp:
                return resp.status == 200
        except (urllib.error.HTTPError, urllib.error.URLError, TimeoutError, OSError):
            return False

    def get_all(self, path, params=None):
        items, page = [], 1
        while True:
            chunk = self.request("GET", path, dict(params or {}, page=page, limit=100))
            items.extend(chunk.get("items") or [])
            if not chunk.get("has_more") or page >= 100:
                return items
            page += 1


def local_tags(notes_dir: Path):
    """Relative POSIX path -> tags, matching the sync state's note keys."""
    result = {}
    for path in sorted(notes_dir.rglob("*.md")):
        rel = path.relative_to(notes_dir)
        if not path.is_file() or any(part.startswith(".") for part in rel.parts):
            continue
        result[rel.as_posix()] = note_tags(path)
    return result


def main(argv=None):
    parser = argparse.ArgumentParser(
        description="Mirror Quill note tags onto Joplin notes already synced by omanano-joplin-sync.")
    parser.add_argument("--notes-dir", help="Quill notes directory")
    parser.add_argument("--state", help="sync state file (relpath -> note id)")
    parser.add_argument("--api-url", help="Joplin Data API base URL")
    parser.add_argument("--token", help="Joplin API token (default: Joplin settings.json)")
    parser.add_argument("--dry-run", action="store_true", help="report only, write nothing")
    parser.add_argument("--quiet", action="store_true", help="one summary line")
    parser.add_argument("--json", action="store_true", help="machine-readable summary")
    args = parser.parse_args(argv)

    notes_dir = expand(args.notes_dir or os.environ.get("QUILL_JOPLIN_NOTES_DIR")
                       or DEFAULT_NOTES_DIR)
    state_path = expand(args.state or os.environ.get("QUILL_JOPLIN_STATE") or DEFAULT_STATE)
    api_url = (args.api_url or os.environ.get("QUILL_JOPLIN_API_URL") or DEFAULT_API)

    if not notes_dir.is_dir():
        print(f"error: notes directory not found: {notes_dir}", file=sys.stderr)
        return EXIT_ERROR
    try:
        state = json.loads(state_path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        print(f"error: cannot read sync state {state_path}: {exc}", file=sys.stderr)
        return EXIT_ERROR
    mapping = state.get("notes") if isinstance(state, dict) else None
    if not isinstance(mapping, dict) or not mapping:
        print("nothing to do: no synced notes in state", file=sys.stderr)
        return EXIT_OK

    try:
        api = Joplin(api_url, load_token(args.token))
    except RuntimeError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return EXIT_ERROR
    if not api.ping():
        print(f"Joplin API unreachable at {api_url}: skipping tag mirror", file=sys.stderr)
        return EXIT_NO_JOPLIN

    counts = {"notes": 0, "attached": 0, "detached": 0, "unchanged": 0, "skipped": 0}
    warnings = []
    try:
        tag_ids = {}
        for tag in api.get_all("/tags", {"fields": "id,title"}):
            tag_ids.setdefault(str(tag.get("title") or "").casefold(), tag["id"])

        for rel, tags in local_tags(notes_dir).items():
            entry = mapping.get(rel)
            note_id = entry.get("id") if isinstance(entry, dict) else None
            if not note_id:
                counts["skipped"] += 1
                continue
            counts["notes"] += 1
            try:
                current = api.get_all(
                    f"/notes/{urllib.parse.quote(str(note_id), safe='')}/tags",
                    {"fields": "id,title"})
            except JoplinError as exc:
                if exc.code == 404:
                    warnings.append(f"note missing in Joplin: {rel}")
                    counts["skipped"] += 1
                    continue
                raise
            current_ids = {str(tag["id"]): str(tag.get("title") or "") for tag in current}
            desired = {tag.casefold(): tag for tag in tags}

            for key, title in desired.items():
                if any(existing.casefold() == key for existing in current_ids.values()):
                    counts["unchanged"] += 1
                    continue
                if args.dry_run:
                    counts["attached"] += 1
                    continue
                tag_id = tag_ids.get(key)
                if tag_id is None:
                    created = api.request("POST", "/tags", body={"title": title})
                    tag_id = created.get("id")
                    if not tag_id:
                        warnings.append(f"could not create tag #{title}")
                        continue
                    tag_ids[key] = tag_id
                api.request("POST", f"/tags/{tag_id}/notes", body={"id": note_id})
                counts["attached"] += 1

            for tag_id, title in current_ids.items():
                if title.casefold() in desired:
                    continue
                if args.dry_run:
                    counts["detached"] += 1
                    continue
                try:
                    api.request("DELETE", f"/tags/{tag_id}/notes/{note_id}")
                    counts["detached"] += 1
                except JoplinError as exc:
                    if exc.code != 404:
                        raise
    except JoplinError as exc:
        print(f"error: Joplin API call failed: {exc}", file=sys.stderr)
        return EXIT_ERROR

    if args.json:
        print(json.dumps(dict(counts, dry_run=args.dry_run, warnings=warnings),
                         sort_keys=True))
    elif not args.quiet:
        line = (f"Quill tags -> Joplin: {counts['notes']} notes, "
                f"{counts['attached']} attached, {counts['detached']} detached, "
                f"{counts['unchanged']} already current"
                + (" (dry run)" if args.dry_run else ""))
        print(line)
        for warning in warnings:
            print(f"warning: {warning}", file=sys.stderr)
    return EXIT_OK


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
